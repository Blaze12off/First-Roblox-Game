      </Item>
      <Item class="ModuleScript" referent="RBX54f01cbc49954fa29dda1560ee5668d6">
        <Properties>
          <string name="Name">PetConcepts</string>
          <ProtectedString name="Source">-- Review collection only. These IDs are NOT PetTypes and can never be hatched/equipped.
local P={Order={"Bee","Mushroom","Turtle","Owl","Panda","Deer","Shark","Octopus","Griffin","Kitsune","Golem","Serpent","Unicorn","Robot","Slime","Butterfly","Chameleon","Bat","Penguin","Lion","Whale"},Types={}}
local definitions={
    Bee={"Медовая пчёлка","Обычная",{255,203,73},"Полосатая собирательница с прозрачными крыльями и баночкой мёда."},
    Mushroom={"Грибной хранитель","Редкая",{224,106,125},"Лесной дух под шляпкой с кремовыми пятнышками."},
    Turtle={"Островная черепаха","Эпическая",{101,206,164},"Носит на панцире собственный крошечный сад."},
    Owl={"Сова-звездочёт","Эпическая",{132,143,219},"Большие лицевые диски, брови-перья и лунный медальон."},
    Panda={"Бамбуковая панда","Редкая",{237,241,231},"Чёрные ушки, лапы и маска; свежий бамбук за спиной."},
    Deer={"Олень рассвета","Легендарная",{226,171,113},"Ветвистые рога с листьями и светящиеся веснушки."},
    Shark={"Рифовая акула","Мифическая",{91,173,218},"Обтекаемый силуэт, высокий плавник и добродушная улыбка."},
    Octopus={"Чернильный осьминог","Секретная",{171,121,228},"Восемь щупалец с яркими присосками."},
    Griffin={"Грифон песчаного солнца","Легендарная",{232,192,105},"Орлиная маска, веер перьев, львиные лапы и хвост."},
    Kitsune={"Девятихвостый дух","Секретная",{242,226,237},"Девять хвостов, красные отметки и духи-огоньки."},
    Golem={"Кристальный голем","Мифическая",{114,150,188},"Каменные кулаки, раздельные пластины и бирюзовое сердце."},
    Serpent={"Змей туманностей","Божественная",{110,120,214},"Длинная изогнутая спина, звездные кольца и плавники."},
    Unicorn={"Призматический единорог","Божественная",{242,222,251},"Витой рог, радужная грива и перламутровые копыта."},
    Robot={"Робо-спутник","Легендарная",{117,205,213},"Мягкие металлические формы, экран-глаза и маленькие антенны."},
    Slime={"Желейный росток","Обычная",{130,228,187},"Прозрачное желе с маленьким внутренним сердцем и ростком."},
    Butterfly={"Мотылёк полярного сияния","Мифическая",{141,137,241},"Четыре узорчатых крыла и сверкающие усики."},
    Chameleon={"Хамелеон-палитра","Эпическая",{118,207,134},"Объёмные глаза, цветной гребень и завиток хвоста."},
    Bat={"Летучая мышь полумесяца","Редкая",{115,94,163},"Остроконечные ушки и широкие перепончатые крылья."},
    Penguin={"Пингвин-полярник","Редкая",{82,111,157},"Белая грудка, шарф и короткие плавники."},
    Lion={"Король янтаря","Легендарная",{242,190,94},"Огромная грива из отдельных прядей и золотые лапы."},
    Whale={"Космический кит","Божественная",{122,166,226},"Широкие плавники, хвост-веер и созвездия на спине."},
}
for _,id in P.Order do
    local d=definitions[id]; P.Types[id]={Name=d[1],Rarity=d[2],Color=d[3],Description=d[4],Species=id,Concept=true}
end
return P
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX1b39947ed12d422786dadc275dd42f1f">
        <Properties>
          <string name="Name">PetSculpt</string>
          <ProtectedString name="Source">-- Additional original silhouettes built with the same safe primitive factory.
local S={}; local V=Vector3.new; local rgb=Color3.fromRGB
local cream=rgb(255,241,216); local dark=rgb(24,33,58); local gold=rgb(255,205,91)
function S.Build(model,id,color,p,crystal,halo,turn)
    local function add(name,size,pos,c,shape,rot,glow) return p(model,name,size,pos,c or color,shape or "Round",rot,glow) end
    local wide=id=="Whale" or id=="Shark" or id=="Turtle"; local body
    if id=="Robot" or id=="Golem" then body=add("Body",V(1.65,1.45,1.4),V(0,0,0),color,"Block")
    else body=add("Body",wide and V(1.65,1.25,2.2) or V(1.65,1.5,1.5),V(0,0,0)) end
    local faceZ=wide and -1.02 or -.71
    if id=="Robot" then
        add("Screen",V(1.4,.85,.09),V(0,.13,-.75),dark,"Block")
        for _,s in {-1,1} do add("PixelEye",V(.27,.34,.07),V(s*.36,.18,-.82),rgb(108,255,237),"Block",nil,true) end
    else
        for _,s in {-1,1} do
            if id=="Owl" then add("FaceDisk",V(.76,.92,.17),V(s*.36,.08,faceZ+.06),cream) end
            if id=="Panda" then add("EyePatch",V(.58,.7,.13),V(s*.36,.12,faceZ+.02),dark,nil,turn(0,0,s*-18)) end
            add("EyeWhite",V(.36,.42,.14),V(s*.34,.14,faceZ),cream)
            add("Pupil",V(.23,.3,.1),V(s*.34,.12,faceZ-.08),dark)
            add("Highlight",V(.075,.085,.035),V(s*.34-.04,.2,faceZ-.14),rgb(255,255,255))
            add("Blush",V(.23,.11,.05),V(s*.61,-.17,faceZ+.01),rgb(245,142,170))
        end
        add("Smile",V(.21,.055,.05),V(0,-.32,faceZ-.04),dark)
    end
    if not wide and id~="Serpent" and id~="Octopus" and id~="Slime" then
        for _,s in {-1,1} do add("Paw",V(.44,.28,.52),V(s*.49,-.7,-.36),id=="Panda" and dark or cream) end
    end
    if id=="Bee" then
        for i=1,3 do add("Stripe",V(1.69,.19,1.54),V(0,-.48+i*.31,0),dark) end
        for _,s in {-1,1} do
            local wing=add("HoneyWing",V(.85,.13,1.2),V(s*.9,.42,.3),rgb(213,246,255),nil,turn(0,s*25,s*20)); wing.Transparency=.3
            add("Antenna",V(.08,.5,.08),V(s*.32,.93,-.15),dark,nil,turn(0,0,s*-22))
            add("AntennaTip",V(.19,.19,.19),V(s*.42,1.18,-.15),gold)
        end
        add("HoneyPot",V(.58,.56,.45),V(.83,-.45,-.15),gold)
    elseif id=="Mushroom" then
        body.Color=cream
        add("MushroomCap",V(2.45,.9,2.1),V(0,.79,.02))
        add("CapRim",V(2.42,.15,2.08),V(0,.5,.02),cream)
        for i=1,7 do local a=i*2.4; add("CapSpot",V(.28,.09,.32),V(math.cos(a)*.75,1.15,math.sin(a)*.5),cream) end
    elseif id=="Turtle" then
        add("Shell",V(1.82,1.08,1.9),V(0,.38,.37),rgb(65,132,109))
        for x=-1,1 do for z=0,1 do add("ShellTile",V(.48,.16,.55),V(x*.49,.91,z*.58),gold) end end
        for _,s in {-1,1} do for z=0,1 do add("Flipper",V(.65,.2,.65),V(s*.91,-.5,z*.95-.15)) end end
        add("SproutStem",V(.12,.55,.12),V(0,1.15,.4),rgb(68,133,91))
        for _,s in {-1,1} do add("GardenLeaf",V(.5,.14,.3),V(s*.22,1.38,.4),rgb(146,228,112),nil,turn(0,0,s*22)) end
    elseif id=="Owl" or id=="Griffin" then
        add("Beak",V(.32,.33,.35),V(0,-.15,-.89),gold,"Wedge",turn(180,0,0))
        for _,s in {-1,1} do
            add("BrowFeather",V(.55,.17,.22),V(s*.37,.58,-.6),cream,nil,turn(0,0,s*18))
            for i=1,4 do add("Feather",V(.4,.19,.9),V(s*(.71+i*.16),.17-i*.13,.15),i%2==0 and cream or color,nil,turn(0,s*24,-s*32)) end
        end
        if id=="Griffin" then add("Tail",V(.23,.25,1.25),V(0,-.27,1)); add("TailTuft",V(.45,.4,.5),V(0,-.1,1.58),gold) end
    elseif id=="Panda" or id=="Lion" then
        for _,s in {-1,1} do add("RoundEar",V(.55,.55,.35),V(s*.57,.68,0),id=="Panda" and dark or gold) end
        if id=="Panda" then
            add("Bamboo",V(.2,1.8,.2),V(.85,.1,.6),rgb(92,177,106),nil,turn(0,0,-18))
            for i=1,3 do add("BambooNode",V(.24,.09,.24),V(.85+i*.08,-.7+i*.45,.6),cream) end
        else
            for i=1,12 do local a=i*math.pi/6; add("ManeLock",V(.56,.66,.53),V(math.cos(a)*.87,math.sin(a)*.89,.1),i%2==0 and gold or rgb(204,119,53),nil,turn(0,0,math.deg(a))) end
            add("Muzzle",V(.8,.45,.25),V(0,-.19,-.7),cream); add("Nose",V(.22,.15,.14),V(0,-.12,-.87),dark)
        end
    elseif id=="Deer" or id=="Unicorn" then
        for _,s in {-1,1} do
            add("Ear",V(.34,.64,.3),V(s*.62,.65,.02),cream,nil,turn(0,0,-s*30))
            if id=="Deer" then
                for i=1,3 do
                    add("Antler",V(.13,.47,.13),V(s*(.27+i*.12),.7+i*.3,.13),gold,nil,turn(0,0,-s*18))
                    add("AntlerBranch",V(.34,.11,.13),V(s*(.4+i*.12),.83+i*.3,.13),gold,nil,turn(0,0,s*25))
                end
            end
        end
        if id=="Unicorn" then
            for i=1,5 do crystal(model,V(0,.65+i*.17,-.2),V(.38-i*.05,.3,.32-i*.04),i%2==0 and gold or cream) end
            for i=1,6 do add("RainbowMane",V(.4,.36,.42),V(.38,.65-i*.18,.52),Color3.fromHSV(i/7,.4,1)) end
        else for i=-1,1 do add("Freckle",V(.09,.09,.04),V(i*.2,.43,-.64),cream) end end
    elseif id=="Shark" or id=="Whale" then
        add("Belly",V(1.3,.48,1.6),V(0,-.43,-.16),cream)
        for _,s in {-1,1} do
            add("SideFin",V(.85,.18,.8),V(s*.9,-.13,.16),color,nil,turn(0,s*28,s*-20))
            add("TailFan",V(.85,.17,.65),V(s*.36,.1,1.4),color,nil,turn(0,s*30,s*15))
        end
        if id=="Shark" then add("DorsalFin",V(.28,.95,.8),V(0,.76,.35),color,"Wedge",turn(0,90,0))
            for _,s in {-1,1} do for i=1,3 do add("Gill",V(.04,.28,.07),V(s*.78,-.02,i*.16-.15),dark) end end
        else halo(model,1,.65,rgb(193,224,255)); for i=1,6 do add("Constellation",V(.08,.08,.08),V(math.sin(i)*.6,.55,math.cos(i)*.6),gold,nil,nil,true) end end
    elseif id=="Octopus" then
        for i=1,8 do
            local a=i*math.pi/4; local r=V(math.cos(a),0,math.sin(a))
            add("Tentacle",V(.33,.35,1),r*.73+V(0,-.65,0),color,nil,turn(0,-math.deg(a)+90,0))
            add("CurledTip",V(.4,.5,.4),r*1.18+V(0,-.52,0),color)
            add("Sucker",V(.17,.1,.17),r*.99+V(0,-.83,0),rgb(139,247,229))
        end
    elseif id=="Kitsune" then
        for _,s in {-1,1} do add("SpiritEar",V(.45,.8,.4),V(s*.5,.83,0),color,"Wedge",turn(0,90,-s*12)); add("RedMark",V(.14,.3,.04),V(s*.56,.09,-.68),rgb(224,93,116),nil,turn(0,0,s*22)) end
        for i=1,9 do
            local a=(i-5)*.25; local h=math.abs(i-5)*.1
            add("SpiritTail",V(.36,.6,1.6),V(math.sin(a)*1.5,-.05+h,1.03),color,nil,turn(-22,math.deg(a),0))
            add("TailFlame",V(.3,.4,.48),V(math.sin(a)*1.9,.32+h,1.65),rgb(249,137,174))
        end
    elseif id=="Golem" or id=="Robot" then
        for _,s in {-1,1} do
            add("Shoulder",V(.58,.68,.65),V(s*.92,.16,0),color,"Block",turn(0,0,-s*12))
            add("Fist",V(.58,.5,.6),V(s*1.05,-.4,-.1),color,"Block")
            if id=="Robot" then add("Antenna",V(.09,.5,.09),V(s*.45,.92,0),gold); add("SignalLight",V(.18,.18,.18),V(s*.45,1.2,0),rgb(110,255,218),nil,nil,true) end
        end
        crystal(model,V(0,-.35,-.78),V(.32,.5,.12),rgb(104,245,224))
        if id=="Golem" then for i=-1,1 do crystal(model,V(i*.45,.82,0),V(.28,.7,.38),rgb(135,229,246)) end end
    elseif id=="Serpent" then
        for i=1,7 do local a=i*.55; add("Coil",V(.9-i*.06,.8-i*.05,.9-i*.06),V(math.sin(a)*.7,-i*.16,.5+i*.3)); add("SpineStar",V(.12,.28,.12),V(math.sin(a)*.7,.4-i*.16,.5+i*.3),gold,nil,nil,true) end
        for _,s in {-1,1} do add("HeadFin",V(.32,.8,.5),V(s*.72,.45,0),cream,nil,turn(0,0,-s*35)) end
        halo(model,1.2,.53,gold)
    elseif id=="Slime" then
        body.Transparency=.22
        add("InnerHeart",V(.5,.45,.45),V(0,-.05,.05),rgb(113,255,198),nil,nil,true)
        for _,s in {-1,1} do add("Sprout",V(.6,.13,.36),V(s*.22,.94,0),rgb(78,163,106),nil,turn(0,0,s*30)) end
        add("Bubble",V(.26,.26,.26),V(.92,.6,.1),cream).Transparency=.4
    elseif id=="Butterfly" or id=="Bat" then
        for _,s in {-1,1} do
            if id=="Butterfly" then
                for i=1,2 do
                    add("ButterflyWing",V(1.25,.16,1.5-i*.22),V(s*(.88+i*.12),.18-(i-1)*.6,.1),i==1 and color or rgb(125,228,220),nil,turn(0,0,s*20))
                    add("WingEye",V(.4,.1,.5),V(s*1.12,.3-(i-1)*.6,.04),gold)
                end
            else
                for i=1,3 do add("BatMembrane",V(.65,.12,.95-i*.1),V(s*(.76+i*.24),.15-i*.13,.16),color,"Wedge",turn(0,s*20,-s*25)) end
                add("PointedEar",V(.4,.9,.3),V(s*.4,.87,0),color,"Wedge",turn(0,90,0))
            end
            add("Antenna",V(.07,.55,.07),V(s*.25,.93,0),dark,nil,turn(0,0,-s*25))
        end
    elseif id=="Chameleon" then
        for _,s in {-1,1} do add("EyeTurret",V(.55,.58,.5),V(s*.62,.33,-.48),color) end
        for i=1,8 do local a=i*math.pi/4; add("CoilTail",V(.22,.22,.28),V(math.cos(a)*.45,-.14+math.sin(a)*.45,1.1),Color3.fromHSV(i/9,.45,.95)) end
        for i=1,5 do add("Crest",V(.16,.3,.24),V(0,.69,.1+(i-1)*.18),Color3.fromHSV(i/8,.5,1),"Wedge") end
    elseif id=="Penguin" then
        add("Bib",V(1.22,1.18,.2),V(0,-.05,-.65),cream)
        add("Beak",V(.34,.24,.35),V(0,-.1,-.87),gold,"Wedge",turn(180,0,0))
        add("Scarf",V(1.6,.2,1.45),V(0,-.43,0),rgb(246,123,149))
        add("ScarfTail",V(.3,.7,.15),V(.47,-.65,-.74),rgb(246,123,149),nil,turn(0,0,-16))
        for _,s in {-1,1} do add("Flipper",V(.27,.86,.5),V(s*.83,-.18,0),color,nil,turn(0,0,s*18)) end
    end
    return body
end
return S
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXb506445108614b9da16af18c4fc7b2d6">
        <Properties>
          <string name="Name">TowerLayout</string>
          <ProtectedString name="Source">-- Pure layout: shared by geometry, server checkpoints and CLI reachability tests.
local L={Steps=32,CheckpointEvery=8,PlatformSize=8.6,Spacing=120}
local ranges={{.24,6},{3,14},{10,30},{24,65},{48,105}}
local ring={{-18,18},{-9,18},{0,18},{9,18},{18,18},{18,9},{18,0},{18,-9},
    {18,-18},{9,-18},{0,-18},{-9,-18},{-18,-18},{-18,-9},{-18,0},{-18,9}}
function L.Build(zone)
    assert(type(zone)=="number" and zone%1==0 and zone&gt;=1 and zone&lt;=5,"Invalid tower zone")
    local range=ranges[zone]; local x=(zone-1)*L.Spacing+8; local z=-76
    local result={Zone=zone,X=x,Z=z,Stages={}}; local height=.2
    for i=1,L.Steps do
        local rise=range[1]+(range[2]-range[1])*((i-1)/(L.Steps-1))^1.35
        height+=rise
        local offset=ring[(i-1)%#ring+1]
        result.Stages[i]={Index=i,X=x+offset[1],Y=height,Z=z+offset[2],Rise=rise,Checkpoint=i%L.CheckpointEvery==0}
    end
    result.SummitY=height+range[2]; result.LastRise=range[2]
    return result
end
return table.freeze(L)
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBXe9b6fc28edc84a93b4048bfa9a408702">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX8cfee0a9663e4c47bbfb89684457eaeb">
      <Properties>
        <string name="Name">Simulator</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX414bd687f0ed4e6bbaee41d5a3d55098">
        <Properties>
          <string name="Name">Schema</string>
          <ProtectedString name="Source">local C = require(game.ReplicatedStorage.SimulatorShared.Config)
local Schema = {}
function Schema.New()
    return {Version = 5, Zone=1, PracticeXP=0, RebirthXPSpent=0, Coins = 0, Power = 0, Level = 0, Rebirths = 0,
        LifetimePower = 0, TotalTrainings = 0, LastDaily = 0, LastWeekly = 0,
        Cosmetics = {}, Equipped = "", Pets = {}, EquippedPets = {}}
end
function Schema.Copy(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for key, item in pairs(value) do result[key] = Schema.Copy(item) end
    return result
end
local function integer(value, maximum)
    return type(value) == "number" and value == value and value &gt;= 0
        and value &lt;= maximum and value % 1 == 0
end
-- Corrupt/unknown records fail closed. Defaults only come from a genuinely absent key.
function Schema.Validate(raw)
    if type(raw) ~= "table" or (raw.Version ~= 1 and raw.Version ~= 2 and raw.Version ~= 3 and raw.Version ~= 4 and raw.Version ~= 5) then return nil end
    if raw.Version==5 then
        if not integer(raw.Zone,5) or raw.Zone&lt;1 or not integer(raw.PracticeXP,C.MaxValue) or not integer(raw.RebirthXPSpent,raw.PracticeXP) then return nil end
    end
    local limits = {Coins=C.MaxValue, Power=C.MaxValue, Level=C.MaxLevel,
        Rebirths=C.MaxRebirths, LifetimePower=C.MaxValue, TotalTrainings=C.MaxValue,
        LastDaily=100000000000, LastWeekly=100000000000}
    for key, limit in pairs(limits) do if not integer(raw[key], limit) then return nil end end
    if type(raw.Cosmetics) ~= "table" or type(raw.Equipped) ~= "string" then return nil end
    for key, value in pairs(raw.Cosmetics) do
        if (key ~= "BronzeAura" and key ~= "NeonTrail") or value ~= true then return nil end
    end
    if raw.Equipped ~= "" and not raw.Cosmetics[raw.Equipped] then return nil end
    if raw.Version &gt;= 2 then
        if type(raw.Pets) ~= "table" then return nil end
        local total = 0
        for id, count in pairs(raw.Pets) do
            if not C.PetTypes[id] or not integer(count, C.MaxPets) or count &lt; 1 then return nil end
            total += count
        end
        if total &gt; C.MaxPets then return nil end
        if raw.Version == 2 then
            if type(raw.EquippedPet) ~= "string" or (raw.EquippedPet ~= "" and not raw.Pets[raw.EquippedPet]) then return nil end
        else
            if type(raw.EquippedPets) ~= "table" then return nil end
            local equipped = 0
            for id, count in pairs(raw.EquippedPets) do
                if not C.PetTypes[id] or not integer(count,C.PetEquipSlots) or count&lt;1 or count&gt;(raw.Pets[id] or 0) then return nil end
                equipped += count
            end
            if equipped&gt;C.PetEquipSlots then return nil end
        end
    end
    local clean = Schema.New()
    for key in pairs(clean) do
        if key ~= "Version" and key ~= "EquippedPets" and (raw.Version&gt;=5 or (key~="Zone" and key~="PracticeXP" and key~="RebirthXPSpent")) and (raw.Version &gt;= 2 or key ~= "Pets") then
            clean[key] = Schema.Copy(raw[key])
        end
    end
    if raw.Version &gt;= 3 then clean.EquippedPets=Schema.Copy(raw.EquippedPets)
    elseif raw.Version == 2 and raw.EquippedPet ~= "" then clean.EquippedPets[raw.EquippedPet]=1 end
    return clean
end
return Schema
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXfaaf063371694d1abdc566d4fdcecd34">
        <Properties>
          <string name="Name">PlayerData</string>
          <ProtectedString name="Source">local C = require(game.ReplicatedStorage.SimulatorShared.Config)
local Schema = require(script.Parent.Schema)
local HttpService = game:GetService("HttpService")
local PlayerData = {}
PlayerData.__index = PlayerData

-- Injectable backend/clock are used by tests, never accessible through remotes.
function PlayerData.new(store, options)
    options = options or {}
    return setmetatable({store=store, profiles={}, loading={}, closing=false,
        now=options.now or os.time, wait=options.wait or task.wait,
        offline=options.offline == true, token=options.token or HttpService:GenerateGUID(false)}, PlayerData)
end
function PlayerData:_request(key, transform)
    for attempt = 1, C.Attempts do
        local ok, result = pcall(function() return self.store:UpdateAsync(key, transform) end)
        if ok then return true, result end
        if attempt &lt; C.Attempts then self.wait(math.min(2 ^ (attempt-1), 4) + math.random()*0.2) end
    end
    return false, "unavailable"
end
local function validRecord(record)
    if type(record) ~= "table" or record.Schema ~= 1 or not Schema.Validate(record.Data) then return false end
    if type(record.Revision) ~= "number" or record.Revision % 1 ~= 0 or record.Revision &lt; 0 then return false end
    local lock = record.Session
    return lock == nil or (type(lock)=="table" and type(lock.Token)=="string"
        and type(lock.Until)=="number" and lock.Until == lock.Until and lock.Until &lt; math.huge)
end
function PlayerData:Load(userId)
    if self.closing or self.profiles[userId] or self.loading[userId] then return false, "busy" end
    self.loading[userId] = true
    if self.offline then
        self.profiles[userId] = {data=Schema.New(), lease=math.huge, status="ready", seq=0, savedSeq=0}
        self.loading[userId] = nil
        return true
    end
    local reason = "unavailable"
    local token = self.token .. ":" .. tostring(userId)
    local ok, record = self:_request("Player_"..userId, function(old)
        local now = self.now()
        if old ~= nil and not validRecord(old) then reason="corrupt"; return nil end
        if old and old.Session and old.Session.Token ~= token and old.Session.Until &gt; now then
            reason="locked"; return nil
        end
        local data = old and Schema.Validate(old.Data) or Schema.New()
        return {Schema=1, Data=data, Revision=old and old.Revision or 0,
            Session={Token=token, Until=now+C.LeaseSeconds}}, {userId}
    end)
    self.loading[userId] = nil
    if not ok or not record or not validRecord(record) or not record.Session or record.Session.Token~=token then
        return false, reason
    end
    self.profiles[userId] = {data=Schema.Validate(record.Data), lease=record.Session.Until,
        status="ready", seq=0, savedSeq=0, token=token, revision=record.Revision}
    return true
end
function PlayerData:Get(userId)
    local p = self.profiles[userId]
    if not p or p.status ~= "ready" or self.closing then return nil end
    -- Stop granting progress before a stale server can overwrite a new session.
    if p.lease &lt;= self.now()+10 then return nil end
    return p.data
end
function PlayerData:Changed(userId)
    local p = self.profiles[userId]
    if p then p.seq += 1 end
end
function PlayerData:Save(userId, release)
    local p = self.profiles[userId]
    if not p then return true end
    if release then p.status="closing" end
    -- One operation per key; exit waits for an autosave then writes the latest snapshot.
    while p.saving do self.wait(0.05) end
    if self.profiles[userId] ~= p then return true end
    p.saving = true
    local snapshot, seq = Schema.Copy(p.data), p.seq
    if not Schema.Validate(snapshot) then p.saving=false; return false, "corrupt" end
    if self.offline then
        p.savedSeq=seq; p.saving=false
        if release then self.profiles[userId]=nil end
        return true
    end
    local reason = "unavailable"
    local ok, result = self:_request("Player_"..userId, function(old)
        local now=self.now()
        if not validRecord(old) then reason="corrupt"; return nil end
        if not old.Session or old.Session.Token~=p.token or old.Session.Until &lt;= now then
            reason="lost_lock"; return nil
        end
        return {Schema=1, Data=snapshot, Revision=old.Revision+1,
            Session=not release and {Token=p.token, Until=now+C.LeaseSeconds} or nil}, {userId}
    end)
    p.saving=false
    if ok and result and validRecord(result) then
        p.savedSeq=seq; p.revision=result.Revision
        if release then self.profiles[userId]=nil else p.lease=result.Session.Until end
        return true
    end
    if reason=="lost_lock" or reason=="corrupt" then p.status="failed" end
    return false, reason
end
return PlayerData
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXa08e96f151f94fd1b32bda6278a8b5b5">
        <Properties>
          <string name="Name">Progression</string>
          <ProtectedString name="Source">local C = require(game.ReplicatedStorage.SimulatorShared.Config)
local number=require(game.ReplicatedStorage.SimulatorShared.NumberFormat).Compact
local P = {}
function P.Train(data, stationId)
    local station = C.Stations[stationId]
    if not station or (data.Zone or 1)&lt;(station.MinZone or 1) or data.Level &lt; station.MinLevel then return false, "Станция откроется на уровне 3." end
    local power, coins = C.Gains(data, station.Multiplier)
    data.Power = math.min(C.MaxValue, data.Power+power)
    data.Coins = math.min(C.MaxValue, data.Coins+coins)
    data.LifetimePower = math.min(C.MaxValue, data.LifetimePower+power)
    data.TotalTrainings = math.min(C.MaxValue, data.TotalTrainings+1)
    return true, ("+%s прыжка, +%s монет"):format(number(power),number(coins))
end
function P.Upgrade(data)
    if data.Level &gt;= C.MaxLevel then return false, "Максимальный уровень тренировки." end
    local cost=C.UpgradeCost(data.Level)
    if data.Coins &lt; cost then return false, "Не хватает монет на улучшение." end
    data.Coins-=cost; data.Level+=1
    return true, "Тренировка усилена! Уровень "..number(data.Level)
end
function P.Practice(data,seconds)
    if type(seconds)~="number" or seconds~=seconds or seconds&lt;0 or seconds&gt;1 then return false end
    data.PracticeXP=math.min(C.MaxValue,data.PracticeXP+math.floor(seconds))
    return true
end
function P.UnlockZone(data,zone)
    if type(zone)~="number" or zone%1~=0 or zone~=(data.Zone or 1)+1 or not C.Zones[zone] then return false,"Открывай зоны по порядку." end
    local target=C.Zones[zone]
    if data.PracticeXP&lt;target.XP or data.Coins&lt;target.Cost then return false,"Нужны опыт и монеты: "..number(target.XP).." опыта / "..number(target.Cost).." монет." end
    data.Coins-=target.Cost; data.Zone=zone
    return true,"Открыта зона «"..target.Name.."»!"
end
function P.ApplyJump(player,data)
    local humanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.UseJumpPower=false; humanoid.JumpHeight=C.JumpHeight(data) end
end
return P
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXfbb5a679f1b840939b590746b967dc3e">
        <Properties>
          <string name="Name">Rebirth</string>
          <ProtectedString name="Source">local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local R={}
function R.Apply(data,amount)
    amount=amount or 1
    local power,coins,xp=C.BatchRequirements(data.Rebirths,amount)
    if not power then return false,"Недопустимое количество перерождений." end
    if data.Power&lt;power or data.Coins&lt;coins or C.AvailablePractice(data)&lt;xp then return false,"Не хватает прыжка, монет или опыта тренировки." end
    data.Power=0; data.Coins-=coins; data.Level=0
    data.RebirthXPSpent+=xp; data.Rebirths+=amount
    return true,("Перерождений: %d! Постоянный бонус x%.2f"):format(amount,C.Multiplier(data))
end
return R
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX330c40b81fb240a48b34ba2bdb2ddc0a">
        <Properties>
          <string name="Name">Rewards</string>
          <ProtectedString name="Source">local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local number=require(game.ReplicatedStorage.SimulatorShared.NumberFormat).Compact
local Rewards={}
function Rewards.Reconcile(data)
    local changed=false
    if data.Rebirths&gt;=1 and not data.Cosmetics.BronzeAura then data.Cosmetics.BronzeAura=true; changed=true end
    if data.Rebirths&gt;=C.MilestoneTrail and not data.Cosmetics.NeonTrail then data.Cosmetics.NeonTrail=true; changed=true end
    if changed and data.Equipped=="" then data.Equipped=data.Cosmetics.NeonTrail and "NeonTrail" or "BronzeAura" end
    return changed
end
function Rewards.Claim(data, kind, now)
    local key, seconds, count
    if kind=="Daily" then key="LastDaily"; seconds=C.DailySeconds; count=C.DailyTrainingEquivalent
    elseif kind=="Weekly" then key="LastWeekly"; seconds=C.WeeklySeconds; count=C.WeeklyTrainingEquivalent
    else return false, "Неизвестная награда." end
    if data.TotalTrainings&lt;C.RewardMinTrainings then return false, "Сначала потренируйся 3 раза." end
    if data[key]~=0 and now &lt; data[key]+seconds then return false, "Награда ещё не готова." end
    local _, perTraining=C.Gains(data, 1)
    local reward=perTraining*count
    data[key]=now; data.Coins=math.min(C.MaxValue, data.Coins+reward)
    return true, ("Награда: +%s монет"):format(number(reward))
end
function Rewards.Equip(data, cosmetic)
    if cosmetic~="" and not data.Cosmetics[cosmetic] then return false, "Косметика ещё не открыта." end
    data.Equipped=cosmetic
    return true, cosmetic=="" and "Эффект выключен." or "Эффект включён."
end
function Rewards.ApplyCharacter(player, data)
    local char=player.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for _, child in root:GetChildren() do
        if child.Name:sub(1,10)=="Simulator_" then child:Destroy() end
    end
    if data.Equipped=="BronzeAura" and data.Cosmetics.BronzeAura then
        local light=Instance.new("PointLight"); light.Name="Simulator_Aura"
        light.Color=Color3.fromRGB(255,170,65); light.Range=10; light.Brightness=2; light.Parent=root
        local sparks=Instance.new("Sparkles"); sparks.Name="Simulator_Sparks"
        sparks.SparkleColor=light.Color; sparks.Parent=root
    elseif data.Equipped=="NeonTrail" and data.Cosmetics.NeonTrail then
        local a=Instance.new("Attachment"); a.Name="Simulator_TrailA"; a.Position=Vector3.new(-1,0,0); a.Parent=root
        local b=Instance.new("Attachment"); b.Name="Simulator_TrailB"; b.Position=Vector3.new(1,0,0); b.Parent=root
        local trail=Instance.new("Trail"); trail.Name="Simulator_Trail"
        trail.Attachment0=a; trail.Attachment1=b; trail.Lifetime=0.5
        trail.Color=ColorSequence.new(Color3.fromRGB(70,240,255),Color3.fromRGB(160,100,255)); trail.Parent=root
    end
end
return Rewards
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXa08791a01c094763b52196ead5602218">
        <Properties>
          <string name="Name">Pets</string>
          <ProtectedString name="Source">local number=require(game.ReplicatedStorage.SimulatorShared.NumberFormat).Compact
local C = require(game.ReplicatedStorage.SimulatorShared.Config)
local Pets = {}
function Pets.Count(data)
    local count = 0
    for _, amount in pairs(data.Pets) do count += amount end
    return count
end
function Pets.EquippedCount(data)
    local count=0
    for _,amount in pairs(data.EquippedPets) do count+=amount end
    return count
end
-- Randomness is chosen on the server. An injectable roll supports deterministic unit tests.
function Pets.Hatch(data, eggId, roll)
    local egg = C.Eggs[eggId]
    if not egg then return false, "Неизвестное яйцо." end
    if (data.Zone or 1)&lt;(egg.Zone or 1) then return false,"Яйцо недоступно: сначала открой зону "..number(egg.Zone).."." end
    if data.Level &lt; egg.MinLevel then return false, "Яйцо недоступно: нужен уровень "..number(egg.MinLevel).."." end
    if Pets.Count(data) &gt;= C.MaxPets then return false, "Инвентарь питомцев заполнен (50)." end
    if data.Coins &lt; egg.Cost then return false, "Не хватает монет на яйцо." end
    local value = roll and roll() or math.random()
    if type(value) ~= "number" or value ~= value or value &lt; 0 or value &gt;= 1 then
        return false, "Не удалось открыть яйцо. Монеты не списаны."
    end
    local total = 0
    for _, id in C.PetOrder do total += egg.Weights[id] or 0 end
    if total&lt;=0 then return false,"В этом яйце пока нет питомцев. Монеты не списаны." end
    local threshold, selected = 0, nil
    for _, id in C.PetOrder do
        local weight=egg.Weights[id] or 0
        if weight&lt;=0 then continue end
        selected=id -- Last eligible drop also handles floating-point rounding at the upper boundary.
        threshold += weight / total
        if value &lt; threshold then selected = id; break end
    end
    data.Coins -= egg.Cost
    data.Pets[selected] = (data.Pets[selected] or 0) + 1
    if Pets.EquippedCount(data) &lt; C.PetEquipSlots then
        data.EquippedPets[selected]=(data.EquippedPets[selected] or 0)+1
    end
    return true, "Из яйца: " .. C.PetTypes[selected].Name .. "!", selected
end
function Pets.Equip(data, id)
    if id ~= "" and (not C.PetTypes[id] or not data.Pets[id]) then
        return false, "Этот питомец не получен."
    end
    if id == "" then data.EquippedPets={}; return true,"Все питомцы сняты." end
    if Pets.EquippedCount(data)&gt;=C.PetEquipSlots then return false,"Все 3 обычных слота заняты." end
    if (data.EquippedPets[id] or 0)&gt;=data.Pets[id] then return false,"Нет свободного экземпляра питомца." end
    data.EquippedPets[id]=(data.EquippedPets[id] or 0)+1
    return true, "Питомец экипирован: " .. C.PetTypes[id].Name
end
function Pets.Unequip(data,id)
    local count=data.EquippedPets[id] or 0
    if count&lt;1 then return false,"Этот питомец не экипирован." end
    data.EquippedPets[id]=count&gt;1 and count-1 or nil
    return true,"Питомец снят."
end
function Pets.EquipBest(data)
    if Pets.Count(data)==0 then return false,"Сначала получите питомца." end
    local order=table.clone(C.InventoryOrder)
    table.sort(order,function(a,b)
        if C.PetTypes[a].Bonus==C.PetTypes[b].Bonus then return a&lt;b end
        return C.PetTypes[a].Bonus&gt;C.PetTypes[b].Bonus
    end)
    local selected,remaining={},C.PetEquipSlots
    for _,id in order do
        local amount=math.min(data.Pets[id] or 0,remaining)
        if amount&gt;0 then selected[id]=amount; remaining-=amount end
        if remaining==0 then break end
    end
    data.EquippedPets=selected
    return true,"Лучшие питомцы экипированы."
end
-- Count-based inventory: three identical copies, validated and consumed atomically.
function Pets.Craft(data,id,copies)
    local info=C.PetTypes[id]
    if not info or info.Upgraded then return false,"Можно совместить только обычные экземпляры одного вида." end
    local owned=data.Pets[id] or 0
    if owned&lt;3 then return false,"Нужно три одинаковых питомца." end
    if type(copies)~="table" or #copies~=3 then return false,"Выберите три экземпляра." end
    local seen,removedEquipped,selectionCount={},0,0
    for key,index in pairs(copies) do
        if type(key)~="number" or key%1~=0 or key&lt;1 or key&gt;3 or type(index)~="number" or index%1~=0 or index&lt;1 or index&gt;owned or seen[index] then
            return false,"Выбор питомцев устарел или некорректен."
        end
        seen[index]=true
        selectionCount+=1
        if index&lt;=(data.EquippedPets[id] or 0) then removedEquipped+=1 end
    end
    if selectionCount~=3 then return false,"Выберите три экземпляра." end
    local remaining=owned-3
    data.Pets[id]=remaining&gt;0 and remaining or nil
    local equipped=(data.EquippedPets[id] or 0)-removedEquipped
    data.EquippedPets[id]=equipped&gt;0 and equipped or nil
    local result=id.."_Upgraded"
    data.Pets[result]=(data.Pets[result] or 0)+1
    if Pets.EquippedCount(data)&lt;C.PetEquipSlots then
        data.EquippedPets[result]=(data.EquippedPets[result] or 0)+1
    end
    return true,"Получен "..C.PetTypes[result].Name.."!",result
end
return Pets
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXe4da5d1dae4f4fc4b1c685e98af99289">
        <Properties>
          <string name="Name">PetVisuals</string>
          <ProtectedString name="Source">local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local Factory=require(game.ReplicatedStorage.SimulatorShared.ModelFactory)
local TextStyle=require(game.ReplicatedStorage.SimulatorShared.TextStyle)
local Visuals={}
function Visuals.Apply(player,data)
    local character=player.Character
    if not character then return end
    local previous=character:FindFirstChild("SimulatorPet")
    if previous then previous:Destroy() end
    local root=character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local folder=Instance.new("Folder"); folder.Name="SimulatorPet"; folder.Parent=character
    local slot=0
    for _,id in C.InventoryOrder do
        for _=1,data.EquippedPets[id] or 0 do
            slot+=1
            local offset=({Vector3.new(-3,-.6,2),Vector3.new(3,-.6,2),Vector3.new(0,-.6,4)})[slot]
            if not offset then continue end -- Also bound rendering if supplied a malformed team.
            local info=C.PetTypes[id]
            local model=Factory.Build(id,false); model.Name=id..slot; model.Parent=folder
            model:SetAttribute("OwnerUserId",player.UserId)
            model:PivotTo(root.CFrame*CFrame.new(offset))
            for _,p in model:GetDescendants() do
                if p:IsA("BasePart") then
                    p.Anchored=false; p.Massless=true
                    local weld=Instance.new("WeldConstraint"); weld.Part0=root; weld.Part1=p; weld.Parent=p
                end
            end
            local tag=Instance.new("BillboardGui"); tag.Size=UDim2.fromOffset(160,30)
            tag.StudsOffset=Vector3.new(0,2.6,0); tag.MaxDistance=18; tag.Parent=model.PrimaryPart
            local text=Instance.new("TextLabel"); text.Size=UDim2.fromScale(1,1)
            text.BackgroundTransparency=1; text.Font=Enum.Font.GothamBold; text.TextSize=14
            text.TextColor3=Color3.fromRGB(table.unpack(info.Color)); text.Text=info.Name; text.Parent=tag
            TextStyle.Apply(text)
        end
    end
    if slot==0 then folder:Destroy() end
end
return Visuals
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX03eae9a700f84af0b30b310cd59cb151">
        <Properties>
          <string name="Name">Security</string>
          <ProtectedString name="Source">local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local S={}
function S.NewLimiter(burst,perSecond)
    return {tokens=burst or C.RemoteBurst,burst=burst or C.RemoteBurst,perSecond=perSecond or C.RemotePerSecond,at=os.clock(),actions={}}
end
function S.Allow(limiter, action, now, cooldown)
    limiter.tokens=math.min(limiter.burst, limiter.tokens+(now-limiter.at)*limiter.perSecond)
    limiter.at=now
    if limiter.tokens&lt;1 then return false end
    limiter.tokens-=1
    local last=limiter.actions[action]
    if last and now-last&lt;cooldown then return false end
    limiter.actions[action]=now
    return true
end
function S.Valid(action, args)
    if type(action)~="string" or #action&gt;16 then return false end
    if action=="Jump" then return args.n==0 end
    if action=="Zone" then return args.n==1 and type(args[1])=="number" and args[1]%1==0 and args[1]&gt;=1 and args[1]&lt;=5 end
    if action=="PrepareRebirth" then return args.n==0 or (args.n==1 and type(args[1])=="number" and args[1]%1==0 and args[1]&gt;=1 and args[1]&lt;=C.MaxBatchRebirths) end
    if action=="Train" then return args.n==1 and type(args[1])=="string" and C.Stations[args[1]]~=nil end
    if action=="Equip" then return args.n==1 and (args[1]=="" or args[1]=="BronzeAura" or args[1]=="NeonTrail") end
    if action=="Hatch" then return args.n==1 and type(args[1])=="string" and C.Eggs[args[1]]~=nil end
    if action=="PetEquip" then return args.n==1 and type(args[1])=="string" and (args[1]=="" or C.PetTypes[args[1]]~=nil) end
    if action=="PetUnequip" then return args.n==1 and type(args[1])=="string" and C.PetTypes[args[1]]~=nil end
    if action=="PetCraft" then
        if args.n~=2 or type(args[1])~="string" or not C.PetTypes[args[1]] or C.PetTypes[args[1]].Upgraded or type(args[2])~="table" or #args[2]~=3 then return false end
        local seen={}; local count=0
        for key,index in pairs(args[2]) do
            if type(key)~="number" or key%1~=0 or key&lt;1 or key&gt;3 or type(index)~="number" or index%1~=0 or index&lt;1 or index&gt;C.MaxPets or seen[index] then return false end
            seen[index]=true
            count+=1
        end
        return count==3
    end
    if action=="Rebirth" then return args.n==1 and type(args[1])=="string" and #args[1]&lt;=64 end
    return (action=="Sync" or action=="Upgrade" or action=="PrepareRebirth" or action=="Daily" or action=="Weekly" or action=="PetMenu" or action=="PetEquipBest") and args.n==0
end
function S.Near(player, part, radius)
    local char=player.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    local human=char and char:FindFirstChildOfClass("Humanoid")
    return root~=nil and human~=nil and human.Health&gt;0 and (root.Position-part.Position).Magnitude&lt;=radius
end
return S
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX6187ebf0414f4a50a8fbdd6936f8342b">
        <Properties>
          <string name="Name">LeaderboardTemplate</string>
          <ProtectedString name="Source">-- Visual draft only: each ranking row is a separate solid plaque, no live data.
local Board={}
-- Intended refresh interval for the future live leaderboard; this draft has no data fetch loop.
Board.RefreshIntervalSeconds=3600
local rgb=Color3.fromRGB
local function part(parent,name,size,pos,color,neon)
    local p=Instance.new("Part"); p.Name=name; p.Size=size; p.Position=pos; p.Anchored=true
    p.Material=neon and Enum.Material.Neon or Enum.Material.SmoothPlastic; p.Color=color
    p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    p.Parent=parent; return p
end
local function face(p,width,height)
    p.CFrame=CFrame.new(p.Position)*CFrame.Angles(0,math.pi,0)
    local g=Instance.new("SurfaceGui"); g.Name="Lettering"; g.Face=Enum.NormalId.Front
    g.SizingMode=Enum.SurfaceGuiSizingMode.FixedSize; g.CanvasSize=Vector2.new(width,height)
    g.LightInfluence=0; g.AlwaysOnTop=false; g.Parent=p; return g
end
local function text(g,name,value,x,y,w,h,size,color,align)
    local t=Instance.new("TextLabel"); t.Name=name; t.Text=value
    t.Position=UDim2.fromOffset(x,y); t.Size=UDim2.fromOffset(w,h)
    t.BackgroundTransparency=1; t.Font=Enum.Font.GothamBold; t.TextSize=size
    t.TextColor3=color; t.TextXAlignment=align or Enum.TextXAlignment.Left
    t.TextStrokeColor3=rgb(8,12,24); t.TextStrokeTransparency=0.15; t.Parent=g
    return t
end
function Board.Build(parent)
    if parent:FindFirstChild("LeaderboardTemplate") then return parent.LeaderboardTemplate end
    local m=Instance.new("Model"); m.Name="LeaderboardTemplate"; m.Parent=parent
    m:SetAttribute("RefreshIntervalSeconds",Board.RefreshIntervalSeconds)
    -- Ground -&gt; foundation -&gt; pedestal -&gt; feet -&gt; shafts -&gt; capitals -&gt; canopy.
    -- Adjacent pieces touch only at their hidden joints; exposed rear faces have different depths.
    part(m,"Foundation",Vector3.new(57,0.6,8),Vector3.new(4,0.3,-30),rgb(22,30,47))
    part(m,"Pedestal",Vector3.new(55,1.4,6),Vector3.new(4,1.3,-30),rgb(44,55,77))
    -- Full-height backing closes the gaps beside and above the title.
    part(m,"Backing",Vector3.new(51,31.2,2),Vector3.new(4,17.6,-32.2),rgb(15,23,39))
    for _,x in {-22,4,30} do
        part(m,"Pillar",Vector3.new(1.5,29.4,2.6),Vector3.new(x,17.7,-30.7),rgb(65,79,103))
        part(m,"PillarFoot",Vector3.new(2.6,1,3.6),Vector3.new(x,2.5,-30.7),rgb(98,117,147))
        part(m,"PillarCap",Vector3.new(2.6,0.8,3.6),Vector3.new(x,32.8,-30.7),rgb(98,117,147))
    end
    local title=part(m,"HallTitle",Vector3.new(48,4,2.4),Vector3.new(4,30.4,-30),rgb(31,43,66))
    text(face(title,1200,100),"Title","ЗАЛ СЛАВЫ",0,0,1200,100,74,rgb(255,220,125),Enum.TextXAlignment.Center)
    -- Rear edge -33.6, front edge -26.4: a visible forward overhang above the title.
    part(m,"CrownTrim",Vector3.new(58.6,0.6,7.2),Vector3.new(4,33.5,-30),rgb(255,205,96))
    part(m,"TopGlow",Vector3.new(48,0.18,0.2),Vector3.new(4,32.5,-28.65),rgb(255,213,111),true)
    local cols={{name="Players",x=-9,title="ТОП 10 ИГРОКОВ",prefix="Игрок",accent=rgb(86,221,255)},
        {name="Donors",x=17,title="ТОП 10 ДОНАТЕРОВ",prefix="Донатер",accent=rgb(196,147,255)}}
    local medals={rgb(255,205,96),rgb(201,223,245),rgb(234,161,111)}
    for _,c in ipairs(cols) do
        local col=Instance.new("Model"); col.Name=c.name; col.Parent=m
        local header=part(col,"Heading",Vector3.new(23,2.5,1.6),Vector3.new(c.x,26.7,-29.9),rgb(30,42,63))
        local hg=face(header,920,100)
        local heading=text(hg,"Title",c.title,20,4,880,92,74,c.accent,Enum.TextXAlignment.Center)
        heading.TextScaled=true
        for _,x in {c.x-11.7,c.x+11.7} do
            -- Solid saturated rails retain the theme color without white neon bloom.
            local railColor=c.name=="Donors" and rgb(156,76,235) or rgb(40,177,227)
            part(col,"LightRail",Vector3.new(0.14,23.5,0.2),Vector3.new(x,14,-29.15),railColor,false)
        end
        for rank=1,10 do
            local y=23.5-(rank-1)*2.1
            local tint=medals[rank] or c.accent
            -- Winners physically project further from the wall, with separate medal blocks.
            local z=rank&lt;=3 and -29.35 or -29.65
            local row=part(col,"Row"..rank,Vector3.new(22.6,1.85,rank&lt;=3 and 1.6 or 1),Vector3.new(c.x,y,z),rank&lt;=3 and rgb(48,59,79) or (rank%2==0 and rgb(31,44,65) or rgb(25,36,56)))
            local g=face(row,904,74)
            text(g,"PlayerName",string.format("%s_%02d",c.prefix,rank),125,0,610,74,43,rgb(244,248,255))
            text(g,"Value","—",750,0,130,74,46,tint,Enum.TextXAlignment.Right)
            local medal=part(col,"Rank"..rank,Vector3.new(1.8,1.45,0.35),Vector3.new(c.x-9.9,y,z+row.Size.Z/2+0.2),rank&lt;=3 and tint or rgb(57,76,103))
            text(face(medal,80,64),"Rank",tostring(rank),0,0,80,64,48,rank&lt;=3 and rgb(29,25,25) or rgb(232,242,255),Enum.TextXAlignment.Center)
            part(col,"RowAccent"..rank,Vector3.new(0.1,1.3,0.12),Vector3.new(c.x-8.7,y,z+row.Size.Z/2+0.08),tint,true)
        end
    end
    local notice=part(m,"RefreshNotice",Vector3.new(46,1.2,0.4),Vector3.new(4,3,-29),rgb(27,37,56))
    -- Match the 46:1.2 stud face aspect ratio so glyphs are not stretched horizontally.
    text(face(notice,1840,48),"Interval","Таблица обновляется раз в час",400,0,1040,48,32,rgb(210,220,241),Enum.TextXAlignment.Center)
    return m
end
return Board
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX4174b79a72a143d7b43db338daca75ee">
        <Properties>
          <string name="Name">WorldArt</string>
          <ProtectedString name="Source">local A={}; local V=Vector3.new
function A.Part(parent,name,size,pos,color,material,solid,rotation,shape)
    local p=Instance.new("Part"); p.Name=name; p.Size=size
    p.CFrame=CFrame.new(pos)*(rotation or CFrame.identity); p.Color=color
    p.Material=material or Enum.Material.SmoothPlastic; p.Anchored=true
    p.CanCollide=solid==true; p.CanTouch=false; p.CanQuery=solid==true
    p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    if shape=="Ball" then p.Shape=Enum.PartType.Ball end
    p.Parent=parent; return p
end
function A.Beam(parent,name,a,b,width,color,material)
    local p=A.Part(parent,name,V(width,width,(b-a).Magnitude),(a+b)/2,color,material)
    p.CFrame=CFrame.lookAt((a+b)/2,b); return p
end
function A.Column(parent,name,foot,height,width,depth,color,material,solid)
    -- Roblox clamps individual Part dimensions; tall towers must be segmented.
    local used,index=0,0
    while used&lt;height do
        local length=math.min(256,height-used); index+=1
        local p=A.Part(parent,name,V(width,length,depth),foot+V(0,used+length/2,0),color,material,solid)
        p:SetAttribute("ColumnSegment",index); used+=length
    end
end
function A.Label(parent,pos,size,text,color,face)
    local p=A.Part(parent,"Plaque",size,pos,Color3.fromRGB(24,35,52))
    local gui=Instance.new("SurfaceGui"); gui.Face=face or Enum.NormalId.Back
    gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud; gui.PixelsPerStud=48; gui.Parent=p
    local label=Instance.new("TextLabel"); label.Size=UDim2.fromScale(.94,.9)
    label.Position=UDim2.fromScale(.03,.05); label.BackgroundTransparency=1
    label.Font=Enum.Font.GothamBold; label.TextScaled=true; label.TextWrapped=true
    label.TextColor3=color; label.Text=text; label.Parent=gui
    require(game.ReplicatedStorage.SimulatorShared.TextStyle).Apply(label)
    return p
end
function A.Tree(parent,pos,color,scale)
    scale=scale or 1; local brown=Color3.fromRGB(99,71,64)
    A.Part(parent,"Trunk",V(1.6,8,1.6)*scale,pos+V(0,4,0)*scale,brown)
    for i=1,3 do
        A.Part(parent,"Canopy",V(7-i,5,7-i)*scale,pos+V((i-2)*1.1,7+i*1.5,0)*scale,
            color:Lerp(Color3.new(1,1,1),i*.06),nil,false,CFrame.Angles(0,i,.12*i),"Ball")
    end
end
function A.Ring(parent,pos,radius,color,segments)
    segments=segments or 16
    for i=1,segments do
        local a=(i-1)*math.pi*2/segments; local b=i*math.pi*2/segments
        A.Beam(parent,"Ring",pos+V(math.cos(a)*radius,0,math.sin(a)*radius),pos+V(math.cos(b)*radius,0,math.sin(b)*radius),.16,color,Enum.Material.Neon)
    end
end
return A
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX4c870f966cdd4c65b22fdf900fbec859">
        <Properties>
          <string name="Name">TowerWorld</string>
          <ProtectedString name="Source">local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local Layout=require(game.ReplicatedStorage.SimulatorShared.TowerLayout)
local A=require(script.Parent.WorldArt)
local Factory=require(game.ReplicatedStorage.SimulatorShared.ModelFactory)
local T={}; local V=Vector3.new; local rgb=Color3.fromRGB
local stone=rgb(53,64,83); local gold=rgb(245,202,112)
local names={"САД НЕБЕСНЫХ СТУПЕНЕЙ","ДРЕВО ВЫСОТЫ","ШПИЛЬ СЕВЕРНОГО СИЯНИЯ","СЕРДЦЕ ВУЛКАНА","НЕБЕСНАЯ ОБСЕРВАТОРИЯ"}
local function prompt(base,name,action,object)
    local p=Instance.new("ProximityPrompt"); p.Name=name; p.ActionText=action; p.ObjectText=object
    p.KeyboardKeyCode=Enum.KeyCode.E; p.HoldDuration=0; p.MaxActivationDistance=7
    p.RequiresLineOfSight=false; p.Exclusivity=Enum.ProximityPromptExclusivity.OneGlobally; p.Parent=base
end
function T.Build(map)
    for zone,info in C.Zones do
        local layout=Layout.Build(zone); local color=rgb(table.unpack(info.Color))
        local folder=Instance.new("Folder"); folder.Name="Tower"..zone; folder.Parent=map
        folder:SetAttribute("Zone",zone); folder:SetAttribute("SummitHeight",layout.SummitY)
        local origin=V(layout.X,0,layout.Z)
        A.Part(folder,"Courtyard",V(76,2,60),origin+V(0,-1,3),color:Lerp(stone,.47),nil,true)
        A.Part(folder,"Approach",V(12,.2,14),V(layout.X-18,.1,-39),color:Lerp(stone,.6),nil,true)
        -- Starts at ground level, with no SpawnLocation/visible spawn platform.
        A.Label(folder,V(layout.X,5,-45),V(20,5,.4),names[zone].."\n32 ступени · растущая высота",color)
        local recall=A.Part(map,"TowerRecall"..zone,V(4,.5,4),V(layout.X-29,.25,-48),color,nil,true)
        recall:SetAttribute("RecallZone",zone); prompt(recall,"RecallPrompt","Вернуться к отметке","Башня · точка отдыха")
        A.Label(folder,recall.Position+V(0,2.7,0),V(5,2.6,.3),"ВОЗВРАТ · E\nОтметки: каждые 8 ступеней",color)
        -- Collidable central structure never overlaps the jumping ledges.
        local coreColors={rgb(182,186,154),rgb(105,76,64),rgb(151,191,215),rgb(53,44,54),rgb(188,193,221)}
        local coreColor=coreColors[zone]
        A.Column(folder,"Core",origin,layout.SummitY-1,21,21,coreColor,nil,true)
        for _,s in {-1,1} do
            for _,t in {-1,1} do
                A.Column(folder,"Spine",origin+V(s*10.8,0,t*10.8),layout.SummitY,.45,.45,color,Enum.Material.Neon)
            end
        end
        for _,stage in layout.Stages do
            local pos=V(stage.X,stage.Y-.4,stage.Z)
            local pad=A.Part(folder,"Step"..stage.Index,V(Layout.PlatformSize,.8,Layout.PlatformSize),pos,
                stage.Checkpoint and color or color:Lerp(stone,.48+(stage.Index%2)*.13),nil,true)
            pad:SetAttribute("TowerZone",zone); pad:SetAttribute("TowerStep",stage.Index)
            A.Part(folder,"StepEdge",V(7,.06,.13),pos+V(0,.43,-4.05),stage.Checkpoint and gold or color,Enum.Material.Neon)
            A.Label(folder,pos+V(0,.45,0),V(7,.02,5),tostring(stage.Index)..(stage.Checkpoint and "  ◆" or "").."\n↑ "..string.format("%.1f",stage.Rise),stage.Checkpoint and gold or rgb(230,243,255),Enum.NormalId.Top)
            A.Part(folder,"StepSupport",V(2,.6,2),pos-V(0,.7,0),stone,nil,false,CFrame.Angles(0,math.pi/4,0))
            if stage.Checkpoint then
                A.Beam(folder,"RestFlagPole",pos+V(3.8,.4,3.8),pos+V(3.8,5,3.8),.13,gold)
                A.Part(folder,"RestFlag",V(1.6,1,.12),pos+V(3.1,4.4,3.8),color)
            end
        end
        local summit=A.Part(folder,"Summit",V(42,1,42),origin+V(0,layout.SummitY-.5,0),color:Lerp(stone,.45),nil,true)
        summit:SetAttribute("TowerZone",zone); summit:SetAttribute("TowerStep",33)
        for _,s in {-1,1} do
            -- Open front/back, low rails only on the far left/right edges.
            A.Part(folder,"CrownRail",V(.4,2,38),origin+V(s*20.6,layout.SummitY+1,0),gold)
        end
        A.Ring(folder,origin+V(0,layout.SummitY+.1,0),9,color)
        A.Label(folder,origin+V(0,layout.SummitY+7,-12),V(18,4,.4),"ВЕРШИНА · "..info.Name.."\n"..math.floor(layout.SummitY).." studs",color)
        local statueIds={"Bunny","Deer","Owl","Phoenix","Dragon_Z5_Upgraded"}
        local statue=Factory.Build(statueIds[zone],false); statue.Name="SummitMascot"; statue.Parent=folder
        statue:ScaleTo(zone==5 and 2.6 or 2)
        statue:PivotTo(CFrame.new(origin+V(0,layout.SummitY+4,-7))*CFrame.Angles(0,math.pi,0))
        A.Part(folder,"MascotPedestal",V(7,2,7),origin+V(0,layout.SummitY+1,-7),stone,nil,true)
        local down=A.Part(map,"TowerDown"..zone,V(4,.5,4),origin+V(-16,layout.SummitY+.25,14),color,nil,true)
        down:SetAttribute("TowerDownZone",zone); prompt(down,"DownPrompt","Вниз","Вернуться к яйцам")
        A.Label(folder,down.Position+V(0,2.4,0),V(5,1.5,.25),"К ЯЙЦАМ · E",color)
        -- Four rings frame the vertical scale; biome details keep each tower recognizable.
        for tier=1,4 do
            local y=layout.SummitY*tier/5
            A.Part(folder,"Belt",V(22,.35,22),origin+V(0,y,0),color)
            for side=0,3 do
                local basis=CFrame.new(origin)*CFrame.Angles(0,side*math.pi/2,0)
                for _,s in {-1,1} do
                    local window=basis*CFrame.new(s*5,y-4,-10.65)
                    A.Part(folder,"Recess",V(3.2,7,.14),window.Position,coreColor:Lerp(stone,.7),nil,false,window.Rotation)
                    for _,edge in {-1,1} do
                        local rim=window*CFrame.new(edge*1.75,0,-.09)
                        A.Part(folder,"WindowRim",V(.16,7.4,.14),rim.Position,gold,nil,false,rim.Rotation)
                    end
                    local light=window*CFrame.new(0,0,-.1)
                    A.Part(folder,"WindowLight",V(.16,5,.08),light.Position,color,Enum.Material.Neon,false,light.Rotation)
                end
            end
            if zone==2 then
                for _,s in {-1,1} do
                    A.Beam(folder,"Branch",origin+V(s*10,y,0),origin+V(s*16,y+5,0),1.3,coreColor)
                    A.Part(folder,"Foliage",V(8,5,7),origin+V(s*14,y+7,0),color,nil,false,nil,"Ball")
                end
            elseif zone==3 then
                for _,s in {-1,1} do
                    A.Part(folder,"IceShard",V(3,13,3),origin+V(s*8,y,0),color:Lerp(rgb(255,255,255),.4),Enum.Material.Ice,false,CFrame.Angles(0,.6,s*.18))
                end
            elseif zone==4 then
                for _,s in {-1,1} do A.Beam(folder,"LavaVein",origin+V(s*10.6,y-12,-8),origin+V(s*10.6,y+12,8),.55,rgb(255,103,47),Enum.Material.Neon) end
            elseif zone==5 then
                A.Ring(folder,origin+V(0,y,0),12,gold,20)
            else
                for _,s in {-1,1} do A.Part(folder,"GardenWindow",V(3,4,.2),origin+V(s*5,y, -10.6),gold) end
            end
        end
        if zone==2 then A.Tree(folder,origin+V(0,layout.SummitY+2,0),color,2)
        elseif zone==5 then
            A.Ring(folder,origin+V(0,layout.SummitY+15,0),7,gold)
            A.Part(folder,"AstralHeart",V(5,7,5),origin+V(0,layout.SummitY+12,0),color,Enum.Material.Neon,false,CFrame.Angles(.4,.4,.4))
        end
    end
end
return T
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXa50d29f76ff740b28dfa37eb5474a3ed">
        <Properties>
          <string name="Name">TowerProgress</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local Layout=require(game.ReplicatedStorage.SimulatorShared.TowerLayout)
local Security=require(script.Parent.Security)
local T={}
-- Checkpoints are recovery aids for the current server session, never currency or XP.
function T.Start(map,getData,notice)
    local sessions={}; local closed=false
    local function state(player)
        local s=sessions[player.UserId]
        if not s then s={Checkpoints={},Zone=1,LastRecall=-10}; sessions[player.UserId]=s end
        return s
    end
    local function move(player,pos)
        local char=player.Character; local root=char and char:FindFirstChild("HumanoidRootPart")
        local human=char and char:FindFirstChildOfClass("Humanoid")
        if not root or not human or human.Health&lt;=0 then return false end
        root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero
        char:PivotTo(CFrame.new(pos)); return true
    end
    function T.Recall(player,zone,down)
        if type(zone)~="number" or zone%1~=0 or zone&lt;1 or zone&gt;#C.Zones or type(down)~="boolean" then return false end
        local base=map:FindFirstChild((down and "TowerDown" or "TowerRecall")..zone)
        local data=getData(player); if not base or not data or zone&gt;data.Zone or not Security.Near(player,base,7) then return false end
        local s=state(player); if os.clock()-s.LastRecall&lt;2 then return false end; s.LastRecall=os.clock()
        local checkpoint=s.Checkpoints[zone] or 0
        local stage=checkpoint&gt;0 and Layout.Build(zone).Stages[checkpoint]
        if down or not stage then move(player,C.Zones[zone].Position)
        else move(player,Vector3.new(stage.X,stage.Y+3.5,stage.Z)) end
        notice(player,down and "У подножия башни." or stage and ("Возврат к ступени "..checkpoint..".") or "Сначала достигни отметки на ступени 8.")
        return true
    end
    for _,base in map:GetChildren() do
        local zone=base:GetAttribute("RecallZone"); local down=base:GetAttribute("TowerDownZone")
        if zone then base.RecallPrompt.Triggered:Connect(function(player) T.Recall(player,zone,false) end)
        elseif down then base.DownPrompt.Triggered:Connect(function(player) T.Recall(player,down,true) end) end
    end
    Players.PlayerRemoving:Connect(function(player) sessions[player.UserId]=nil end)
    game:BindToClose(function() closed=true end)
    task.spawn(function()
        while not closed do
            task.wait(.15)
            for _,player in Players:GetPlayers() do
                local data=getData(player); local char=player.Character
                local root=char and char:FindFirstChild("HumanoidRootPart")
                local human=char and char:FindFirstChildOfClass("Humanoid")
                if not data or not root or not human or human.Health&lt;=0 then continue end
                local s=state(player)
                if root.Position.Y &lt; -25 then
                    local zone=math.min(s.Zone,data.Zone); local cp=s.Checkpoints[zone]
                    local stage=cp and Layout.Build(zone).Stages[cp]
                    move(player,stage and Vector3.new(stage.X,stage.Y+3.5,stage.Z) or C.Zones[zone].Position)
                elseif math.abs(root.AssemblyLinearVelocity.Y)&lt;3 and human.FloorMaterial~=Enum.Material.Air then
                    local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={char}
                    local hit=workspace:Raycast(root.Position,Vector3.new(0,-(human.HipHeight+root.Size.Y/2+1),0),params)
                    local step=hit and hit.Instance:GetAttribute("TowerStep"); local zone=hit and hit.Instance:GetAttribute("TowerZone")
                    if step and zone and zone&lt;=data.Zone then
                        s.Zone=zone; player:SetAttribute("TowerZone",zone); player:SetAttribute("TowerStep",step)
                        local checkpoint=math.min(Layout.Steps,step-step%Layout.CheckpointEvery)
                        if checkpoint&gt;0 and checkpoint&gt;(s.Checkpoints[zone] or 0) then
                            s.Checkpoints[zone]=checkpoint; player:SetAttribute("TowerCheckpoint",checkpoint)
                            notice(player,"Отметка башни: "..checkpoint.."/32. Возврат по E у подножия (до выхода из сервера).")
                        end
                    end
                end
            end
        end
    end)
end
return T
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX33e78d68bc8d4c25ad84d15ae08cbf39">
        <Properties>
          <string name="Name">PetGallery</string>
          <ProtectedString name="Source">local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local Concepts=require(game.ReplicatedStorage.SimulatorShared.PetConcepts)
local Factory=require(game.ReplicatedStorage.SimulatorShared.ModelFactory)
local A=require(script.Parent.WorldArt)
local G={}; local V=Vector3.new; local rgb=Color3.fromRGB
local rarityNames={["Обычная"]="Обычный",["Редкая"]="Редкий",["Эпическая"]="Эпический",["Мифическая"]="Мифический",["Легендарная"]="Легендарный",["Секретная"]="Секретный",["Божественная"]="Божественный"}
function G.Build(map)
    local folder=Instance.new("Folder"); folder.Name="PetGallery"; folder.Parent=map
    A.Part(folder,"GalleryGround",V(58,2,108),V(-100,-1,0),rgb(36,49,66),nil,true)
    A.Part(folder,"GalleryBridge",V(25,.2,8),V(-58.5,.1,14),rgb(92,122,137),nil,true)
    for _,z in {9.7,18.3} do A.Beam(folder,"BridgeRim",V(-71,.6,z),V(-46,.6,z),.13,rgb(113,224,199),Enum.Material.Neon) end
    A.Label(folder,V(-100,8,54),V(38,6,.4),"АТЕЛЬЕ ПИТОМЦЕВ\n7 обновлённых видов + 21 концепт",rgb(140,239,219))
    local order={"Cat","Dog","Bunny","Fox","Phoenix","Axolotl","Dragon"}
    for _,id in Concepts.Order do table.insert(order,id) end
    for index,id in order do
        local info=C.PetTypes[id] or Concepts.Types[id]
        local col=(index-1)%4; local row=math.floor((index-1)/4)
        local pos=V(-119+col*12,0,-42+row*13)
        local color=rgb(table.unpack(C.RarityColors[info.Rarity]))
        A.Part(folder,"DisplayBase"..id,V(9,.8,9),pos+V(0,.4,0),rgb(45,61,80),nil,true)
        A.Ring(folder,pos+V(0,.85,0),3.7,color,12)
        local model=Factory.Build(id,false); model.Name="Exhibit_"..id; model.Parent=folder
        model:ScaleTo(1.5); model:PivotTo(CFrame.new(pos+V(0,2.55,0))*CFrame.Angles(0,math.pi,0))
        A.Label(folder,pos+V(0,1,-4.1),V(8,1.8,.22),info.Name.."\n"..(info.Concept and "КОНЦЕПТ · " or "В ИГРЕ · ")..rarityNames[info.Rarity],color,Enum.NormalId.Back)
    end
    for _,x in {-128,-72} do for _,z in {-52,52} do
        A.Part(folder,"PavilionColumn",V(.8,8,.8),V(x,4,z),rgb(105,133,149),nil,true)
    end end
    -- Open-air pavilion; no large opaque roof hiding the collection from the camera.
    for _,x in {-128,-72} do A.Beam(folder,"CanopyFrame",V(x,8,-52),V(x,8,52),.5,rgb(150,199,197)) end
end
return G
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXbf5b01ddda3f4168a27d3ed9c7794dd0">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">local number=require(game.ReplicatedStorage.SimulatorShared.NumberFormat).Compact
local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local TextStyle=require(game.ReplicatedStorage.SimulatorShared.TextStyle)
local LeaderboardTemplate=require(script.Parent.LeaderboardTemplate)
local ModelFactory=require(game.ReplicatedStorage.SimulatorShared.ModelFactory)
local TowerWorld=require(script.Parent.TowerWorld)
local Layout=require(game.ReplicatedStorage.SimulatorShared.TowerLayout)
local A=require(script.Parent.WorldArt)
local Gallery=require(script.Parent.PetGallery)
local World={}
local builtMap
local function part(parent,name,size,position,color)
    local p=Instance.new("Part"); p.Name=name; p.Size=size; p.Position=position
    p.Color=color; p.Material=Enum.Material.SmoothPlastic; p.Anchored=true; p.Parent=parent
    return p
end
local function sign(parent,name,position,text,color)
    local anchor=part(parent,name,Vector3.new(1,1,1),position,color)
    anchor.Transparency=1; anchor.CanCollide=false
    local gui=Instance.new("BillboardGui"); gui.Name="SimulatorSign"
    gui.Size=UDim2.fromOffset(C.SignWidth,C.SignHeight); gui.AlwaysOnTop=false
    -- Client handles player distance and fading; no hard camera-distance cut during the tween.
    gui.MaxDistance=0; gui.Enabled=false; gui.Parent=anchor
    local label=Instance.new("TextLabel"); label.Name="SignText"; label.Size=UDim2.fromScale(1,1)
    label.AnchorPoint=Vector2.new(0.5,0.5); label.Position=UDim2.fromScale(0.5,0.5)
    label.BackgroundColor3=Color3.fromRGB(22,30,50); label.BackgroundTransparency=1
    label.TextColor3=color; label.TextSize=C.SignTextSize; label.Font=Enum.Font.GothamBold
    label.TextWrapped=true; label.Text=text; label.Parent=gui
    TextStyle.Apply(label)
    label.TextTransparency=1; label.TextStrokeTransparency=1
    local scale=Instance.new("UIScale"); scale.Name="RevealScale"; scale.Scale=0.94; scale.Parent=label
    local corner=Instance.new("UICorner"); corner.Parent=label
end
function World.Build()
    if builtMap and builtMap.Parent then return builtMap end
    local existing=workspace:FindFirstChild("SimulatorWorld")
    -- Editor preview is recreated from this module at Play; balance/layout source stays authoritative.
    if existing then existing:Destroy() end
    local map=Instance.new("Folder"); map.Name="SimulatorWorld"; map.Parent=workspace
    part(map,"Ground",Vector3.new(100,2,80),Vector3.new(4,-1,0),Color3.fromRGB(111,157,133))
    part(map,"StartingPlaza",Vector3.new(32,0.2,26),Vector3.new(-12,0.1,0),Color3.fromRGB(47,72,88))
    part(map,"AdvancedPlaza",Vector3.new(28,0.2,26),Vector3.new(24,0.1,0),Color3.fromRGB(67,49,96))
    -- Join x=4..10 exactly: no overlap with either plaza, and a 0.05 stud step below them.
    part(map,"Path",Vector3.new(6,0.2,7),Vector3.new(7,0.05,0),Color3.fromRGB(100,109,134))
    for zone=2,#C.Zones do
        local info=C.Zones[zone]; local x=(zone-1)*120
        local groundColors={Color3.fromRGB(111,157,133),Color3.fromRGB(92,138,106),Color3.fromRGB(183,216,231),Color3.fromRGB(81,69,83),Color3.fromRGB(185,195,221)}
        part(map,"GroundZ"..zone,Vector3.new(100,2,80),Vector3.new(x+4,-1,0),groundColors[zone])
        part(map,"PlazaZ"..zone,Vector3.new(32,.2,26),Vector3.new(x-12,.1,0),Color3.fromRGB(table.unpack(info.Color)):Lerp(Color3.fromRGB(25,35,55),.65))
        sign(map,"ZoneTitle"..zone,Vector3.new(x-16,8,-15),"УРОВЕНЬ "..zone.." · "..info.Name,Color3.fromRGB(table.unpack(info.Color)))
    end
    local function gate(name,target,pos,returning)
        local info=C.Zones[target]; local color=Color3.fromRGB(table.unpack(info.Color))
        local base=part(map,name,Vector3.new(6,.5,6),pos,color); base:SetAttribute("TargetZone",target)
        for _,side in {-1,1} do part(map,name.."Post",Vector3.new(.5,7,.5),pos+Vector3.new(side*3,3.5,0),color) end
        part(map,name.."Arch",Vector3.new(6.5,.5,.5),pos+Vector3.new(0,7,0),color)
        local prompt=Instance.new("ProximityPrompt"); prompt.Name="ZonePrompt"; prompt.KeyboardKeyCode=Enum.KeyCode.E
        prompt.ActionText="Перейти / открыть"; prompt.ObjectText="Уровень "..target.." · "..info.Name; prompt.MaxActivationDistance=8
        prompt.RequiresLineOfSight=false; prompt.Exclusivity=Enum.ProximityPromptExclusivity.OneGlobally; prompt.Parent=base
        sign(map,name.."Label",pos+Vector3.new(0,8,0),"УРОВЕНЬ "..target.." · "..info.Name..(returning and "\nНазад · E" or "\n"..number(info.XP).." опыта · "..number(info.Cost).." монет · E"),color)
    end
    for zone=2,#C.Zones do
        local summit=Layout.Build(zone-1)
        gate("ZoneGate"..zone,zone,Vector3.new(summit.X,summit.SummitY+.45,summit.Z+4),false)
        gate("ZoneReturn"..zone,zone-1,Vector3.new((zone-1)*120-31,.45,24),true)
    end
    for id, info in pairs(C.Stations) do
        local color=id=="Basic" and Color3.fromRGB(65,220,183) or Color3.fromRGB(160,116,255)
        local pad=part(map,id,Vector3.new(8,1,8),info.Position,color); pad.Material=Enum.Material.Neon
        local prompt=Instance.new("ProximityPrompt"); prompt.Name="TrainPrompt"
        prompt.ActionText="Тренироваться"; prompt.ObjectText="Тренировка прыжка"
        prompt.KeyboardKeyCode=Enum.KeyCode.E; prompt.HoldDuration=0; prompt.MaxActivationDistance=C.TrainDistance
        prompt.Exclusivity=Enum.ProximityPromptExclusivity.OneGlobally
        prompt.RequiresLineOfSight=false; prompt.Parent=pad
        sign(map,id.."Sign",info.Position+Vector3.new(0,6,-7),"ТРЕНИРОВКА ПРЫЖКА\nПрыгай или нажимай E",color)
        -- Springboard instead of strength-training barbells.
        part(map,id.."Spring",Vector3.new(3,.4,3),info.Position+Vector3.new(0,.7,0),Color3.fromRGB(210,231,246))

    end
    sign(map,"Welcome",Vector3.new(-34,7,14),"ПРЫЖКИ → ПИТОМЦЫ → НОВЫЕ ЗОНЫ\nПерерождение даёт постоянный бонус",Color3.fromRGB(245,210,106))
    for _,id in C.EggOrder do
        local info=C.Eggs[id]; local color=Color3.fromRGB(table.unpack(info.Color))
        local stand=part(map,"Egg"..id,Vector3.new(5,1.6,5),info.Position,color)
        local egg=ModelFactory.Build(id,true); egg.Name=id.."Shell"; egg.Parent=map
        egg:PivotTo(CFrame.new(info.Position+Vector3.new(0,2.6,0)))
        local prompt=Instance.new("ProximityPrompt"); prompt.Name="EggPrompt"
        prompt.ActionText="Яйца и питомцы"; prompt.ObjectText=info.Name.." • "..number(info.Cost).." монет"
        prompt.KeyboardKeyCode=Enum.KeyCode.E; prompt.MaxActivationDistance=C.EggDistance
        prompt.Exclusivity=Enum.ProximityPromptExclusivity.OneGlobally
        prompt.RequiresLineOfSight=false; prompt.Parent=stand
        sign(map,id.."EggSign",info.Position+Vector3.new(0,6,0),info.Name.."\n"..number(info.Cost).." монет • нажми E",color)
    end
    sign(map,"Milestone",Vector3.new(24,7,-13),"НАГРАДЫ ЗА ПРОГРЕСС\n1 Rebirth: аура • 10 Rebirth: неоновый след",Color3.fromRGB(120,223,255))
    TowerWorld.Build(map)
    Gallery.Build(map)
    for _, z in {37} do
        part(map,"Border"..z,Vector3.new(94,3,1),Vector3.new(4,1.5,z),Color3.fromRGB(52,67,93))
    end
    -- Open west edge for the atelier and north edge for the tower approach.
    for _, x in {51} do
        part(map,"Border"..x,Vector3.new(1,3,74),Vector3.new(x,1.5,0),Color3.fromRGB(52,67,93))
    end
    for zone,info in C.Zones do
        local x=(zone-1)*120; local color=Color3.fromRGB(table.unpack(info.Color))
        for _,side in {-1,1} do
            if zone==2 or zone==1 then A.Tree(map,Vector3.new(x+side*32,0,-25),color,zone==2 and 1.5 or 1)
            elseif zone==3 then
                A.Part(map,"IceGarden",Vector3.new(5,8,5),Vector3.new(x+side*32,3,-25),color,Enum.Material.Ice,false,CFrame.Angles(.15,.5,side*.2))
            elseif zone==4 then
                A.Part(map,"Basalt",Vector3.new(6,9,6),Vector3.new(x+side*32,3,-25),Color3.fromRGB(61,48,64),nil,false,CFrame.Angles(.1,.5,side*.13))
                A.Ring(map,Vector3.new(x+side*32,1,-25),4,color)
            else
                A.Ring(map,Vector3.new(x+side*32,4,-25),4,color)
                A.Part(map,"FloatingStar",Vector3.new(2,3,2),Vector3.new(x+side*32,5,-25),color,Enum.Material.Neon,false,CFrame.Angles(.4,.4,.4))
            end
        end
        -- Decorative paving stays below the gameplay floor, preventing coplanar flashing.
        A.Part(map,"EggWalk"..zone,Vector3.new(8,.12,26),Vector3.new(x-31,.06,-3),color:Lerp(Color3.fromRGB(40,54,72),.7),nil,true)
        A.Label(map,Vector3.new(x-16,3,23),Vector3.new(19,3,.3),"ПРЫГАЙ → ПОДНИМИСЬ НА БАШНЮ\nПортал следующей зоны — на вершине",color)
    end
    local lighting=game:GetService("Lighting")
    lighting.ClockTime=13.5; lighting.Brightness=2; lighting.Ambient=Color3.fromRGB(112,123,145)
    lighting.OutdoorAmbient=Color3.fromRGB(146,158,177)
    local bloom=lighting:FindFirstChild("SimulatorBloom") or Instance.new("BloomEffect")
    bloom.Name="SimulatorBloom"; bloom.Intensity=.12; bloom.Size=18; bloom.Threshold=1.8; bloom.Parent=lighting
    local board=LeaderboardTemplate.Build(map)
    local pivot=board:GetPivot()
    board:PivotTo(CFrame.new(4,pivot.Position.Y,31)*CFrame.Angles(0,math.pi,0))
    builtMap=map
    return map
end
return World
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXcf5cb15452c94213b062cda7571cb745">
        <Properties>
          <string name="Name">Network</string>
          <ProtectedString name="Source">local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local Network={}
function Network.Create()
    local folder=Instance.new("Folder"); folder.Name="SimulatorRemotes"; folder.Parent=game.ReplicatedStorage
    local action=Instance.new("RemoteEvent"); action.Name="Action"; action.Parent=folder
    local state=Instance.new("RemoteEvent"); state.Name="State"; state.Parent=folder
    local notice=Instance.new("RemoteEvent"); notice.Name="Notice"; notice.Parent=folder
    return {Action=action,State=state,Notice=notice}
end
function Network.Snapshot(data, mode, saveStatus)
    local power,coins,xp=C.Requirements(data.Rebirths)
    return {Zone=data.Zone,PracticeXP=data.PracticeXP,AvailablePractice=C.AvailablePractice(data),JumpHeight=C.JumpHeight(data),RequiredPractice=xp,MaxRebirths=C.MaxAffordableRebirths(data),Coins=data.Coins, Power=data.Power, Level=data.Level, Rebirths=data.Rebirths,
        LifetimePower=data.LifetimePower, Multiplier=C.Multiplier(data),
        UpgradeCost=data.Level&lt;C.MaxLevel and C.UpgradeCost(data.Level) or 0,
        RequiredPower=power, RequiredCoins=coins, TotalTrainings=data.TotalTrainings,
        LastDaily=data.LastDaily, LastWeekly=data.LastWeekly, ServerTime=os.time(),
        BronzeAura=data.Cosmetics.BronzeAura==true, NeonTrail=data.Cosmetics.NeonTrail==true,
        Equipped=data.Equipped, Pets=table.clone(data.Pets), EquippedPets=table.clone(data.EquippedPets),
        PetMultiplier=C.PetMultiplier(data), StorageMode=mode, SaveStatus=saveStatus or "ready"}
end
return Network
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX18fc64bc13ac4f4ca9fc70c4e7358aba">
        <Properties>
          <string name="Name">Telemetry</string>
          <ProtectedString name="Source">local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local RunService=game:GetService("RunService")
local Analytics=game:GetService("AnalyticsService")
local Telemetry={}
-- Supported API; opt-in only. Delivery is not claimed without Dashboard verification.
function Telemetry.Step(player,step,name)
    if not C.AnalyticsEnabled or RunService:IsStudio() then return end
    task.spawn(function()
        local ok=pcall(function() Analytics:LogOnboardingFunnelStepEvent(player,step,name) end)
        if not ok then warn("Simulator analytics event unavailable") end
    end)
end
return Telemetry
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX385284fac05041b2ab4786a466bfa567">
        <Properties>
          <string name="Name">Runtime</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local HttpService=game:GetService("HttpService")
local DataStoreService=game:GetService("DataStoreService")
local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local PlayerData=require(script.Parent.PlayerData)
local Progression=require(script.Parent.Progression)
local Rebirth=require(script.Parent.Rebirth)
local Rewards=require(script.Parent.Rewards)
local Security=require(script.Parent.Security)
local Network=require(script.Parent.Network)
local World=require(script.Parent.World)
local Telemetry=require(script.Parent.Telemetry)
local Pets=require(script.Parent.Pets)
local PetVisuals=require(script.Parent.PetVisuals)
local TowerProgress=require(script.Parent.TowerProgress)
local Runtime={sessions={},started=false}
local number=require(game.ReplicatedStorage.SimulatorShared.NumberFormat).Compact
local dataService,remotes,map,mode
local function loadCharacterAtSpawn(player)
    local ok=pcall(function() player:LoadCharacterAsync() end)
    if not ok or player.Parent~=Players then return false end
    local character=player.Character
    local root=character and character:WaitForChild("HumanoidRootPart",10)
    if not root then return false end
    -- LoadCharacterAsync finalizes the engine spawn transform; move only after it returns.
    root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero
    local saved=dataService and dataService:Get(player.UserId)
    character:PivotTo(CFrame.new(saved and C.Zones[saved.Zone].Position or C.SpawnPosition))
    return true
end
local function stats(player,data)
    local folder=player:FindFirstChild("leaderstats")
    if not folder then
        folder=Instance.new("Folder"); folder.Name="leaderstats"; folder.Parent=player
        for _, name in {"Rebirths","JumpRecord"} do local n=Instance.new("NumberValue"); n.Name=name; n.Parent=folder end
    end
    folder.Rebirths.Value=data.Rebirths; folder.JumpRecord.Value=data.LifetimePower
end
local function publish(player)
    local data=dataService:Get(player.UserId)
    if data and player.Parent==Players then
        stats(player,data)
        local session=Runtime.sessions[player.UserId]
        remotes.State:FireClient(player,Network.Snapshot(data,mode,session and session.saveStatus))
    end
end
local function notice(player,message,extra)
    if player.Parent==Players then remotes.Notice:FireClient(player,message,extra) end
end
-- Shared by the RemoteEvent and ProximityPrompt. Tests call the SAME gate on server.
function Runtime.Dispatch(player,action,...)
    local session=Runtime.sessions[player.UserId]
    if not session then return false,"loading" end
    local now=os.clock()
    local limiter=(action=="Train" or action=="Jump") and session.trainLimiter or session.limiter
    if not Security.Allow(limiter,"Request",now,0) then return false,"rate" end
    local args=table.pack(...)
    if not Security.Valid(action,args) then return false,"arguments" end
    local cooldown=action=="Jump" and .35 or action=="Train" and C.TrainCooldown or action=="Hatch" and C.HatchCooldown or action=="PetCraft" and C.CraftCooldown or action=="Rebirth" and 2 or action=="Sync" and 1 or C.ActionCooldown
    local last=session.actionTimes[action]
    if last and now-last&lt;cooldown then return false,"cooldown" end
    session.actionTimes[action]=now
    local data=dataService:Get(player.UserId)
    if not data then return false,"data_unavailable" end
    if action=="Sync" then publish(player); return true end
    if action=="PetMenu" then
        local near=false; local selected,nearest=nil,math.huge
        for id in pairs(C.Eggs) do
            local stand=map:FindFirstChild("Egg"..id)
            if stand and Security.Near(player,stand,C.EggDistance) then
                local distance=(player.Character.HumanoidRootPart.Position-stand.Position).Magnitude
                if distance&lt;nearest then near=true; nearest=distance; selected=id end
            end
        end
        if not near then return false,"distance" end
        notice(player,"Яйца открываются за игровые монеты.",{OpenPets=true,EggId=selected}); return true
    end
    if action=="PrepareRebirth" then
        local amount=args[1] or 1
        local power,coins,xp=C.BatchRequirements(data.Rebirths,amount)
        if not power or data.Power&lt;power or data.Coins&lt;coins or C.AvailablePractice(data)&lt;xp then
            notice(player,"Пока не хватает прыжка, монет или опыта для этой суммы."); return false,"conditions"
        end
        session.confirm={token=HttpService:GenerateGUID(false),expires=now+20,rebirths=data.Rebirths,amount=amount}
        notice(player,("Перерождений: %d. Требуется %s прыжка, списание %s монет и %s опыта. Прыжок и улучшения сбросятся; зоны и питомцы сохранятся."):format(amount,number(power),number(coins),number(xp)),
            {RebirthToken=session.confirm.token,NextMultiplier=C.Multiplier({Rebirths=data.Rebirths+amount})})
        return true
    end
    local previousMultiplier=C.Multiplier(data)
    local ok,message,resultId
    if action=="Zone" then
        local target
        for _,gate in map:GetChildren() do if gate:GetAttribute("TargetZone")==args[1] and Security.Near(player,gate,8) then target=gate; break end end
        if not target then return false,"distance" end
        if args[1]&lt;=data.Zone then ok,message=true,"Переход в зону."
        else ok,message=Progression.UnlockZone(data,args[1]) end
        if ok then player.Character:PivotTo(CFrame.new(C.Zones[args[1]].Position)) end
    elseif action=="Jump" then
        local char=player.Character; local human=char and char:FindFirstChildOfClass("Humanoid")
        local root=char and char:FindFirstChild("HumanoidRootPart")
        if not human or human.Health&lt;=0 or not root then return false,"not_jumping" end
        -- Input can reach the server before the network-owned character's physics update.
        -- Wait briefly for actual upward motion; a remote alone never grants a reward.
        local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={char}
        local groundRay=Vector3.new(0,-(human.HipHeight+root.Size.Y/2+3),0)
        local groundAtRequest=workspace:Raycast(root.Position,groundRay,params)
        local initialY=root.Position.Y; local launched=false
        for _=1,6 do
            if root.AssemblyLinearVelocity.Y&gt;1 or root.Position.Y&gt;initialY+.03 then launched=true; break end
            task.wait(.025)
        end
        if not launched or player.Character~=char or human.Health&lt;=0 or dataService:Get(player.UserId)~=data then return false,"not_jumping" end
        if not groundAtRequest and not workspace:Raycast(root.Position,groundRay,params) then return false,"not_ground_launch" end
        ok,message=Progression.Train(data,"Basic"); session.lastPractice=now
    elseif action=="Train" then
        local station=C.Stations[args[1]]
        local pad=map:FindFirstChild(args[1])
        if not pad or not Security.Near(player,pad,C.TrainDistance) then return false,"distance" end
        if data.Level&lt;station.MinLevel then notice(player,"Продвинутая станция: нужен уровень 3."); return false,"level" end
        ok,message=Progression.Train(data,args[1]); if ok then session.lastPractice=now end
    elseif action=="Hatch" then
        local stand=map:FindFirstChild("Egg"..args[1])
        if not stand or not Security.Near(player,stand,C.EggDistance) then
            notice(player,"Подойди к выбранному яйцу."); return false,"distance"
        end
        ok,message,resultId=Pets.Hatch(data,args[1])
    elseif action=="PetCraft" then ok,message,resultId=Pets.Craft(data,args[1],args[2])
    elseif action=="PetEquip" then ok,message=Pets.Equip(data,args[1])
    elseif action=="PetUnequip" then ok,message=Pets.Unequip(data,args[1])
    elseif action=="PetEquipBest" then ok,message=Pets.EquipBest(data)
    elseif action=="Upgrade" then ok,message=Progression.Upgrade(data)
    elseif action=="Rebirth" then
        local confirmation=session.confirm
        session.confirm=nil -- Single use, expires, bound to this player's current cycle.
        if not confirmation or confirmation.token~=args[1] or confirmation.expires&lt;now
            or confirmation.rebirths~=data.Rebirths then return false,"confirmation" end
        ok,message=Rebirth.Apply(data,confirmation.amount)
    elseif action=="Daily" or action=="Weekly" then ok,message=Rewards.Claim(data,action,os.time())
    elseif action=="Equip" then ok,message=Rewards.Equip(data,args[1]) end
    if not ok then notice(player,message or "Действие недоступно."); return false,"conditions" end
    Rewards.Reconcile(data)
    dataService:Changed(player.UserId)
    if action=="Equip" or action=="Rebirth" then Rewards.ApplyCharacter(player,data) end
    if action=="PetEquip" or action=="PetUnequip" or action=="PetEquipBest" or action=="Hatch" or action=="PetCraft" then PetVisuals.Apply(player,data) end
    Progression.ApplyJump(player,data)
    publish(player)
    local extra
    if action=="Hatch" or action=="PetCraft" or action=="Rebirth" then
        extra={Result={Action=action,Id=resultId,Source=args[1],Duration=action=="Rebirth" and 2 or 4,Multiplier=C.Multiplier(data),PreviousMultiplier=previousMultiplier}}
    end
    notice(player,message,extra)
    if action=="Train" and data.TotalTrainings==1 then Telemetry.Step(player,2,"FirstTraining") end
    if action=="Upgrade" and data.Level==1 then Telemetry.Step(player,3,"FirstUpgrade") end
    if action=="Rebirth" and data.Rebirths==1 then Telemetry.Step(player,4,"FirstRebirth") end
    return true
end
local function savePlayer(player,release)
    local ok,reason=dataService:Save(player.UserId,release)
    local session=Runtime.sessions[player.UserId]
    if not release and session then
        session.saveStatus=ok and "saved" or "retry"
        publish(player)
        if not ok then notice(player,"Сохранение задерживается. Игра повторит попытку.") end
    end
    if not ok then warn("Simulator save failed: "..tostring(reason)) end
    return ok
end
local function joined(player)
    local ok,reason=dataService:Load(player.UserId)
    if not ok then
        if player.Parent==Players then player:Kick("Не удалось безопасно загрузить прогресс ("..reason.."). Подожди и войди снова. Данные не сброшены.") end
        return
    end
    if player.Parent~=Players or dataService.closing then dataService:Save(player.UserId,true); return end
    Runtime.sessions[player.UserId]={limiter=Security.NewLimiter(),trainLimiter=Security.NewLimiter(C.TrainRemoteBurst,C.TrainRemotePerSecond),actionTimes={},saveStatus="ready"}
    local data=dataService:Get(player.UserId)
    if not data then player:Kick("Сессия данных истекла. Войди снова."); return end
    if Rewards.Reconcile(data) then dataService:Changed(player.UserId) end
    stats(player,data)
    player.CharacterAdded:Connect(function(char)
        local root=char:WaitForChild("HumanoidRootPart",10)
        local current=dataService:Get(player.UserId)
        if root and current then Rewards.ApplyCharacter(player,current); PetVisuals.Apply(player,current); Progression.ApplyJump(player,current) end
        local humanoid=char:WaitForChild("Humanoid",10)
        if humanoid then
            humanoid.Died:Connect(function()
                task.delay(3,function()
                    if player.Parent==Players and dataService:Get(player.UserId) then
                        local loaded=loadCharacterAtSpawn(player)
                        if not loaded then player:Kick("Не удалось загрузить персонажа. Войди снова.") end
                    end
                end)
            end)
        end
    end)
    local loaded=loadCharacterAtSpawn(player)
    if not loaded then player:Kick("Не удалось загрузить персонажа. Войди снова."); return end
    Progression.ApplyJump(player,data)
    if data.Zone&gt;1 then player.Character:PivotTo(CFrame.new(C.Zones[data.Zone].Position)) end
    publish(player); Telemetry.Step(player,1,"Joined")
end
-- Test access is server-only and fails closed outside an offline Studio sandbox.
function Runtime.StudioProfile(player)
    assert(RunService:IsStudio() and mode=="sandbox","Studio sandbox only")
    return dataService:Get(player.UserId)
end
function Runtime.Start()
    assert(not Runtime.started,"Runtime already started"); Runtime.started=true
    Players.CharacterAutoLoads=false
    mode=RunService:IsStudio() and C.StudioOffline and "sandbox" or "datastore"
    local store
    if mode=="datastore" then
        store=DataStoreService:GetDataStore(RunService:IsStudio() and C.StudioStoreName or C.StoreName)
    end
    dataService=PlayerData.new(store,{offline=mode=="sandbox"})
    map=World.Build(); remotes=Network.Create()
    TowerProgress.Start(map,function(player) return dataService:Get(player.UserId) end,notice)
    remotes.Action.OnServerEvent:Connect(function(player,action,...) Runtime.Dispatch(player,action,...) end)
    for id in pairs(C.Stations) do
        map[id].TrainPrompt.Triggered:Connect(function(player) Runtime.Dispatch(player,"Train",id) end)
    end
    for id in pairs(C.Eggs) do
        map["Egg"..id].EggPrompt.Triggered:Connect(function(player) Runtime.Dispatch(player,"PetMenu") end)
    end
    for _,gate in map:GetChildren() do
        local target=gate:GetAttribute("TargetZone")
        if target then gate.ZonePrompt.Triggered:Connect(function(player) Runtime.Dispatch(player,"Zone",target) end) end
    end
    Players.PlayerAdded:Connect(joined)
    Players.PlayerRemoving:Connect(function(player)
        savePlayer(player,true); Runtime.sessions[player.UserId]=nil
    end)
    for _, player in Players:GetPlayers() do task.spawn(joined,player) end
    task.spawn(function()
        while not dataService.closing do
            task.wait(C.AutoSaveSeconds)
            if dataService.closing then break end
            for _,player in Players:GetPlayers() do task.spawn(savePlayer,player,false) end
        end
    end)
    task.spawn(function()
        while not dataService.closing do
            task.wait(2)
            for _,player in Players:GetPlayers() do
                if Runtime.sessions[player.UserId] and not dataService:Get(player.UserId) then
                    player:Kick("Защита данных: сохранение недоступно или сессия истекла. Войди снова позже.")
                end
            end
        end
    end)
    task.spawn(function()
        while not dataService.closing do
            task.wait(1)
            for _,player in Players:GetPlayers() do
                local session=Runtime.sessions[player.UserId]; local data=dataService:Get(player.UserId)
                local human=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
                -- At most one XP per elapsed second; no AFK/offline/click-rate or pet multiplier.
                if data and session and human and human.Health&gt;0 and session.lastPractice and os.clock()-session.lastPractice&lt;=1.5 then
                    Progression.Practice(data,1); dataService:Changed(player.UserId); publish(player)
                end
            end
        end
    end)
    game:BindToClose(function()
        dataService.closing=true
        local pending=0
        for userId in pairs(dataService.profiles) do
            pending+=1
            task.spawn(function()
                local ok=dataService:Save(userId,true)
                if not ok then warn("Simulator final save failed") end
                pending-=1
            end)
        end
        local deadline=os.clock()+25
        while (pending&gt;0 or next(dataService.loading)~=nil) and os.clock()&lt;deadline do task.wait(0.1) end
    end)
    print("SIMULATOR_READY mode="..mode)
end
return Runtime
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBXe8c56f4bb0b44905a6a5ef4e3bb78c9b">
        <Properties>
          <string name="Name">Bootstrap</string>
          <ProtectedString name="Source">require(script.Parent.Runtime).Start()
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBXd9c3c9f67c4b453b96be8d96f69f7df4">
        <Properties>
          <string name="Name">Tests</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX7e432fb1b3a74dc7a3143e70c00174de">
          <Properties>
            <string name="Name">Spec</string>
            <ProtectedString name="Source">-- Server-only deterministic tests. No production DataStore, no real user records.
local Root=game.ServerScriptService.Simulator
local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local Schema=require(Root.Schema)
local Data=require(Root.PlayerData)
local P=require(Root.Progression)
local R=require(Root.Rebirth)
local Rewards=require(Root.Rewards)
local S=require(Root.Security)
local Pets=require(Root.Pets)
local Spec={}
function Spec.Run()
    local count=0
    local function check(value,message) assert(value,message); count+=1 end
    local obtainable={}
    for _,eggId in C.EggOrder do
        local egg=C.Eggs[eggId]; local total=0
        for id,weight in egg.Weights do
            check(C.PetTypes[id] and not C.PetTypes[id].Upgraded and weight&gt;0,"valid base egg drop "..id)
            total+=weight
        end
        check(total==100,"published egg odds sum to 100 "..eggId)
        local threshold=0
        for _,id in C.PetOrder do
            local weight=egg.Weights[id] or 0
            if weight&gt;0 then
                local sample=Schema.New(); sample.Zone=5; sample.Coins=egg.Cost
                local ok,_,drop=Pets.Hatch(sample,eggId,function() return (threshold+weight/2)/total end)
                check(ok and drop==id and sample.Coins==0 and sample.Pets[id]==1,"paid midpoint drop "..eggId..id)
                check(Schema.Validate(sample)~=nil,"new drop profile validates "..id)
                obtainable[C.PetTypes[id].Rarity]=true
                threshold+=weight
            end
        end
        local sample=Schema.New(); sample.Zone=5; sample.Coins=egg.Cost
        local ok,_,drop=Pets.Hatch(sample,eggId,function() return 1-1e-12 end)
        check(ok and (egg.Weights[drop] or 0)&gt;0,"upper endpoint never selects a zero-weight pet")
    end
    for _,rarity in C.Rarities do check(obtainable[rarity],"each rarity obtainable "..rarity) end
    for _,id in C.PetOrder do
        local sample=Schema.New(); sample.Pets={[id]=3}; sample.EquippedPets={[id]=3}
        check(Pets.Craft(sample,id,{1,2,3}),"craft each species "..id)
        check(math.abs(C.PetMultiplier(sample)-(1+C.PetTypes[id].Bonus)*4)&lt;1e-9,"fourfold coefficient "..id)
        check(Schema.Validate(sample)~=nil and Pets.EquipBest(sample),"new crafted species survives validation and best equip")
    end
    local best=Schema.New()
    check(not Pets.EquipBest(best),"empty best selection rejected")
    best.Pets={Cat=5,Dog=2,Bunny=2}; best.EquippedPets={Cat=3}
    check(Pets.EquipBest(best) and best.EquippedPets.Bunny==2 and best.EquippedPets.Dog==1 and best.EquippedPets.Cat==nil,"best selects strongest owned copies")
    check(Pets.EquippedCount(best)==3 and math.abs(C.PetMultiplier(best)-1.90)&lt;.00001,"best team multiplier and cap")
    check(Pets.EquipBest(best) and best.EquippedPets.Bunny==2 and best.EquippedPets.Dog==1,"best repeat stable")
    best.Pets={Cat=1}; best.EquippedPets={}
    check(Pets.EquipBest(best) and best.EquippedPets.Cat==1 and Pets.EquippedCount(best)==1,"best handles fewer than three")
    check(S.Valid("PetEquipBest",{n=0}) and not S.Valid("PetEquipBest",{n=1,"Bunny"}),"best ignores client pet choice")
    local craft=Schema.New(); craft.Pets={Cat=3}; craft.EquippedPets={Cat=3}; craft.Coins=99
    local crafted,_,result=Pets.Craft(craft,"Cat",{1,2,3})
    check(crafted and result=="Cat_Upgraded" and craft.Pets.Cat==nil and craft.Pets.Cat_Upgraded==1,"three become one upgraded")
    check(craft.Coins==99 and craft.EquippedPets.Cat==nil and craft.EquippedPets.Cat_Upgraded==1,"craft consumes equipped originals and equips result")
    check(math.abs(C.PetMultiplier(craft)-4.4)&lt;.000001,"upgraded multiplier exactly four times x1.10")
    check(Schema.Validate(craft)~=nil,"crafted profile validates")
    check(not Pets.Craft(craft,"Cat_Upgraded",{1,2,3}),"upgraded cannot craft again")
    check(not Pets.Craft(craft,"Cat",{1,2,3}) and craft.Pets.Cat_Upgraded==1,"craft replay cannot duplicate")
    local partial=Schema.New(); partial.Pets={Dog=5}; partial.EquippedPets={Dog=3}
    check(not Pets.Craft(partial,"Dog",{1,1,2}) and partial.Pets.Dog==5,"duplicate craft indices rejected without consumption")
    check(not Pets.Craft(partial,"Dog",{1,2,6}) and partial.Pets.Dog==5,"unowned copy rejected")
    check(not Pets.Craft(partial,"Dog",{[1]=1,[3]=3}) and partial.Pets.Dog==5,"sparse craft selection rejected")
    check(Pets.Craft(partial,"Dog",{2,4,5}) and partial.Pets.Dog==2 and partial.EquippedPets.Dog==2 and partial.EquippedPets.Dog_Upgraded==1,"mixed equipped selection preserves unconsumed copies")
    check(Pets.EquipBest(partial) and partial.EquippedPets.Dog_Upgraded==1,"best includes upgraded")
    check(S.Valid("PetCraft",table.pack("Cat",{1,2,3})) and not S.Valid("PetCraft",table.pack("Cat",{1,2,3},999)),"craft strict arguments")
    check(not S.Valid("PetCraft",table.pack("Cat",{1,2,2})) and not S.Valid("PetCraft",table.pack("Cat_Upgraded",{1,2,3})),"craft invalid selection and variant rejected")
    local legacy=Schema.New(); legacy.Version=3; legacy.Coins=123; legacy.Pets={Cat=2}; legacy.EquippedPets={Cat=1}
    local upgradedSchema=Schema.Validate(legacy)
    check(upgradedSchema and upgradedSchema.Version==5 and upgradedSchema.Coins==123 and upgradedSchema.EquippedPets.Cat==1,"v3 migration preserves progress and team")
    local d=Schema.New()
    check(Schema.Validate(d)~=nil,"default schema")
    local interactions={}
    for _,info in pairs(C.Stations) do table.insert(interactions,{Position=info.Position,Radius=C.TrainDistance}) end
    for _,info in pairs(C.Eggs) do table.insert(interactions,{Position=info.Position,Radius=C.EggDistance}) end
    for i,a in interactions do
        for j=i+1,#interactions do
            local b=interactions[j]; local dx=a.Position.X-b.Position.X; local dy=a.Position.Y-b.Position.Y; local dz=a.Position.Z-b.Position.Z
            check(math.sqrt(dx*dx+dy*dy+dz*dz)&gt;a.Radius+b.Radius,"interaction reach volumes do not overlap")
        end
    end
    local old=Schema.New(); old.Version=1; old.Pets=nil; old.EquippedPet=nil; old.Coins=123
    local migrated=Schema.Validate(old)
    check(migrated and migrated.Version==5 and migrated.Coins==123 and next(migrated.Pets)==nil,"migrate old profile without progress loss")
    local petData=Schema.New()
    check(not Pets.Hatch(petData,"Meadow"),"no coins no hatch")
    petData.Coins=1000
    check(not Pets.Hatch(petData,"Fake"),"unknown egg rejected")
    check(not Pets.Hatch(petData,"Meadow",function() return 0/0 end) and petData.Coins==1000,"bad roll preserves coins")
    for _,case in {{0,"Cat"},{.6,"Dog"},{.9,"Bunny"}} do
        local before=petData.Coins
        local ok,_,id=Pets.Hatch(petData,"Meadow",function() return case[1] end)
        check(ok and id==case[2] and petData.Coins==before-C.Eggs.Meadow.Cost,"weighted hatch and exact cost")
    end
    check(Pets.Count(petData)==3 and petData.EquippedPets.Cat==1,"auto equip first and inventory count")
    Pets.Equip(petData,"")
    check(Pets.Equip(petData,"Bunny") and C.PetMultiplier(petData)==1.35,"owned pet bonus")
    local power,coins=C.Gains(petData,1)
    check(power==6 and coins==10,"server gains include single pet bonus")
    local bonusData=Schema.New(); bonusData.Level=3; bonusData.Rebirths=2
    bonusData.Pets.Bunny=1; bonusData.EquippedPets.Bunny=1
    local totalPower,totalCoins=C.TrainingMultipliers(bonusData,1.25)
    check(math.abs(totalPower-1.6*1.16*1.25*1.35)&lt;.000001 and math.abs(totalCoins-1.45*1.16*1.25*1.35)&lt;.000001,"separate total multipliers combine all active bonuses")
    local gainPower,gainCoins=C.Gains(bonusData,1.25)
    check(gainPower==math.floor(C.BasePower*totalPower) and gainCoins==math.floor(C.BaseCoins*totalCoins),"HUD multipliers match server gain formula")
    check(Schema.Validate(petData)~=nil,"pet profile valid")
    local v2=Schema.Copy(petData); v2.Version=2; v2.EquippedPets=nil; v2.EquippedPet="Bunny"
    local v3=Schema.Validate(v2)
    check(v3 and v3.Version==5 and v3.EquippedPets.Bunny==1 and v3.Pets.Bunny==1,"migrate v2 equipment")
    local team=Schema.New(); team.Pets.Cat=4
    check(Pets.Equip(team,"Cat") and Pets.Equip(team,"Cat") and Pets.Equip(team,"Cat"),"three owned copies can equip")
    check(not Pets.Equip(team,"Cat") and Pets.EquippedCount(team)==3,"fourth ordinary slot denied")
    check(math.abs(C.PetMultiplier(team)-1.3)&lt;.000001,"three active bonuses sum")
    check(Pets.Unequip(team,"Cat") and Pets.EquippedCount(team)==2 and Pets.Equip(team,"Cat"),"remove one and refill")
    team.EquippedPets.Cat=4; check(Schema.Validate(team)==nil,"persisted fourth slot denied")
    local lockedData=Schema.New(); lockedData.Coins=1000
    local minLevel=C.Eggs.Meadow.MinLevel; C.Eggs.Meadow.MinLevel=3
    local lockedOk=Pets.Hatch(lockedData,"Meadow")
    C.Eggs.Meadow.MinLevel=minLevel
    check(not lockedOk and lockedData.Coins==1000,"locked egg never charges")
    petData.Power=C.Requirements(0); petData.Coins=2000; petData.PracticeXP=90
    check(R.Apply(petData) and petData.Pets.Bunny==1 and petData.EquippedPets.Bunny==1,"rebirth preserves pets")
    check(Pets.Equip(petData,"") and C.PetMultiplier(petData)==1,"unequip removes bonus")
    check(not Pets.Equip(Schema.New(),"Dog"),"cannot equip unowned pet")
    local full=Schema.New(); full.Coins=1000; full.Pets.Cat=C.MaxPets
    check(not Pets.Hatch(full,"Meadow") and full.Coins==1000,"capacity blocks without charge")
    full.Pets.Cat+=1; check(Schema.Validate(full)==nil,"oversized inventory rejected")
    local corrupt=Schema.New(); corrupt.Pets.Cat=-1; check(Schema.Validate(corrupt)==nil,"negative pets rejected")
    corrupt=Schema.New(); corrupt.Pets.Fake=1; check(Schema.Validate(corrupt)==nil,"unknown pet rejected")
    corrupt=Schema.New(); corrupt.EquippedPets.Dog=1; check(Schema.Validate(corrupt)==nil,"unowned equipped pet rejected")
    check(S.Valid("Hatch",table.pack("Meadow")) and not S.Valid("Hatch",table.pack("Meadow","Bunny")),"client cannot choose hatch result")
    check(not S.Valid("PetEquip",table.pack({})) and not S.Valid("Hatch",table.pack("Fake")),"malformed pet remotes rejected")
    d.Coins=0/0; check(Schema.Validate(d)==nil,"reject NaN")
    d=Schema.New(); d.Power=math.huge; check(Schema.Validate(d)==nil,"reject infinity")
    d=Schema.New(); d.Coins=-1; check(Schema.Validate(d)==nil,"reject negative")
    d=Schema.New(); check(not P.Upgrade(d),"cannot buy without coins")
    check(not P.Train(d,"Advanced"),"zone level locked")
    P.Train(d,"Basic"); check(d.Power==5 and d.Coins==8 and d.LifetimePower==5,"server training gains")
    for _=1,3 do P.Train(d,"Basic") end
    check(P.Upgrade(d) and d.Level==1 and d.Coins==7,"deduct exact cost")
    check(not R.Apply(d),"early rebirth rejected")
    d.Power=C.Requirements(0); d.Coins=2000; d.PracticeXP=90; d.LastDaily=100; d.Cosmetics.BronzeAura=true; d.Equipped="BronzeAura"
    local lifetime=d.LifetimePower
    check(R.Apply(d),"rebirth allowed")
    check(d.Power==0 and d.Coins==0 and d.Level==0 and d.Rebirths==1,"reset only cycle fields")
    check(d.LifetimePower==lifetime and d.LastDaily==100 and d.Equipped=="BronzeAura","preserve persistent fields")
    check(C.Multiplier(d)==1.08,"controlled permanent bonus")
    d.Rebirths=10; check(Rewards.Reconcile(d) and d.Cosmetics.NeonTrail,"milestone")
    check(not Rewards.Reconcile(d),"milestone idempotent")
    check(not Rewards.Equip(Schema.New(),"NeonTrail"),"unowned cosmetic rejected")
    d=Schema.New(); check(not Rewards.Claim(d,"Daily",1000),"new account reward gated")
    d.TotalTrainings=3
    check(Rewards.Claim(d,"Daily",1000),"daily first claim")
    local coins=d.Coins
    check(not Rewards.Claim(d,"Daily",1001) and d.Coins==coins,"daily duplication rejected")
    check(not Rewards.Claim(d,"Daily",999),"clock rollback")
    check(Rewards.Claim(d,"Daily",1000+C.DailySeconds),"daily interval boundary")
    check(Rewards.Claim(d,"Weekly",1000),"weekly first claim")
    check(not Rewards.Claim(d,"Weekly",1000+C.WeeklySeconds-1),"weekly interval")
    check(Rewards.Claim(d,"Weekly",1000+C.WeeklySeconds),"weekly ready")
    check(not S.Valid("Train",table.pack("Basic",1000000)),"extra reward arg rejected")
    check(not S.Valid("Train",table.pack({})),"wrong type rejected")
    check(not S.Valid("Train",table.pack("Fake")),"unknown station rejected")
    check(not S.Valid("Rebirth",table.pack(true)),"confirmation type rejected")
    check(not S.Valid("Coins",table.pack(100000)),"no give currency action")
    local limiter=S.NewLimiter()
    check(S.Allow(limiter,"Train",limiter.at,0.8),"first request allowed")
    check(not S.Allow(limiter,"Train",limiter.at+0.1,0.8),"cooldown")
    limiter=S.NewLimiter(); local accepted=0; local instant=limiter.at
    for _=1,50 do if S.Allow(limiter,"Request",instant,0) then accepted+=1 end end
    check(accepted==C.RemoteBurst,"bounded remote burst")
    local training=S.NewLimiter(C.TrainRemoteBurst,C.TrainRemotePerSecond)
    local rapid=0; local at=training.at
    for _=1,20 do if S.Allow(training,"Train",at,C.TrainCooldown) then rapid+=1 end end
    check(rapid==20,"twenty taps without cooldown")
    for _=1,100 do S.Allow(training,"Train",at,0) end
    check(not S.Allow(training,"Train",at,0),"training abuse budget bounded")
    check(S.Allow(training,"Train",at+1,0),"training budget refills")
    check(not S.Near({Character=nil},{Position=Vector3.zero},11),"no dead/missing character activity")

    local clock=1000
    local store={records={},calls=0,fail=false,doubleCallback=false,afterWriteFailure=false}
    function store:UpdateAsync(key,callback)
        self.calls+=1
        if self.fail then error("simulated outage") end
        local old=Schema.Copy(self.records[key])
        if self.doubleCallback then callback(Schema.Copy(old)) end
        local result=callback(old)
        if result then self.records[key]=Schema.Copy(result) end
        if result and self.afterWriteFailure then self.afterWriteFailure=false; error("response lost after commit") end
        return Schema.Copy(result)
    end
    local opts={now=function() return clock end,wait=function() end,token="A"}
    local a=Data.new(store,opts)
    check(a:Load(77),"load new player")
    a:Get(77).Pets.Bunny=2; a:Get(77).EquippedPets.Bunny=1; a:Get(77).Pets.Cat_Upgraded=1; a:Get(77).EquippedPets.Cat_Upgraded=1
    a:Get(77).Coins=250; a:Get(77).Zone=3; a:Get(77).PracticeXP=1800; a:Get(77).RebirthXPSpent=90; a:Changed(77)
    store.doubleCallback=true
    check(a:Save(77,false) and store.records.Player_77.Data.Coins==250,"callback retry safe")
    local b=Data.new(store,{now=opts.now,wait=opts.wait,token="B"})
    check(not b:Load(77),"second server session locked")
    local before=Schema.Copy(store.records.Player_77)
    store.fail=true
    local c=Data.new(store,{now=opts.now,wait=opts.wait,token="C"})
    check(not c:Load(77) and c:Get(77)==nil,"load error never exposes default profile")
    check(c:Save(77,true) and store.records.Player_77.Data.Coins==before.Data.Coins,"load error cannot overwrite")
    check(not a:Save(77,false),"save outage handled")
    store.fail=false; store.afterWriteFailure=true
    check(a:Save(77,false) and store.records.Player_77.Data.Coins==250,"commit response lost retry safe")
    check(a:Save(77,true) and store.records.Player_77.Session==nil,"release lock")
    check(b:Load(77) and b:Get(77).Coins==250,"reload persisted progress")
    check(b:Get(77).Zone==3 and b:Get(77).PracticeXP==1800 and b:Get(77).RebirthXPSpent==90,"new zone and XP persistence roundtrip")
    check(b:Get(77).Pets.Bunny==2 and b:Get(77).EquippedPets.Bunny==1,"pet save reload roundtrip")
    check(b:Get(77).Pets.Cat_Upgraded==1 and b:Get(77).EquippedPets.Cat_Upgraded==1,"upgraded pet persistence roundtrip")
    b:Get(77).Coins=400; b:Changed(77); check(b:Save(77,false),"second session saves")
    clock+=C.LeaseSeconds+1
    check(b:Get(77)==nil,"expired lease freezes actions")
    check(c:Load(77),"stale lease takeover")
    check(not b:Save(77,false),"old server cannot overwrite takeover")
    check(store.records.Player_77.Data.Coins==400,"takeover data intact")
    store.records.Player_88={Schema=99,Data=Schema.New(),Revision=0}
    check(not a:Load(88) and store.records.Player_88.Schema==99,"unknown schema preserved")
    store.records.Player_89={Schema=1,Data=Schema.New(),Revision=0}
    store.records.Player_89.Data.Coins=-20
    check(not a:Load(89) and store.records.Player_89.Data.Coins==-20,"corrupt data not overwritten")
    check(c:Save(77,true),"final save")
    local offline=Data.new(nil,{offline=true})
    check(offline:Load(1) and offline:Get(1).Coins==0,"explicit offline default")
    offline.closing=true; check(offline:Get(1)==nil and not offline:Load(2),"shutdown freezes operations")
    check(offline:Save(1,true),"shutdown release")

    local v4=Schema.New(); v4.Version=4; v4.Zone=nil; v4.PracticeXP=nil; v4.RebirthXPSpent=nil
    v4.Power=12345; v4.Pets={Dragon_Upgraded=1}; v4.EquippedPets={Dragon_Upgraded=1}
    local migrated4=Schema.Validate(v4)
    check(migrated4 and migrated4.Version==5 and migrated4.Zone==1 and migrated4.PracticeXP==0 and migrated4.Power==12345 and migrated4.EquippedPets.Dragon_Upgraded==1,"v4 migration keeps jump progress and legacy pets")
    local invalid=Schema.New(); invalid.RebirthXPSpent=1; check(not Schema.Validate(invalid),"cannot spend more XP than earned")
    invalid=Schema.New(); invalid.Zone=6; check(not Schema.Validate(invalid),"unknown zone rejected")
    check(S.Valid("PrepareRebirth",table.pack(5)) and not S.Valid("PrepareRebirth",table.pack(101)) and not S.Valid("PrepareRebirth",table.pack(0/0)),"strict batch prepare arguments")
    check(math.abs(C.JumpHeight(Schema.New())-C.BaseJumpHeight*.05)&lt;1e-9,"initial jump is five percent of baseline")
    local growth=Schema.New(); local before=C.JumpHeight(growth); P.Train(growth,"Basic")
    check(C.JumpHeight(growth)&gt;before,"training actually increases jump height")
    growth.Power=C.MaxValue; check(C.JumpHeight(growth)==C.MaxJumpHeight,"physics height capped")
    local priceP,priceC,priceX=C.BatchRequirements(2,5); local p,c,x=0,0,0
    for i=2,6 do local a,b,d=C.Requirements(i); p+=a;c+=b;x+=d end
    check(priceP==p and priceC==c and priceX==x,"bulk includes exact sum of every ascending cost")
    local batch=Schema.New(); batch.Rebirths=2; batch.Power=p; batch.Coins=c+123; batch.PracticeXP=x; batch.Zone=3; batch.Level=7
    check(C.MaxAffordableRebirths(batch)==5,"maximum affordability includes XP and following costs")
    check(R.Apply(batch,5) and batch.Rebirths==7 and batch.Coins==123 and batch.Power==0 and batch.Level==0 and batch.RebirthXPSpent==x and batch.Zone==3,"bulk atomic reset preserves zone and exact change")
    check(not R.Apply(batch,5),"bulk replay lacks resources")
    for _,bad in {0,-1,.5,101,math.huge,0/0,"5"} do check(C.BatchRequirements(0,bad)==nil,"invalid bulk quantity") end
    check(C.BatchRequirements(C.MaxRebirths-1,2)==nil,"bulk respects rebirth cap")
    local zone=Schema.New(); zone.Coins=10000000; zone.PracticeXP=1799
    check(not P.UnlockZone(zone,3),"cannot skip a zone")
    check(P.UnlockZone(zone,2),"unlock second zone")
    check(not P.UnlockZone(zone,3),"third zone requires at least 1800 active XP")
    P.Practice(zone,1); check(P.UnlockZone(zone,3) and zone.Zone==3,"third zone at activity threshold")
    check(not P.Practice(zone,10000) and not P.Practice(zone,-1),"XP rejects unbounded time")
    local locked=Schema.New(); locked.Coins=C.MaxValue
    check(not Pets.Hatch(locked,"Celestial") and locked.Coins==C.MaxValue,"zone lock cannot be bypassed by coins")
    for i=1,5 do
        check(#C.Zones[i].Eggs==2,"two eggs per zone")
        for _,id in C.Zones[i].Eggs do
            check(C.Eggs[id].Zone==i,"egg belongs to advertised zone")
            for pet in C.Eggs[id].Weights do check(C.PetTypes[pet].Zone==i,"drop belongs to same zone") end
        end
        if i&gt;1 then check(C.PetTypes["Cat_Z"..i].Bonus&gt;C.PetTypes[i==2 and "Cat" or "Cat_Z"..(i-1)].Bonus,"later pets stronger") end
    end
    print(("SIMULATOR_SPEC_PASS %d assertions; jump bulk zones migration leases pets"):format(count))
    return {Assertions=count}
end
return Spec
</ProtectedString>
