        refs.Selected=name
    end
    for name,tab in pairs(tabs) do tab.Activated:Connect(function() refs.Select(name); if refresh then refresh() end end) end
    local function detail()
        if not selected then return end
        local info=(selected.Egg and C.Eggs or C.PetTypes)[selected.Id]
        title.Text=selected.Odds and "Шансы выпадения" or Headings.Item(selected.Id)
        local unlocked=not selected.Egg or ((state.Level or 0)&gt;=info.MinLevel and (state.Zone or 1)&gt;=(info.Zone or 1))
        description.Text=not unlocked and "Недоступно: зона "..number(info.Zone or 1) or
            (rarity(info,selected.Egg).."\n"..(selected.Egg and number(info.Cost).." монет" or ("Прыжок и монеты x%.2f"):format(1+info.Bonus)).."\n"..info.Description)
        description.TextColor3=rarityColor(info)
        if selected.Egg then primary.Text="Открыть · "..number(info.Cost).." монет"; primary.Active=unlocked; combine.Visible=true; combine.Active=unlocked; combine.Text="Шансы выпадения"
        else
            local owned=(state.Pets or {})[selected.Id] or 0; local eq=(state.EquippedPets or {})[selected.Id] or 0
            primary.Text=eq&gt;0 and "Снять" or "Экипировать"; primary.Active=owned&gt;0
            combine.Visible=true; combine.Active=not info.Upgraded and owned&gt;=3
            combine.Text=info.Upgraded and "Уже улучшенный" or refs.CraftId and ("Совместить · %d/3"):format(selectedCount()) or "Совместить 3 одинаковых"
        end
    end
    function refs.Inspect(id,isEgg)
        transition+=1
        selected={Id=id,Egg=isEgg}; refs.CraftId=nil; selectedCopies={}
        local old=inspector:FindFirstChild("Picture") or detailBody:FindFirstChild("Picture"); if old then old:Destroy() end
        refs.DetailView=Catalog.View(inspector,id,isEgg,true)
        detail(); layout(true); oddsMode()
    end
    function refs.ShowOdds(id)
        local egg=C.Eggs[id]
        if not egg or (state.Zone or 1)&lt;egg.Zone or (state.Level or 0)&lt;egg.MinLevel then return false end
        refs.Inspect(id,true); selected.Odds=true
        for _,obj in oddsList:GetChildren() do if obj:IsA("Frame") then obj:Destroy() end end
        local index=0; local total=0
        for _,weight in egg.Weights do total+=weight end
        for _,petId in C.PetOrder do
            local weight=egg.Weights[petId] or 0
            if weight&gt;0 then
                index+=1
                local row=Instance.new("Frame"); row.Name=petId; row.Size=UDim2.new(1,-6,0,90); row.LayoutOrder=index; row.Parent=oddsList; Glass.Style(row,rarityColor(C.PetTypes[petId]),10)
                local view=Catalog.View(row,petId,false,false); view.Position=UDim2.fromOffset(0,4); view.Size=UDim2.new(.38,0,0,78)
                local name=text(row,UDim2.new(.38,2,0,7),UDim2.new(.62,-8,0,42),Headings.Item(petId),12,rarityColor(C.PetTypes[petId]))
                text(row,UDim2.new(.38,2,0,51),UDim2.new(.62,-8,0,28),string.format("%.2f%% · x%.2f",weight/total*100,1+C.PetTypes[petId].Bonus),13)
            end
        end
        oddsList.CanvasPosition=Vector2.zero; title.Text="Шансы выпадения"; oddsMode(); return true
    end
    oddsReturn.Activated:Connect(function() if selected then refs.Inspect(selected.Id,true) end end)
    function refs.BeginCraft(id)
        local info=C.PetTypes[id]
        if not info or info.Upgraded or ((state.Pets or {})[id] or 0)&lt;3 then return false end
        if not selected or selected.Id~=id or selected.Egg then refs.Inspect(id,false) end
        refs.CraftId=id; selectedCopies={}; layout(false); refresh(); return true
    end
    function refs.ChooseCopy(id,index)
        if id~=refs.CraftId or not C.PetTypes[id] or C.PetTypes[id].Upgraded or type(index)~="number" or index%1~=0 or index&lt;1 or index&gt;((state.Pets or {})[id] or 0) then return false end
        local key=id..":"..index
        if selectedCopies[key] then selectedCopies[key]=nil elseif selectedCount()&lt;3 then selectedCopies[key]=true else return false end
        refresh(); return true
    end
    back.Activated:Connect(refs.Return)
    primary.Activated:Connect(function()
        if not selected or not primary.Active then return end
        if selected.Egg then emit("Hatch",selected.Id)
        else emit(((state.EquippedPets or {})[selected.Id] or 0)&gt;0 and "PetUnequip" or "PetEquip",selected.Id) end
    end)
    combine.Activated:Connect(function()
        if not selected or not combine.Active then return end
        if selected.Egg then refs.ShowOdds(selected.Id); return end
        if refs.CraftId then craft()
        else refs.BeginCraft(selected.Id) end
    end)
    refs.EquipBest.Activated:Connect(function()
        if refs.CraftId then craft()
        else emit("PetEquipBest") end
    end)
    for index,id in C.EggOrder do
        local info=C.Eggs[id]; local f=card(refs.EggList,index)
        local view=Catalog.View(f,id,true); view.Position=UDim2.fromOffset(6,4); view.Size=UDim2.new(1,-12,0,52)
        text(f,UDim2.fromOffset(6,57),UDim2.new(1,-12,0,30),Headings.Item(id),13,Glass.Colors.Mint)
        local rarity=text(f,UDim2.fromOffset(6,89),UDim2.new(1,-12,0,18),"Зона "..info.Zone.." · "..(info.Category==1 and "Обычное" or "Редкое"),11,rarityColor(info))
        local locked=text(f,UDim2.fromOffset(6,109),UDim2.new(1,-12,0,24),number(info.Cost).." монет",12)
        local open=button(f,UDim2.new(.5,0,0,132),UDim2.new(1,-16,0,30),"Открыть")
        local chance=button(f,UDim2.new(.5,0,0,166),UDim2.new(1,-16,0,30),"Шансы выпадения")
        chance.Activated:Connect(function() if chance.Active then refs.ShowOdds(id) end end)
        local edit=button(f,UDim2.new(.5,0,0,198),UDim2.new(1,-16,0,32),"Редактировать")
        open.Activated:Connect(function() if open.Active then emit("Hatch",id) end end)
        edit.Activated:Connect(function() refs.Inspect(id,true) end)
        refs.EggButtons[id]=open; refs.EggCards[id]={Button=open,Locked=locked,Rarity=rarity,Chance=chance}; refs.EditButtons[id]=edit
    end
    local signature
    refresh=function()
        local owned,equipped,totalEq=state.Pets or {},state.EquippedPets or {},0
        local total=0; for _,amount in pairs(owned) do total+=amount end; for _,amount in pairs(equipped) do totalEq+=amount end
        refs.PetSummary.Text=("Получено %s/%s · экипировано %s/3 · x%.2f"):format(number(total),number(C.MaxPets),number(totalEq),state.PetMultiplier or 1)
        refs.EquipBest.Text=refs.CraftId and ("Совместить · выбрано %d/3"):format(selectedCount()) or "Экипировать лучшее"
        for id,item in pairs(refs.EggCards) do
            local unlocked=(state.Level or 0)&gt;=C.Eggs[id].MinLevel and (state.Zone or 1)&gt;=C.Eggs[id].Zone
            item.Button.Active=unlocked; item.Chance.Active=unlocked; item.Button.Text=unlocked and "Открыть · "..number(C.Eggs[id].Cost).." монет" or "Недоступно"
            item.Locked.Text=""
        end
        -- Rebuild only when counts/equipment/craft selections change; preserve scroll on state ticks.
        local parts={refs.CraftId or ""}
        for _,id in C.InventoryOrder do parts[#parts+1]=id..":"..(owned[id] or 0)..":"..(equipped[id] or 0) end
        for key in pairs(selectedCopies) do parts[#parts+1]=key end; table.sort(parts)
        local nextSignature=table.concat(parts,"|")
        if nextSignature~=signature then
            signature=nextSignature
            for _,child in refs.PetList:GetChildren() do if child:IsA("Frame") then child:Destroy() end end
            refs.PetCards={}; refs.PetButtons={}; refs.PetRemoveButtons={}
            local index=0
            for _,id in C.InventoryOrder do
                local info=C.PetTypes[id]; local count=owned[id] or 0
                if not info.Upgraded or count&gt;0 then
                    for copy=1,math.max(1,count) do
                        index+=1; local key=id..":"..copy; local f=card(refs.PetList,index)
                        f:SetAttribute("PetId",id); f:SetAttribute("Copy",copy)
                        local view=Catalog.View(f,id,false); view.Position=UDim2.fromOffset(6,4); view.Size=UDim2.new(1,-12,0,52)
                        text(f,UDim2.fromOffset(6,57),UDim2.new(1,-12,0,30),Headings.Item(id),13,Glass.Colors.Mint)
                        local rarityLabel=text(f,UDim2.fromOffset(6,89),UDim2.new(1,-12,0,16),rarity(info,false),11,rarityColor(info)); rarityLabel.Name="Rarity"
                        text(f,UDim2.fromOffset(6,106),UDim2.new(1,-12,0,18),("x%.2f"):format(1+info.Bonus),13)
                        local eq=copy&lt;=(equipped[id] or 0)
                        text(f,UDim2.fromOffset(6,126),UDim2.new(1,-12,0,16),count==0 and "Не получен" or eq and "Экипирован" or "В инвентаре",10,Glass.Colors.Muted)
                        local allowed=not refs.CraftId or (id==refs.CraftId and not info.Upgraded and copy&lt;=count)
                        local equip=button(f,UDim2.new(.5,0,0,159),UDim2.new(1,-16,0,36),refs.CraftId and (selectedCopies[key] and "Выбран ✓" or "Выбрать") or eq and "Снять" or "Экипировать")
                        equip.Active=count&gt;0 and allowed
                        local edit=button(f,UDim2.new(.5,0,0,198),UDim2.new(1,-16,0,32),"Редактировать"); edit.Active=refs.CraftId==nil
                        equip.Activated:Connect(function()
                            if not equip.Active then return end
                            if refs.CraftId then
                                refs.ChooseCopy(id,copy)
                            else emit(eq and "PetUnequip" or "PetEquip",id) end
                        end)
                        edit.Activated:Connect(function() if edit.Active then refs.Inspect(id,false) end end)
                        if not allowed then
                            local cover=Instance.new("Frame"); cover.Name="CraftUnavailable"; cover.Size=UDim2.fromScale(1,1)
                            cover.BackgroundColor3=Color3.new(0,0,0); cover.BackgroundTransparency=.35; cover.ZIndex=5; cover.Parent=f
                            local corner=Instance.new("UICorner"); corner.CornerRadius=UDim.new(0,12); corner.Parent=cover
                        end
                        refs.PetCards[key]=f; refs.PetButtons[key]=equip; refs.EditButtons[key]=edit
                    end
                end
            end
        end
        detail(); oddsMode()
    end
    function refs.Update(snapshot)
        state=snapshot
        if refs.CraftId and ((state.Pets or {})[refs.CraftId] or 0)&lt;3 then refs.CraftId=nil; selectedCopies={} end
        refresh()
    end
    function refs.SetCallbacks(newCallbacks) callbacks=newCallbacks end
    function refs.UpdateEggs(level) state.Level=level; refresh() end
    refs.Select("Eggs"); refresh(); refs.Resize(width)
    return refs
end
return Catalog
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX2f61bb6e19484eee8138a0b43ae47cbc">
          <Properties>
            <string name="Name">Presentation</string>
            <ProtectedString name="Source">local Tween=game:GetService("TweenService")
local Run=game:GetService("RunService")
local Catalog=require(script.Parent.PetCatalog)
local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local Glass=require(script.Parent.Glass)
local Headings=require(script.Parent.Headings)
local TextStyle=require(game.ReplicatedStorage.SimulatorShared.TextStyle)
local Presentation={}
function Presentation.Build(parent)
    local api={Busy=false}
    local overlay=Instance.new("Frame"); overlay.Name="ResultAnimation"; overlay.Size=UDim2.fromScale(1,1)
    overlay.BackgroundColor3=Glass.Colors.Base; overlay.BackgroundTransparency=.15; overlay.Visible=false
    overlay.ZIndex=80; overlay.Active=true; overlay.Parent=parent
    local title=Instance.new("TextLabel"); title.Size=UDim2.new(1,-32,0,60); title.Position=UDim2.new(0,16,.15,0)
    title.TextColor3=Glass.Colors.Gold; title.TextSize=24; title.Font=Enum.Font.GothamBold; title.TextWrapped=true
    title.BackgroundTransparency=1; title.Parent=overlay; TextStyle.Apply(title); Headings.Style(title,Glass.Colors.Gold)
    local caption=title:Clone(); caption.Position=UDim2.new(0,16,.78,0); caption.TextSize=19; caption.Parent=overlay
    local hero=Instance.new("TextLabel"); hero.Name="RebirthMultiplier"; hero.AnchorPoint=Vector2.new(.5,.5)
    hero.Size=UDim2.fromScale(.75,.25); hero.Position=UDim2.fromScale(.5,.5); hero.BackgroundTransparency=1
    hero.Font=Enum.Font.GothamBlack; hero.TextScaled=true; hero.TextColor3=Glass.Colors.Violet; hero.Visible=false; hero.Parent=overlay; TextStyle.Apply(hero)
    local heroLimit=Instance.new("UITextSizeConstraint"); heroLimit.MinTextSize=18; heroLimit.MaxTextSize=120; heroLimit.Parent=hero
    local heroScale=Instance.new("UIScale"); heroScale.Name="ZoomScale"; heroScale.Parent=hero
    local function clear() local old=overlay:FindFirstChild("Picture"); if old then old:Destroy() end end
    function api.Play(result,onDone)
        if api.Busy then return false end
        api.Busy=true; overlay.Visible=true; clear()
        local action,id=result.Action,result.Id
        local duration=action=="Rebirth" and 2 or 4
        title.Text=Headings.Text(action=="Hatch" and "HatchOpening" or action=="PetCraft" and "Crafting" or "Rebirth")
        caption.Text=""
        if action=="Rebirth" then
            title.Visible=false; caption.Visible=false; overlay.BackgroundTransparency=1
            hero.Visible=true; hero.Text=("x%.2f"):format(result.PreviousMultiplier or 1)
            hero.TextColor3=Glass.Colors.Violet; hero.TextTransparency=1
            hero.Position=UDim2.new(.5,0,.5,30); heroScale.Scale=.2
            local blur=Instance.new("BlurEffect"); blur.Name="SimulatorRebirthBlur"; blur.Size=0; blur.Parent=game:GetService("Lighting")
            task.spawn(function()
                api.Phase="Approach"
                Tween:Create(heroScale,TweenInfo.new(.25,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Scale=1}):Play()
                Tween:Create(hero,TweenInfo.new(.25),{TextTransparency=0,Position=UDim2.fromScale(.5,.5)}):Play()
                Tween:Create(blur,TweenInfo.new(.25),{Size=20}):Play(); task.wait(.25)
                api.Phase="Old"; task.wait(.2)
                if not overlay.Parent then blur:Destroy(); return end
                api.Phase="Change"
                local old=hero:Clone(); old.Name="PreviousMultiplier"; old.Parent=overlay
                hero.Text=("x%.2f"):format(result.Multiplier or 1); hero.TextColor3=Glass.Colors.Gold; hero.TextTransparency=1
                Tween:Create(old,TweenInfo.new(.1),{TextTransparency=1}):Play()
                Tween:Create(hero,TweenInfo.new(.1),{TextTransparency=0,TextColor3=Glass.Colors.Violet}):Play()
                task.wait(.1); old:Destroy()
                api.Phase="New"; task.wait(1.15)
                api.Phase="Exit"
                Tween:Create(heroScale,TweenInfo.new(.3,Enum.EasingStyle.Quart,Enum.EasingDirection.In),{Scale=.2}):Play()
                Tween:Create(hero,TweenInfo.new(.3),{TextTransparency=1,Position=UDim2.new(.5,0,.5,-30)}):Play()
                Tween:Create(blur,TweenInfo.new(.3),{Size=0}):Play(); task.wait(.3)
                blur:Destroy(); hero.Visible=false; overlay.Visible=false; title.Visible=true; caption.Visible=true
                overlay.BackgroundTransparency=.15; api.Busy=false; api.Phase="Done"
                if onDone then onDone() end
            end)
            return true
        end
        local view,model
        local models={}
        if action~="Rebirth" then
            view,model=Catalog.View(overlay,action=="Hatch" and result.Source or result.Source,action=="Hatch",false)
            view.Position=UDim2.fromScale(.2,.26); view.Size=UDim2.fromScale(.6,.48)
            if action=="PetCraft" then
                for i=1,3 do
                    local m=i==1 and model or model:Clone(); m.Parent=model.Parent; models[i]=m
                end
                view.CurrentCamera.CFrame=CFrame.lookAt(Vector3.new(0,2,-11),Vector3.new(0,.2,0))
            end
        end
        task.spawn(function()
            local start=os.clock(); local revealed=false
            while overlay.Parent and os.clock()-start&lt;duration do
                local elapsed=os.clock()-start
                if action=="Rebirth" then
                    title.Rotation=math.sin(elapsed*5)*5
                    title.Text=("Перерождение\n✦  x%.2f  ✦"):format(result.Multiplier or 1)
                    overlay.BackgroundTransparency=.15+math.sin(elapsed*3)^2*.35
                elseif elapsed&lt;2.8 then
                    if action=="PetCraft" then
                        local spread=2.6*(1-elapsed/3)
                        for i,m in models do m:PivotTo(CFrame.new((i-2)*spread,math.sin(elapsed*4+i)*.1,0)*CFrame.Angles(0,elapsed*2,0)) end
                    else model:PivotTo(CFrame.Angles(0,math.sin(elapsed*12)*elapsed*.12,math.sin(elapsed*15)*elapsed*.04)) end
                elseif not revealed then
                    revealed=true; clear()
                    view,model=Catalog.View(overlay,id,false,false)
                    view.Position=UDim2.fromScale(.2,.26); view.Size=UDim2.fromScale(.6,.48)
                    local info=C.PetTypes[id]
                    title.Text=Headings.Text(action=="Hatch" and "Hatched" or "Crafted")
                    caption.Text=("%s\n%s · x%.2f"):format(info.Name,info.Rarity,1+info.Bonus)
                    local scale=Instance.new("UIScale"); scale.Scale=.65; scale.Parent=view
                    view.AnchorPoint=Vector2.new(.5,.5); view.Position=UDim2.fromScale(.5,.5)
                    Tween:Create(scale,TweenInfo.new(.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play()
                else model:PivotTo(CFrame.Angles(0,(elapsed-2.8)*.5,0)) end
                Run.RenderStepped:Wait()
            end
            clear(); title.Rotation=0; overlay.Visible=false; api.Busy=false
            if onDone then onDone() end
        end)
        return true
    end
    api.Overlay=overlay
    return api
end
return Presentation
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX4bbe7aa1dab3442394ad982517ad8e93">
          <Properties>
            <string name="Name">Controller</string>
            <ProtectedString name="Source">local Players=game:GetService("Players")
local player=Players.LocalPlayer
local C=require(game.ReplicatedStorage:WaitForChild("SimulatorShared"):WaitForChild("Config"))
local UI=require(script.Parent.UI)
local number=require(game.ReplicatedStorage.SimulatorShared.NumberFormat).Compact
local refs=UI.Build(player)
-- The edge HUD renders the training hint; keep the prompt's E/gamepad input without duplicate default UI.
local function styleTrainingPrompt(obj)
    if obj:IsA("ProximityPrompt") and (obj.Name=="TrainPrompt" or obj.Name=="EggPrompt") then obj.Style=Enum.ProximityPromptStyle.Custom end
end
workspace.DescendantAdded:Connect(styleTrainingPrompt)
for _,obj in workspace:GetDescendants() do styleTrainingPrompt(obj) end
local remotes=game.ReplicatedStorage:WaitForChild("SimulatorRemotes")
local action=remotes:WaitForChild("Action")
local state,rebirthToken,serverOffset
local stationFactor=1
local function renderMultipliers()
    if not state then return end
    local power,coins=C.TrainingMultipliers(state,stationFactor)
    refs.PowerMultiplier.Text=("Прыжок  x%.2f"):format(power)
    refs.CoinMultiplier.Text=("Монеты  x%.2f"):format(coins)
end
local noticeVersion=0
local function showNotice(message)
    noticeVersion+=1
    local version=noticeVersion
    refs.Notice.Text=message; refs.Notice.Visible=not refs.Animation.Busy
    task.delay(4,function() if noticeVersion==version then refs.Notice.Visible=false end end)
end
local function request(name,...)
    -- This only improves UX. Every limit/condition is rechecked on the server.
    if state and not refs.Animation.Busy then action:FireServer(name,...) end
end
local function cooldownText(last,seconds,title,now)
    if state.TotalTrainings&lt;C.RewardMinTrainings then return title.." • 3 тренировки" end
    local remaining=last==0 and 0 or math.max(0,last+seconds-now)
    if remaining==0 then return title.." • забрать" end
    local hours=math.floor(remaining/3600); local minutes=math.floor(remaining%3600/60)
    return ("%s • %sч %sм"):format(title,number(hours),number(minutes))
end
local function render()
    if not state then return end
    renderMultipliers()
    refs.Power.Text=number(state.JumpHeight).." studs"
    refs.Coins.Text=number(state.Coins)
    refs.Catalog.Update(state)
    refs.Level.Text="Зона "..number(state.Zone).." · Опыт "..number(state.PracticeXP)
    refs.RebirthStats.Text=("%s • x%.2f"):format(number(state.Rebirths),state.Multiplier)
    refs.Bonus.Text=("Постоянный бонус: x%.2f  •  Рекорд: %s"):format(state.Multiplier,number(state.LifetimePower))
    local batch=refs.BatchAmount=="MAX" and math.max(1,state.MaxRebirths) or refs.BatchAmount
    local needPower,needCoins,needXP=C.BatchRequirements(state.Rebirths,batch)
    needPower,needCoins,needXP=needPower or math.huge,needCoins or math.huge,needXP or math.huge
    refs.Prepare.Text="Переродиться · "..batch
    refs.Goal.Text=("Запас прыжка: %s / %s\nМонеты: %s / %s\nОпыт: %s / %s"):format(number(state.Power),number(needPower),number(state.Coins),number(needCoins),number(state.AvailablePractice),number(needXP))
    refs.Progress(math.min(1,state.Power/needPower,state.Coins/needCoins,state.AvailablePractice/needXP))
    refs.Upgrade.Text=state.UpgradeCost&gt;0 and ("Улучшение: "..number(state.UpgradeCost).." монет") or "Уровень тренировки: максимум"
    local now=os.time()+(serverOffset or 0)
    local rewardsReady=state.TotalTrainings&gt;=C.RewardMinTrainings
    local dailyReady=rewardsReady and (state.LastDaily==0 or now&gt;=state.LastDaily+C.DailySeconds)
    local weeklyReady=rewardsReady and (state.LastWeekly==0 or now&gt;=state.LastWeekly+C.WeeklySeconds)
    local rebirthReady=state.MaxRebirths&gt;0
    refs.Notifications((dailyReady and 1 or 0)+(weeklyReady and 1 or 0),rebirthReady and state.MaxRebirths or 0)
    refs.Daily.Text=cooldownText(state.LastDaily,C.DailySeconds,"Ежедневная",now)
    refs.Weekly.Text=cooldownText(state.LastWeekly,C.WeeklySeconds,"Недельная",now)
    refs.Cosmetic.Text=state.NeonTrail and ("Неоновый след • "..(state.Equipped=="NeonTrail" and "выключить" or "включить"))
        or state.BronzeAura and ("Бронзовая аура • "..(state.Equipped=="BronzeAura" and "выключить" or "включить"))
        or "Косметика: аура за 1, след за 10 Rebirth"
    if state.TotalTrainings==0 then refs.Hint.Text=game:GetService("UserInputService").TouchEnabled and "Подойди к площадке прыжков и нажми «Тренироваться»." or "Прыгай или тренируйся у площадки по E."
    elseif state.Level==0 then refs.Hint.Text="Открой магазин: первое улучшение стоит 25 монет."
    else refs.Hint.Text="" end
    refs.Hint.Visible=refs.Hint.Text~="" and not refs.Animation.Busy and refs.ShouldShow("Hint")
end
remotes.State.OnClientEvent:Connect(function(snapshot)
    state=snapshot; serverOffset=snapshot.ServerTime-os.time(); render()
end)
remotes.Notice.OnClientEvent:Connect(function(message,extra)
    showNotice(message)
    if extra and extra.OpenPets then
        refs.Open("Pets"); refs.Catalog.Select("Eggs")
        if extra.EggId then refs.Catalog.Inspect(extra.EggId,true) end
    end
    if extra and extra.Result then
        if extra.Result.Action=="Rebirth" then refs.Close() end
        refs.PlayResult(extra.Result,function()
            if extra.Result.Action=="PetCraft" and refs.ActiveMenu=="Pets" then refs.Catalog.Inspect(extra.Result.Id,false) end
            render()
        end)
    end
    if extra and extra.RebirthToken then
        rebirthToken=extra.RebirthToken
        refs.Dialog.Text=message..("\n\nНовый постоянный бонус: x%.2f\nПодтверждение действует 20 секунд."):format(extra.NextMultiplier)
        refs.Open("Confirm")
    end
end)
local nearestAction,nearestId
refs.Train.Activated:Connect(function()
    if not nearestId then showNotice("Подойди к платформе или яйцу."); return end
    if nearestAction=="Egg" then request("PetMenu") else request("Train",nearestId) end
end)
refs.Upgrade.Activated:Connect(function() request("Upgrade") end)
refs.Catalog.SetCallbacks({Action=function(name,id,copies)
    if copies then request(name,id,copies) elseif id then request(name,id) else request(name) end
end})
for amount,b in refs.BatchButtons do
    b.Activated:Connect(function() refs.BatchAmount=amount; render() end)
end
refs.Prepare.Activated:Connect(function()
    if state then request("PrepareRebirth",refs.BatchAmount=="MAX" and math.max(1,state.MaxRebirths) or refs.BatchAmount) end
end)
refs.Daily.Activated:Connect(function() request("Daily") end)
refs.Weekly.Activated:Connect(function() request("Weekly") end)
refs.Cosmetic.Activated:Connect(function()
    if not state then return end
    local item=state.NeonTrail and "NeonTrail" or state.BronzeAura and "BronzeAura" or nil
    if item then request("Equip",state.Equipped==item and "" or item) end
end)
refs.Cancel.Activated:Connect(function() rebirthToken=nil; refs.Close() end)
refs.Confirm.Activated:Connect(function()
    local token=rebirthToken; rebirthToken=nil; refs.Close()
    if token then request("Rebirth",token) end
end)
-- Single nearest interaction and mutually exclusive reach volumes, shared with server checks.
task.spawn(function()
    while refs.Gui.Parent do
        local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        nearestAction,nearestId=nil,nil
        local selectedFactor,nearest=1,math.huge
        if root and state then
            for id,station in pairs(C.Stations) do
                local distance=(root.Position-station.Position).Magnitude
                if distance&lt;=C.TrainDistance and distance&lt;nearest then
                    nearest=distance; nearestAction="Train"; nearestId=id
                    selectedFactor=state.Level&gt;=station.MinLevel and station.Multiplier or 1
                end
            end
            for id,egg in pairs(C.Eggs) do
                local distance=(root.Position-egg.Position).Magnitude
                if distance&lt;=C.EggDistance and distance&lt;nearest then
                    nearest=distance; nearestAction="Egg"; nearestId=id; selectedFactor=1
                end
            end
        end
        local available=refs.ActiveMenu==nil and not refs.Animation.Busy
        refs.Train.Visible=nearestId~=nil and not refs.Animation.Busy and refs.ShouldShow("Train")
        refs.InteractCaption.Text=(nearestAction=="Egg" and "Открыть яйцо" or "Тренироваться")..(game:GetService("UserInputService").TouchEnabled and "" or " · E")
        for _,obj in workspace:GetDescendants() do
            if obj:IsA("ProximityPrompt") and (obj.Name=="TrainPrompt" or obj.Name=="EggPrompt") then obj.Enabled=available end
        end
        stationFactor=selectedFactor; renderMultipliers()
        task.wait(.2)
    end
end)

task.spawn(function()
    -- Initial State may arrive before the client listener. Retry only synchronization.
    while not state do action:FireServer("Sync"); task.wait(2) end
    while refs.Gui.Parent do task.wait(1); render() end
end)

local function jumping(character)
    local human=character:WaitForChild("Humanoid")
    human.Jumping:Connect(function(active)
        if active then task.defer(function()
            if character==player.Character then request("Jump") end
        end) end
    end)
end
player.CharacterAdded:Connect(jumping)
if player.Character then task.spawn(jumping,player.Character) end

-- Explicit state transition also supports very short starter jumps and mobile JumpRequest.
local function startJump()
    local human=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if human and human.Health&gt;0 and human.FloorMaterial~=Enum.Material.Air and human:GetState()~=Enum.HumanoidStateType.Jumping then
        human:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end
local jumpInput=game:GetService("UserInputService")
jumpInput.JumpRequest:Connect(startJump)
jumpInput.InputBegan:Connect(function(input,processed)
    if not processed and input.KeyCode==Enum.KeyCode.Space then startJump() end
end)
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX0b1ecffff8924a6d88ec781c4e1f9cb4">
          <Properties>
            <string name="Name">WorldSigns</string>
            <ProtectedString name="Source">local Players=game:GetService("Players")
local TweenService=game:GetService("TweenService")
local C=require(game.ReplicatedStorage:WaitForChild("SimulatorShared"):WaitForChild("Config"))
local player=Players.LocalPlayer
local entries={}
local current
local tweenInfo=TweenInfo.new(C.SignFadeSeconds,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)

local function register(gui)
    if not gui:IsA("BillboardGui") or gui.Name~="SimulatorSign" or entries[gui] then return end
    local text=gui:WaitForChild("SignText",5)
    local scale=text and text:WaitForChild("RevealScale",5)
    if not text or not scale or not gui:IsDescendantOf(workspace) then return end
    gui.Enabled=false; text.TextTransparency=1; text.TextStrokeTransparency=1; text.BackgroundTransparency=1
    scale.Scale=0.94
    entries[gui]={gui=gui,text=text,scale=scale,shown=false,generation=0}
end
local function reveal(entry,show)
    if entry.shown==show then return end
    entry.shown=show; entry.generation+=1
    local generation=entry.generation
    if entry.fade then entry.fade:Cancel() end
    if entry.grow then entry.grow:Cancel() end
    if show then entry.gui.Enabled=true end
    entry.fade=TweenService:Create(entry.text,tweenInfo,{
        TextTransparency=show and 0 or 1,
        TextStrokeTransparency=show and 0.15 or 1,
        BackgroundTransparency=show and 0.1 or 1,
    })
    entry.grow=TweenService:Create(entry.scale,tweenInfo,{Scale=show and 1 or 0.94})
    if not show then
        entry.fade.Completed:Once(function(state)
            if state==Enum.PlaybackState.Completed and entry.generation==generation and not entry.shown then
                entry.gui.Enabled=false
            end
        end)
    end
    entry.fade:Play(); entry.grow:Play()
end
workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("BillboardGui") and obj.Name=="SimulatorSign" then task.spawn(register,obj) end
end)
for _,obj in workspace:GetDescendants() do
    if obj:IsA("BillboardGui") and obj.Name=="SimulatorSign" then task.spawn(register,obj) end
end
while script.Parent do
    local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local nearest,nearestDistance=nil,C.SignRevealDistance
    local currentDistance=math.huge
    for gui,entry in pairs(entries) do
        local anchor=gui.Adornee or gui.Parent
        if not gui:IsDescendantOf(workspace) or not anchor:IsA("BasePart") then
            if entry.fade then entry.fade:Cancel() end
            if entry.grow then entry.grow:Cancel() end
            entries[gui]=nil; if current==entry then current=nil end
        elseif root then
            local distance=(root.Position-anchor.Position).Magnitude
            if entry==current then currentDistance=distance end
            if distance&lt;nearestDistance then nearest=entry; nearestDistance=distance end
        end
    end
    -- Show one nearby sign. A small hysteresis prevents rapid switching at the boundary.
    if current and currentDistance&lt;=C.SignRevealDistance+C.SignHideMargin
        and (not nearest or nearestDistance+C.SignHideMargin&gt;=currentDistance) then nearest=current end
    for _,entry in pairs(entries) do reveal(entry,entry==nearest) end
    current=nearest
    task.wait(0.1)
end
