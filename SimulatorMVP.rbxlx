  <Item class="ReplicatedStorage" referent="RBX6b67c71180c34dddb54437a62317fc5d">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="RBX0fea96bed5db45bebd9c17742e35ba5c">
      <Properties>
        <string name="Name">SimulatorShared</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX8b0448ea4ef04a67b8cee8a7d1e28638">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Balance lives here. No secrets and no client-supplied reward values.
local C = {
    StoreName = "StrengthSimulator_v1",
    StudioStoreName = "StrengthSimulator_STUDIO_v1",
    StudioOffline = true, -- Studio-only sandbox; production ALWAYS uses DataStore.
    AutoSaveSeconds = 45, LeaseSeconds = 180, Attempts = 4,
    MaxValue = 1000000000000, MaxLevel = 15, MaxRebirths = 10000,
    TrainCooldown = 0.8, BaseCoins = 8, BasePower = 5,
    UpgradeBase = 25, UpgradeGrowth = 1.6,
    CoinLevelBonus = 0.15, PowerLevelBonus = 0.20,
    RebirthBonus = 0.12, RebirthBonusCap = 25,
    RebirthPower = 200, RebirthCoins = 150,
    RebirthRequirementGrowth = 0.08, RequirementGrowthCap = 10,
    DailySeconds = 86400, WeeklySeconds = 604800,
    DailyTrainingEquivalent = 8, WeeklyTrainingEquivalent = 25,
    RewardMinTrainings = 3,
    RemoteBurst = 8, RemotePerSecond = 4,
    ActionCooldown = 0.3, TrainDistance = 11,
    SignRevealDistance = 18, SignHideMargin = 2,
    SignFadeSeconds = 0.25, SignWidth = 220, SignHeight = 70, SignTextSize = 16,
    MilestoneTrail = 10,
    AnalyticsEnabled = false, -- Enable after publishing and checking Dashboard.
    SupportRewardsEnabled = false, PaidItemsEnabled = false,
    MaxPets = 50, HatchCooldown = 1.2, EggDistance = 11,
    PetTypes = {
        Cat = {Name = "Кот", Bonus = 0.10, Color = {255, 182, 103}},
        Dog = {Name = "Пёс", Bonus = 0.20, Color = {111, 190, 255}},
        Bunny = {Name = "Кролик", Bonus = 0.35, Color = {211, 151, 255}},
    },
    PetOrder = {"Cat", "Dog", "Bunny"},
    EggOrder = {"Meadow", "Crystal"},
    Eggs = {
        Meadow = {Name = "Луговое яйцо", Cost = 80, Position = Vector3.new(-31, 0.8, -8),
            Color = {112, 228, 180}, Weights = {Cat = 60, Dog = 30, Bunny = 10}},
        Crystal = {Name = "Кристальное яйцо", Cost = 240, Position = Vector3.new(-31, 0.8, 3),
            Color = {180, 143, 255}, Weights = {Cat = 20, Dog = 45, Bunny = 35}},
    },
    Stations = {
        Basic = {Position = Vector3.new(-16, 1, 0), MinLevel = 0, Multiplier = 1},
        Advanced = {Position = Vector3.new(24, 1, 0), MinLevel = 3, Multiplier = 1.25},
    },
}
function C.Multiplier(data)
    return 1 + math.min(data.Rebirths, C.RebirthBonusCap) * C.RebirthBonus
end
function C.UpgradeCost(level)
    return math.floor(C.UpgradeBase * C.UpgradeGrowth ^ level)
end
function C.Requirements(rebirths)
    local factor = 1 + math.min(rebirths, C.RequirementGrowthCap) * C.RebirthRequirementGrowth
    return math.floor(C.RebirthPower * factor), math.floor(C.RebirthCoins * factor)
end
function C.TrainingMultipliers(data, stationMultiplier)
    local m = C.Multiplier(data) * (stationMultiplier or 1) * C.PetMultiplier(data)
    return (1 + data.Level * C.PowerLevelBonus) * m,
        (1 + data.Level * C.CoinLevelBonus) * m
end
function C.Gains(data, stationMultiplier)
    local power, coins = C.TrainingMultipliers(data, stationMultiplier)
    return math.floor(C.BasePower * power), math.floor(C.BaseCoins * coins)
end
function C.PetMultiplier(data)
    local pet = C.PetTypes[data.EquippedPet]
    return 1 + (pet and data.Pets and (data.Pets[data.EquippedPet] or 0) &gt; 0 and pet.Bonus or 0)
end
return table.freeze(C)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX738e8be7a403488f82c067bbd2a95246">
        <Properties>
          <string name="Name">TextStyle</string>
          <ProtectedString name="Source">-- Template rule: floating text must stay legible over bright platforms.
local TextStyle={}
function TextStyle.Apply(textObject)
    textObject.TextStrokeColor3=Color3.fromRGB(10,14,22)
    textObject.TextStrokeTransparency=0.15
    return textObject
end
return TextStyle
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX229d4bfd4cd5444a8cfd129eacb6c609">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX5e09f6120c084b26b1ed00ad3ff8ae7f">
      <Properties>
        <string name="Name">Simulator</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX2fa7a6b8b9aa406792ba8a750e163254">
        <Properties>
          <string name="Name">Schema</string>
          <ProtectedString name="Source">local C = require(game.ReplicatedStorage.SimulatorShared.Config)
local Schema = {}
function Schema.New()
    return {Version = 2, Coins = 0, Power = 0, Level = 0, Rebirths = 0,
        LifetimePower = 0, TotalTrainings = 0, LastDaily = 0, LastWeekly = 0,
        Cosmetics = {}, Equipped = "", Pets = {}, EquippedPet = ""}
end
function Schema.Copy(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for key, item in pairs(value) do result[key] = Schema.Copy(item) end
    return result
end
local function integer(value, maximum)
    return type(value) == "number" and value == value and value &gt;= 0
        and value &lt;= maximum and value % 1 == 0
end
-- Corrupt/unknown records fail closed. Defaults only come from a genuinely absent key.
function Schema.Validate(raw)
    if type(raw) ~= "table" or (raw.Version ~= 1 and raw.Version ~= 2) then return nil end
    local limits = {Coins=C.MaxValue, Power=C.MaxValue, Level=C.MaxLevel,
        Rebirths=C.MaxRebirths, LifetimePower=C.MaxValue, TotalTrainings=C.MaxValue,
        LastDaily=100000000000, LastWeekly=100000000000}
    for key, limit in pairs(limits) do if not integer(raw[key], limit) then return nil end end
    if type(raw.Cosmetics) ~= "table" or type(raw.Equipped) ~= "string" then return nil end
    for key, value in pairs(raw.Cosmetics) do
        if (key ~= "BronzeAura" and key ~= "NeonTrail") or value ~= true then return nil end
    end
    if raw.Equipped ~= "" and not raw.Cosmetics[raw.Equipped] then return nil end
    if raw.Version == 2 then
        if type(raw.Pets) ~= "table" or type(raw.EquippedPet) ~= "string" then return nil end
        local total = 0
        for id, count in pairs(raw.Pets) do
            if not C.PetTypes[id] or not integer(count, C.MaxPets) or count &lt; 1 then return nil end
            total += count
        end
        if total &gt; C.MaxPets then return nil end
        if raw.EquippedPet ~= "" and not raw.Pets[raw.EquippedPet] then return nil end
    end
    local clean = Schema.New()
    for key in pairs(clean) do
        if key ~= "Version" and (raw.Version == 2 or (key ~= "Pets" and key ~= "EquippedPet")) then
            clean[key] = Schema.Copy(raw[key])
        end
    end
    return clean
end
return Schema
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX42fc4ba2c1fd461eb7a78371547a51b3">
        <Properties>
          <string name="Name">PlayerData</string>
          <ProtectedString name="Source">local C = require(game.ReplicatedStorage.SimulatorShared.Config)
local Schema = require(script.Parent.Schema)
local HttpService = game:GetService("HttpService")
local PlayerData = {}
PlayerData.__index = PlayerData

-- Injectable backend/clock are used by tests, never accessible through remotes.
function PlayerData.new(store, options)
    options = options or {}
    return setmetatable({store=store, profiles={}, loading={}, closing=false,
        now=options.now or os.time, wait=options.wait or task.wait,
        offline=options.offline == true, token=options.token or HttpService:GenerateGUID(false)}, PlayerData)
end
function PlayerData:_request(key, transform)
    for attempt = 1, C.Attempts do
        local ok, result = pcall(function() return self.store:UpdateAsync(key, transform) end)
        if ok then return true, result end
        if attempt &lt; C.Attempts then self.wait(math.min(2 ^ (attempt-1), 4) + math.random()*0.2) end
    end
    return false, "unavailable"
end
local function validRecord(record)
    if type(record) ~= "table" or record.Schema ~= 1 or not Schema.Validate(record.Data) then return false end
    if type(record.Revision) ~= "number" or record.Revision % 1 ~= 0 or record.Revision &lt; 0 then return false end
    local lock = record.Session
    return lock == nil or (type(lock)=="table" and type(lock.Token)=="string"
        and type(lock.Until)=="number" and lock.Until == lock.Until and lock.Until &lt; math.huge)
end
function PlayerData:Load(userId)
    if self.closing or self.profiles[userId] or self.loading[userId] then return false, "busy" end
    self.loading[userId] = true
    if self.offline then
        self.profiles[userId] = {data=Schema.New(), lease=math.huge, status="ready", seq=0, savedSeq=0}
        self.loading[userId] = nil
        return true
    end
    local reason = "unavailable"
    local token = self.token .. ":" .. tostring(userId)
    local ok, record = self:_request("Player_"..userId, function(old)
        local now = self.now()
        if old ~= nil and not validRecord(old) then reason="corrupt"; return nil end
        if old and old.Session and old.Session.Token ~= token and old.Session.Until &gt; now then
            reason="locked"; return nil
        end
        local data = old and Schema.Validate(old.Data) or Schema.New()
        return {Schema=1, Data=data, Revision=old and old.Revision or 0,
            Session={Token=token, Until=now+C.LeaseSeconds}}, {userId}
    end)
    self.loading[userId] = nil
    if not ok or not record or not validRecord(record) or not record.Session or record.Session.Token~=token then
        return false, reason
    end
    self.profiles[userId] = {data=Schema.Validate(record.Data), lease=record.Session.Until,
        status="ready", seq=0, savedSeq=0, token=token, revision=record.Revision}
    return true
end
function PlayerData:Get(userId)
    local p = self.profiles[userId]
    if not p or p.status ~= "ready" or self.closing then return nil end
    -- Stop granting progress before a stale server can overwrite a new session.
    if p.lease &lt;= self.now()+10 then return nil end
    return p.data
end
function PlayerData:Changed(userId)
    local p = self.profiles[userId]
    if p then p.seq += 1 end
end
function PlayerData:Save(userId, release)
    local p = self.profiles[userId]
    if not p then return true end
    if release then p.status="closing" end
    -- One operation per key; exit waits for an autosave then writes the latest snapshot.
    while p.saving do self.wait(0.05) end
    if self.profiles[userId] ~= p then return true end
    p.saving = true
    local snapshot, seq = Schema.Copy(p.data), p.seq
    if not Schema.Validate(snapshot) then p.saving=false; return false, "corrupt" end
    if self.offline then
        p.savedSeq=seq; p.saving=false
        if release then self.profiles[userId]=nil end
        return true
    end
    local reason = "unavailable"
    local ok, result = self:_request("Player_"..userId, function(old)
        local now=self.now()
        if not validRecord(old) then reason="corrupt"; return nil end
        if not old.Session or old.Session.Token~=p.token or old.Session.Until &lt;= now then
            reason="lost_lock"; return nil
        end
        return {Schema=1, Data=snapshot, Revision=old.Revision+1,
            Session=not release and {Token=p.token, Until=now+C.LeaseSeconds} or nil}, {userId}
    end)
    p.saving=false
    if ok and result and validRecord(result) then
        p.savedSeq=seq; p.revision=result.Revision
        if release then self.profiles[userId]=nil else p.lease=result.Session.Until end
        return true
    end
    if reason=="lost_lock" or reason=="corrupt" then p.status="failed" end
    return false, reason
end
return PlayerData
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX63964230cd8c4719a71c2800f5b3c0d4">
        <Properties>
          <string name="Name">Progression</string>
          <ProtectedString name="Source">local C = require(game.ReplicatedStorage.SimulatorShared.Config)
local P = {}
function P.Train(data, stationId)
    local station = C.Stations[stationId]
    if not station or data.Level &lt; station.MinLevel then return false, "Станция откроется на уровне 3." end
    local power, coins = C.Gains(data, station.Multiplier)
    data.Power = math.min(C.MaxValue, data.Power+power)
    data.Coins = math.min(C.MaxValue, data.Coins+coins)
    data.LifetimePower = math.min(C.MaxValue, data.LifetimePower+power)
    data.TotalTrainings = math.min(C.MaxValue, data.TotalTrainings+1)
    return true, ("+%d силы, +%d монет"):format(power, coins)
end
function P.Upgrade(data)
    if data.Level &gt;= C.MaxLevel then return false, "Максимальный уровень тренировки." end
    local cost=C.UpgradeCost(data.Level)
    if data.Coins &lt; cost then return false, "Не хватает монет на улучшение." end
    data.Coins-=cost; data.Level+=1
    return true, "Тренировка усилена! Уровень "..data.Level
end
return P
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX656966fc444045c8bc71553a7f02e958">
        <Properties>
          <string name="Name">Rebirth</string>
          <ProtectedString name="Source">local C = require(game.ReplicatedStorage.SimulatorShared.Config)
local R = {}
function R.Apply(data)
    if data.Rebirths&gt;=C.MaxRebirths then return false, "Достигнут предел перерождений MVP." end
    local power, coins=C.Requirements(data.Rebirths)
    if data.Power&lt;power or data.Coins&lt;coins then return false, "Для перерождения нужны сила и монеты." end
    -- Lifetime score, reward timestamps and cosmetics deliberately survive the reset.
    data.Power=0; data.Coins=0; data.Level=0; data.Rebirths+=1
    return true, ("Перерождение! Постоянный бонус: x%.2f"):format(C.Multiplier(data))
end
return R
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXcfe5b96145c04a7db9af53b4804b7acd">
        <Properties>
          <string name="Name">Rewards</string>
          <ProtectedString name="Source">local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local Rewards={}
function Rewards.Reconcile(data)
    local changed=false
    if data.Rebirths&gt;=1 and not data.Cosmetics.BronzeAura then data.Cosmetics.BronzeAura=true; changed=true end
    if data.Rebirths&gt;=C.MilestoneTrail and not data.Cosmetics.NeonTrail then data.Cosmetics.NeonTrail=true; changed=true end
    if changed and data.Equipped=="" then data.Equipped=data.Cosmetics.NeonTrail and "NeonTrail" or "BronzeAura" end
    return changed
end
function Rewards.Claim(data, kind, now)
    local key, seconds, count
    if kind=="Daily" then key="LastDaily"; seconds=C.DailySeconds; count=C.DailyTrainingEquivalent
    elseif kind=="Weekly" then key="LastWeekly"; seconds=C.WeeklySeconds; count=C.WeeklyTrainingEquivalent
    else return false, "Неизвестная награда." end
    if data.TotalTrainings&lt;C.RewardMinTrainings then return false, "Сначала потренируйся 3 раза." end
    if data[key]~=0 and now &lt; data[key]+seconds then return false, "Награда ещё не готова." end
    local _, perTraining=C.Gains(data, 1)
    local reward=perTraining*count
    data[key]=now; data.Coins=math.min(C.MaxValue, data.Coins+reward)
    return true, ("Награда: +%d монет"):format(reward)
end
function Rewards.Equip(data, cosmetic)
    if cosmetic~="" and not data.Cosmetics[cosmetic] then return false, "Косметика ещё не открыта." end
    data.Equipped=cosmetic
    return true, cosmetic=="" and "Эффект выключен." or "Эффект включён."
end
function Rewards.ApplyCharacter(player, data)
    local char=player.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for _, child in root:GetChildren() do
        if child.Name:sub(1,10)=="Simulator_" then child:Destroy() end
    end
    if data.Equipped=="BronzeAura" and data.Cosmetics.BronzeAura then
        local light=Instance.new("PointLight"); light.Name="Simulator_Aura"
        light.Color=Color3.fromRGB(255,170,65); light.Range=10; light.Brightness=2; light.Parent=root
        local sparks=Instance.new("Sparkles"); sparks.Name="Simulator_Sparks"
        sparks.SparkleColor=light.Color; sparks.Parent=root
    elseif data.Equipped=="NeonTrail" and data.Cosmetics.NeonTrail then
        local a=Instance.new("Attachment"); a.Name="Simulator_TrailA"; a.Position=Vector3.new(-1,0,0); a.Parent=root
        local b=Instance.new("Attachment"); b.Name="Simulator_TrailB"; b.Position=Vector3.new(1,0,0); b.Parent=root
        local trail=Instance.new("Trail"); trail.Name="Simulator_Trail"
        trail.Attachment0=a; trail.Attachment1=b; trail.Lifetime=0.5
        trail.Color=ColorSequence.new(Color3.fromRGB(70,240,255),Color3.fromRGB(160,100,255)); trail.Parent=root
    end
end
return Rewards
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXcdb02bc630c140b09406d58f62272f53">
        <Properties>
          <string name="Name">Pets</string>
          <ProtectedString name="Source">local C = require(game.ReplicatedStorage.SimulatorShared.Config)
local Pets = {}
function Pets.Count(data)
    local count = 0
    for _, amount in pairs(data.Pets) do count += amount end
    return count
end
-- Randomness is chosen on the server. An injectable roll supports deterministic unit tests.
function Pets.Hatch(data, eggId, roll)
    local egg = C.Eggs[eggId]
    if not egg then return false, "Неизвестное яйцо." end
    if Pets.Count(data) &gt;= C.MaxPets then return false, "Инвентарь питомцев заполнен (50)." end
    if data.Coins &lt; egg.Cost then return false, "Не хватает монет на яйцо." end
    local value = roll and roll() or math.random()
    if type(value) ~= "number" or value ~= value or value &lt; 0 or value &gt;= 1 then
        return false, "Не удалось открыть яйцо. Монеты не списаны."
    end
    local total = 0
    for _, id in C.PetOrder do total += egg.Weights[id] end
    local threshold, selected = 0, nil
    for _, id in C.PetOrder do
        threshold += egg.Weights[id] / total
        if value &lt; threshold then selected = id; break end
    end
    selected = selected or C.PetOrder[#C.PetOrder]
    data.Coins -= egg.Cost
    data.Pets[selected] = (data.Pets[selected] or 0) + 1
    if data.EquippedPet == "" then data.EquippedPet = selected end
    return true, "Из яйца: " .. C.PetTypes[selected].Name .. "!", selected
end
function Pets.Equip(data, id)
    if id ~= "" and (not C.PetTypes[id] or not data.Pets[id]) then
        return false, "Этот питомец не получен."
    end
    data.EquippedPet = id
    return true, id == "" and "Питомец снят." or "Питомец экипирован: " .. C.PetTypes[id].Name
end
return Pets
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXe0db15d322074037a6583c9fd70a7943">
        <Properties>
          <string name="Name">PetVisuals</string>
          <ProtectedString name="Source">local C = require(game.ReplicatedStorage.SimulatorShared.Config)
local TextStyle = require(game.ReplicatedStorage.SimulatorShared.TextStyle)
local Visuals = {}
function Visuals.Apply(player, data)
    local character = player.Character
    if not character then return end
    local previous = character:FindFirstChild("SimulatorPet")
    if previous then previous:Destroy() end
    local root = character:FindFirstChild("HumanoidRootPart")
    local id = data.EquippedPet
    local info = C.PetTypes[id]
    if not root or not info or not data.Pets[id] then return end
    local model = Instance.new("Model"); model.Name = "SimulatorPet"; model.Parent = character
    local origin = root.CFrame * CFrame.new(3, -.6, 2)
    local function piece(name, size, offset, color)
        local p = Instance.new("Part"); p.Name = name; p.Size = size; p.Color = color
        p.Material = Enum.Material.SmoothPlastic; p.CanCollide = false; p.CanTouch = false
        p.CanQuery = false; p.Massless = true; p.CFrame = origin * CFrame.new(offset); p.Parent = model
        local weld = Instance.new("WeldConstraint"); weld.Part0 = root; weld.Part1 = p; weld.Parent = p
        return p
    end
    local color = Color3.fromRGB(table.unpack(info.Color))
    local body = piece("Body", Vector3.new(1.6, 1.5, 1.5), Vector3.zero, color)
    model.PrimaryPart = body
    for _, x in {-.48, .48} do
        piece("Ear", Vector3.new(.38, id == "Bunny" and 1.3 or .55, .45),
            Vector3.new(x, id == "Bunny" and 1.15 or .87, 0), color)
        piece("Eye", Vector3.new(.20, .25, .12), Vector3.new(x * .7, .18, -.78), Color3.fromRGB(22, 30, 48))
    end
    piece("Nose", Vector3.new(.22, .16, .14), Vector3.new(0, -.13, -.8), Color3.fromRGB(255, 125, 161))
    local tag = Instance.new("BillboardGui"); tag.Size = UDim2.fromOffset(140, 30)
    tag.StudsOffset = Vector3.new(0, 2.2, 0); tag.MaxDistance = 18; tag.Parent = body
    local text = Instance.new("TextLabel"); text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1; text.Font = Enum.Font.GothamBold; text.TextSize = 14
    text.TextColor3 = color; text.Text = info.Name; text.Parent = tag; TextStyle.Apply(text)
end
return Visuals
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX6eee74a006fc45a880ae6711c04635bc">
        <Properties>
          <string name="Name">Security</string>
          <ProtectedString name="Source">local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local S={}
function S.NewLimiter() return {tokens=C.RemoteBurst, at=os.clock(), actions={}} end
function S.Allow(limiter, action, now, cooldown)
    limiter.tokens=math.min(C.RemoteBurst, limiter.tokens+(now-limiter.at)*C.RemotePerSecond)
    limiter.at=now
    if limiter.tokens&lt;1 then return false end
    limiter.tokens-=1
    local last=limiter.actions[action]
    if last and now-last&lt;cooldown then return false end
    limiter.actions[action]=now
    return true
end
function S.Valid(action, args)
    if type(action)~="string" or #action&gt;16 then return false end
    if action=="Train" then return args.n==1 and type(args[1])=="string" and C.Stations[args[1]]~=nil end
    if action=="Equip" then return args.n==1 and (args[1]=="" or args[1]=="BronzeAura" or args[1]=="NeonTrail") end
    if action=="Hatch" then return args.n==1 and type(args[1])=="string" and C.Eggs[args[1]]~=nil end
    if action=="PetEquip" then return args.n==1 and type(args[1])=="string" and (args[1]=="" or C.PetTypes[args[1]]~=nil) end
    if action=="Rebirth" then return args.n==1 and type(args[1])=="string" and #args[1]&lt;=64 end
    return (action=="Sync" or action=="Upgrade" or action=="PrepareRebirth" or action=="Daily" or action=="Weekly" or action=="PetMenu") and args.n==0
end
function S.Near(player, part, radius)
    local char=player.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    local human=char and char:FindFirstChildOfClass("Humanoid")
    return root~=nil and human~=nil and human.Health&gt;0 and (root.Position-part.Position).Magnitude&lt;=radius
end
return S
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXc8ed415b886c472ca57beaba70c26021">
        <Properties>
          <string name="Name">LeaderboardTemplate</string>
          <ProtectedString name="Source">-- Visual draft only: each ranking row is a separate solid plaque, no live data.
local Board={}
-- Intended refresh interval for the future live leaderboard; this draft has no data fetch loop.
Board.RefreshIntervalSeconds=3600
local rgb=Color3.fromRGB
local function part(parent,name,size,pos,color,neon)
    local p=Instance.new("Part"); p.Name=name; p.Size=size; p.Position=pos; p.Anchored=true
    p.Material=neon and Enum.Material.Neon or Enum.Material.SmoothPlastic; p.Color=color
    p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    p.Parent=parent; return p
end
local function face(p,width,height)
    p.CFrame=CFrame.new(p.Position)*CFrame.Angles(0,math.pi,0)
    local g=Instance.new("SurfaceGui"); g.Name="Lettering"; g.Face=Enum.NormalId.Front
    g.SizingMode=Enum.SurfaceGuiSizingMode.FixedSize; g.CanvasSize=Vector2.new(width,height)
    g.LightInfluence=0; g.AlwaysOnTop=false; g.Parent=p; return g
end
local function text(g,name,value,x,y,w,h,size,color,align)
    local t=Instance.new("TextLabel"); t.Name=name; t.Text=value
    t.Position=UDim2.fromOffset(x,y); t.Size=UDim2.fromOffset(w,h)
    t.BackgroundTransparency=1; t.Font=Enum.Font.GothamBold; t.TextSize=size
    t.TextColor3=color; t.TextXAlignment=align or Enum.TextXAlignment.Left
    t.TextStrokeColor3=rgb(8,12,24); t.TextStrokeTransparency=0.15; t.Parent=g
    return t
end
function Board.Build(parent)
    if parent:FindFirstChild("LeaderboardTemplate") then return parent.LeaderboardTemplate end
    local m=Instance.new("Model"); m.Name="LeaderboardTemplate"; m.Parent=parent
    m:SetAttribute("RefreshIntervalSeconds",Board.RefreshIntervalSeconds)
    -- Ground -&gt; foundation -&gt; pedestal -&gt; feet -&gt; shafts -&gt; capitals -&gt; canopy.
    -- Adjacent pieces touch only at their hidden joints; exposed rear faces have different depths.
    part(m,"Foundation",Vector3.new(57,0.6,8),Vector3.new(4,0.3,-30),rgb(22,30,47))
    part(m,"Pedestal",Vector3.new(55,1.4,6),Vector3.new(4,1.3,-30),rgb(44,55,77))
    -- Full-height backing closes the gaps beside and above the title.
    part(m,"Backing",Vector3.new(51,31.2,2),Vector3.new(4,17.6,-32.2),rgb(15,23,39))
    for _,x in {-22,4,30} do
        part(m,"Pillar",Vector3.new(1.5,29.4,2.6),Vector3.new(x,17.7,-30.7),rgb(65,79,103))
        part(m,"PillarFoot",Vector3.new(2.6,1,3.6),Vector3.new(x,2.5,-30.7),rgb(98,117,147))
        part(m,"PillarCap",Vector3.new(2.6,0.8,3.6),Vector3.new(x,32.8,-30.7),rgb(98,117,147))
    end
    local title=part(m,"HallTitle",Vector3.new(48,4,2.4),Vector3.new(4,30.4,-30),rgb(31,43,66))
    text(face(title,1200,100),"Title","ЗАЛ СЛАВЫ",0,0,1200,100,74,rgb(255,220,125),Enum.TextXAlignment.Center)
    -- Rear edge -33.6, front edge -26.4: a visible forward overhang above the title.
    part(m,"CrownTrim",Vector3.new(58.6,0.6,7.2),Vector3.new(4,33.5,-30),rgb(255,205,96))
    part(m,"TopGlow",Vector3.new(48,0.18,0.2),Vector3.new(4,32.5,-28.65),rgb(255,213,111),true)
    local cols={{name="Players",x=-9,title="ТОП 10 ИГРОКОВ",prefix="Игрок",accent=rgb(86,221,255)},
        {name="Donors",x=17,title="ТОП 10 ДОНАТЕРОВ",prefix="Донатер",accent=rgb(196,147,255)}}
    local medals={rgb(255,205,96),rgb(201,223,245),rgb(234,161,111)}
    for _,c in ipairs(cols) do
        local col=Instance.new("Model"); col.Name=c.name; col.Parent=m
        local header=part(col,"Heading",Vector3.new(23,2.5,1.6),Vector3.new(c.x,26.7,-29.9),rgb(30,42,63))
        local hg=face(header,920,100)
        local heading=text(hg,"Title",c.title,20,4,880,92,74,c.accent,Enum.TextXAlignment.Center)
        heading.TextScaled=true
        for _,x in {c.x-11.7,c.x+11.7} do
            -- Solid saturated rails retain the theme color without white neon bloom.
            local railColor=c.name=="Donors" and rgb(156,76,235) or rgb(40,177,227)
            part(col,"LightRail",Vector3.new(0.14,23.5,0.2),Vector3.new(x,14,-29.15),railColor,false)
        end
        for rank=1,10 do
            local y=23.5-(rank-1)*2.1
            local tint=medals[rank] or c.accent
            -- Winners physically project further from the wall, with separate medal blocks.
            local z=rank&lt;=3 and -29.35 or -29.65
            local row=part(col,"Row"..rank,Vector3.new(22.6,1.85,rank&lt;=3 and 1.6 or 1),Vector3.new(c.x,y,z),rank&lt;=3 and rgb(48,59,79) or (rank%2==0 and rgb(31,44,65) or rgb(25,36,56)))
            local g=face(row,904,74)
            text(g,"PlayerName",string.format("%s_%02d",c.prefix,rank),125,0,610,74,43,rgb(244,248,255))
            text(g,"Value","—",750,0,130,74,46,tint,Enum.TextXAlignment.Right)
            local medal=part(col,"Rank"..rank,Vector3.new(1.8,1.45,0.35),Vector3.new(c.x-9.9,y,z+row.Size.Z/2+0.2),rank&lt;=3 and tint or rgb(57,76,103))
            text(face(medal,80,64),"Rank",tostring(rank),0,0,80,64,48,rank&lt;=3 and rgb(29,25,25) or rgb(232,242,255),Enum.TextXAlignment.Center)
            part(col,"RowAccent"..rank,Vector3.new(0.1,1.3,0.12),Vector3.new(c.x-8.7,y,z+row.Size.Z/2+0.08),tint,true)
        end
    end
    local notice=part(m,"RefreshNotice",Vector3.new(46,1.2,0.4),Vector3.new(4,3,-29),rgb(27,37,56))
    -- Match the 46:1.2 stud face aspect ratio so glyphs are not stretched horizontally.
    text(face(notice,1840,48),"Interval","Таблица обновляется раз в час",400,0,1040,48,32,rgb(210,220,241),Enum.TextXAlignment.Center)
    return m
end
return Board
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5126641cac8241c6846bc859b25b0442">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local TextStyle=require(game.ReplicatedStorage.SimulatorShared.TextStyle)
local LeaderboardTemplate=require(script.Parent.LeaderboardTemplate)
local World={}
local builtMap
local function part(parent,name,size,position,color)
    local p=Instance.new("Part"); p.Name=name; p.Size=size; p.Position=position
    p.Color=color; p.Material=Enum.Material.SmoothPlastic; p.Anchored=true; p.Parent=parent
    return p
end
local function sign(parent,name,position,text,color)
    local anchor=part(parent,name,Vector3.new(1,1,1),position,color)
    anchor.Transparency=1; anchor.CanCollide=false
    local gui=Instance.new("BillboardGui"); gui.Name="SimulatorSign"
    gui.Size=UDim2.fromOffset(C.SignWidth,C.SignHeight); gui.AlwaysOnTop=false
    -- Client handles player distance and fading; no hard camera-distance cut during the tween.
    gui.MaxDistance=0; gui.Enabled=false; gui.Parent=anchor
    local label=Instance.new("TextLabel"); label.Name="SignText"; label.Size=UDim2.fromScale(1,1)
    label.AnchorPoint=Vector2.new(0.5,0.5); label.Position=UDim2.fromScale(0.5,0.5)
    label.BackgroundColor3=Color3.fromRGB(22,30,50); label.BackgroundTransparency=1
    label.TextColor3=color; label.TextSize=C.SignTextSize; label.Font=Enum.Font.GothamBold
    label.TextWrapped=true; label.Text=text; label.Parent=gui
    TextStyle.Apply(label)
    label.TextTransparency=1; label.TextStrokeTransparency=1
    local scale=Instance.new("UIScale"); scale.Name="RevealScale"; scale.Scale=0.94; scale.Parent=label
    local corner=Instance.new("UICorner"); corner.Parent=label
end
function World.Build()
    if builtMap and builtMap.Parent then return builtMap end
    local existing=workspace:FindFirstChild("SimulatorWorld")
    -- Editor preview is recreated from this module at Play; balance/layout source stays authoritative.
    if existing then existing:Destroy() end
    local map=Instance.new("Folder"); map.Name="SimulatorWorld"; map.Parent=workspace
    part(map,"Ground",Vector3.new(100,2,80),Vector3.new(4,-1,0),Color3.fromRGB(30,40,62))
    part(map,"StartingPlaza",Vector3.new(32,0.2,26),Vector3.new(-12,0.1,0),Color3.fromRGB(47,72,88))
    part(map,"AdvancedPlaza",Vector3.new(28,0.2,26),Vector3.new(24,0.1,0),Color3.fromRGB(67,49,96))
    -- Join x=4..10 exactly: no overlap with either plaza, and a 0.05 stud step below them.
    part(map,"Path",Vector3.new(6,0.2,7),Vector3.new(7,0.05,0),Color3.fromRGB(100,109,134))
    local spawn=Instance.new("SpawnLocation"); spawn.Name="SimulatorSpawn"
    spawn.Size=Vector3.new(6,0.4,6); spawn.Position=Vector3.new(-16,0.4,12)
    spawn.Anchored=true; spawn.Neutral=true; spawn.Duration=0; spawn.Color=Color3.fromRGB(79,206,183); spawn.Parent=map
    for id, info in pairs(C.Stations) do
        local color=id=="Basic" and Color3.fromRGB(65,220,183) or Color3.fromRGB(160,116,255)
        local pad=part(map,id,Vector3.new(8,1,8),info.Position,color); pad.Material=Enum.Material.Neon
        local prompt=Instance.new("ProximityPrompt"); prompt.Name="TrainPrompt"
        prompt.ActionText="Тренироваться"; prompt.ObjectText=id=="Basic" and "Сила" or "Сила x1.25 • уровень 3"
        prompt.KeyboardKeyCode=Enum.KeyCode.E; prompt.HoldDuration=0; prompt.MaxActivationDistance=C.TrainDistance
        prompt.RequiresLineOfSight=false; prompt.Parent=pad
        sign(map,id.."Sign",info.Position+Vector3.new(0,6,-7),id=="Basic" and "ТРЕНИРОВКА СИЛЫ\nНажми E у платформы" or "ПРОДВИНУТАЯ ЗОНА\nУровень 3 • +25% за тренировку",color)
        -- Simple equipment built from primitives, no external models/scripts.
        local bar=part(map,id.."Bar",Vector3.new(6,0.3,0.3),info.Position+Vector3.new(0,2,-2),Color3.fromRGB(160,175,188))
        for _, x in {-2.5,2.5} do
            local weight=part(map,id.."Weight"..x,Vector3.new(0.8,2,2),bar.Position+Vector3.new(x,0,0),Color3.fromRGB(30,34,44))
            weight.Shape=Enum.PartType.Ball
        end
    end
    sign(map,"Welcome",Vector3.new(-34,7,14),"СИЛА → МОНЕТЫ → УЛУЧШЕНИЯ\nПерерождение даёт постоянный бонус",Color3.fromRGB(245,210,106))
    for _,id in C.EggOrder do
        local info=C.Eggs[id]; local color=Color3.fromRGB(table.unpack(info.Color))
        local stand=part(map,"Egg"..id,Vector3.new(5,1.6,5),info.Position,color)
        local egg=part(map,id.."Shell",Vector3.new(2.8,3.6,2.8),info.Position+Vector3.new(0,2.6,0),color)
        egg.Shape=Enum.PartType.Ball; egg.Material=Enum.Material.Glass
        local ring=part(map,id.."Band",Vector3.new(3,0.35,3),info.Position+Vector3.new(0,2.3,0),Color3.fromRGB(245,214,116))
        ring.CanCollide=false
        local prompt=Instance.new("ProximityPrompt"); prompt.Name="EggPrompt"
        prompt.ActionText="Яйца и питомцы"; prompt.ObjectText=info.Name.." • "..info.Cost.." монет"
        prompt.KeyboardKeyCode=Enum.KeyCode.F; prompt.MaxActivationDistance=C.EggDistance
        prompt.RequiresLineOfSight=false; prompt.Parent=stand
        sign(map,id.."EggSign",info.Position+Vector3.new(0,6,0),info.Name.."\n"..info.Cost.." монет • нажми F",color)
    end
    sign(map,"Milestone",Vector3.new(24,7,-13),"НАГРАДЫ ЗА ПРОГРЕСС\n1 Rebirth: аура • 10 Rebirth: неоновый след",Color3.fromRGB(120,223,255))
    for _, z in {-37,37} do
        part(map,"Border"..z,Vector3.new(94,3,1),Vector3.new(4,1.5,z),Color3.fromRGB(52,67,93))
    end
    for _, x in {-43,51} do
        part(map,"Border"..x,Vector3.new(1,3,74),Vector3.new(x,1.5,0),Color3.fromRGB(52,67,93))
    end
    LeaderboardTemplate.Build(map)
    builtMap=map
    return map
end
return World
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX322e217f0f764723b93cb768c7d567dd">
        <Properties>
          <string name="Name">Network</string>
          <ProtectedString name="Source">local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local Network={}
function Network.Create()
    local folder=Instance.new("Folder"); folder.Name="SimulatorRemotes"; folder.Parent=game.ReplicatedStorage
    local action=Instance.new("RemoteEvent"); action.Name="Action"; action.Parent=folder
    local state=Instance.new("RemoteEvent"); state.Name="State"; state.Parent=folder
    local notice=Instance.new("RemoteEvent"); notice.Name="Notice"; notice.Parent=folder
    return {Action=action,State=state,Notice=notice}
end
function Network.Snapshot(data, mode, saveStatus)
    local power,coins=C.Requirements(data.Rebirths)
    return {Coins=data.Coins, Power=data.Power, Level=data.Level, Rebirths=data.Rebirths,
        LifetimePower=data.LifetimePower, Multiplier=C.Multiplier(data),
        UpgradeCost=data.Level&lt;C.MaxLevel and C.UpgradeCost(data.Level) or 0,
        RequiredPower=power, RequiredCoins=coins, TotalTrainings=data.TotalTrainings,
        LastDaily=data.LastDaily, LastWeekly=data.LastWeekly, ServerTime=os.time(),
        BronzeAura=data.Cosmetics.BronzeAura==true, NeonTrail=data.Cosmetics.NeonTrail==true,
        Equipped=data.Equipped, Pets=table.clone(data.Pets), EquippedPet=data.EquippedPet,
        PetMultiplier=C.PetMultiplier(data), StorageMode=mode, SaveStatus=saveStatus or "ready"}
end
return Network
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9707636c820c4ebeaf7e6d346d174381">
        <Properties>
          <string name="Name">Telemetry</string>
          <ProtectedString name="Source">local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local RunService=game:GetService("RunService")
local Analytics=game:GetService("AnalyticsService")
local Telemetry={}
-- Supported API; opt-in only. Delivery is not claimed without Dashboard verification.
function Telemetry.Step(player,step,name)
    if not C.AnalyticsEnabled or RunService:IsStudio() then return end
    task.spawn(function()
        local ok=pcall(function() Analytics:LogOnboardingFunnelStepEvent(player,step,name) end)
        if not ok then warn("Simulator analytics event unavailable") end
    end)
end
return Telemetry
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXeb597f5c8ec24b129738284c47cfa96e">
        <Properties>
          <string name="Name">Runtime</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local HttpService=game:GetService("HttpService")
local DataStoreService=game:GetService("DataStoreService")
local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local PlayerData=require(script.Parent.PlayerData)
local Progression=require(script.Parent.Progression)
local Rebirth=require(script.Parent.Rebirth)
local Rewards=require(script.Parent.Rewards)
local Security=require(script.Parent.Security)
local Network=require(script.Parent.Network)
local World=require(script.Parent.World)
local Telemetry=require(script.Parent.Telemetry)
local Pets=require(script.Parent.Pets)
local PetVisuals=require(script.Parent.PetVisuals)
local Runtime={sessions={},started=false}
local dataService,remotes,map,mode
local function stats(player,data)
    local folder=player:FindFirstChild("leaderstats")
    if not folder then
        folder=Instance.new("Folder"); folder.Name="leaderstats"; folder.Parent=player
        for _, name in {"Rebirths","LifetimePower"} do local n=Instance.new("NumberValue"); n.Name=name; n.Parent=folder end
    end
    folder.Rebirths.Value=data.Rebirths; folder.LifetimePower.Value=data.LifetimePower
end
local function publish(player)
    local data=dataService:Get(player.UserId)
    if data and player.Parent==Players then
        stats(player,data)
        local session=Runtime.sessions[player.UserId]
        remotes.State:FireClient(player,Network.Snapshot(data,mode,session and session.saveStatus))
    end
end
local function notice(player,message,extra)
    if player.Parent==Players then remotes.Notice:FireClient(player,message,extra) end
end
-- Shared by the RemoteEvent and ProximityPrompt. Tests call the SAME gate on server.
function Runtime.Dispatch(player,action,...)
    local session=Runtime.sessions[player.UserId]
    if not session then return false,"loading" end
    local now=os.clock()
    if not Security.Allow(session.limiter,"Request",now,0) then return false,"rate" end
    local args=table.pack(...)
    if not Security.Valid(action,args) then return false,"arguments" end
    local cooldown=action=="Train" and C.TrainCooldown or (action=="Hatch" and C.HatchCooldown or (action=="Sync" and 1 or C.ActionCooldown))
    local last=session.actionTimes[action]
    if last and now-last&lt;cooldown then return false,"cooldown" end
    session.actionTimes[action]=now
    local data=dataService:Get(player.UserId)
    if not data then return false,"data_unavailable" end
    if action=="Sync" then publish(player); return true end
    if action=="PetMenu" then
        local near=false
        for id in pairs(C.Eggs) do
            local stand=map:FindFirstChild("Egg"..id)
            if stand and Security.Near(player,stand,C.EggDistance) then near=true; break end
        end
        if not near then return false,"distance" end
        notice(player,"Яйца открываются за игровые монеты.",{OpenPets=true}); return true
    end
    if action=="PrepareRebirth" then
        local power,coins=C.Requirements(data.Rebirths)
        if data.Power&lt;power or data.Coins&lt;coins or data.Rebirths&gt;=C.MaxRebirths then
            notice(player,"Пока не хватает силы или монет для перерождения."); return false,"conditions"
        end
        session.confirm={token=HttpService:GenerateGUID(false),expires=now+20,rebirths=data.Rebirths}
        notice(player,"Перерождение сбросит силу, монеты и уровень. Косметика и рекорд сохранятся.",
            {RebirthToken=session.confirm.token,NextMultiplier=C.Multiplier({Rebirths=data.Rebirths+1})})
        return true
    end
    local ok,message
    if action=="Train" then
        local station=C.Stations[args[1]]
        local pad=map:FindFirstChild(args[1])
        if not pad or not Security.Near(player,pad,C.TrainDistance) then return false,"distance" end
        if data.Level&lt;station.MinLevel then notice(player,"Продвинутая станция: нужен уровень 3."); return false,"level" end
        ok,message=Progression.Train(data,args[1])
    elseif action=="Hatch" then
        local stand=map:FindFirstChild("Egg"..args[1])
        if not stand or not Security.Near(player,stand,C.EggDistance) then
            notice(player,"Подойди к выбранному яйцу."); return false,"distance"
        end
        ok,message=Pets.Hatch(data,args[1])
    elseif action=="PetEquip" then ok,message=Pets.Equip(data,args[1])
    elseif action=="Upgrade" then ok,message=Progression.Upgrade(data)
    elseif action=="Rebirth" then
        local confirmation=session.confirm
        session.confirm=nil -- Single use, expires, bound to this player's current cycle.
        if not confirmation or confirmation.token~=args[1] or confirmation.expires&lt;now
            or confirmation.rebirths~=data.Rebirths then return false,"confirmation" end
        ok,message=Rebirth.Apply(data)
    elseif action=="Daily" or action=="Weekly" then ok,message=Rewards.Claim(data,action,os.time())
    elseif action=="Equip" then ok,message=Rewards.Equip(data,args[1]) end
    if not ok then notice(player,message or "Действие недоступно."); return false,"conditions" end
    Rewards.Reconcile(data)
    dataService:Changed(player.UserId)
    if action=="Equip" or action=="Rebirth" then Rewards.ApplyCharacter(player,data) end
    if action=="PetEquip" or action=="Hatch" then PetVisuals.Apply(player,data) end
    publish(player); notice(player,message)
    if action=="Train" and data.TotalTrainings==1 then Telemetry.Step(player,2,"FirstTraining") end
    if action=="Upgrade" and data.Level==1 then Telemetry.Step(player,3,"FirstUpgrade") end
    if action=="Rebirth" and data.Rebirths==1 then Telemetry.Step(player,4,"FirstRebirth") end
    return true
end
local function savePlayer(player,release)
    local ok,reason=dataService:Save(player.UserId,release)
    local session=Runtime.sessions[player.UserId]
    if not release and session then
        session.saveStatus=ok and "saved" or "retry"
        publish(player)
        if not ok then notice(player,"Сохранение задерживается. Игра повторит попытку.") end
    end
    if not ok then warn("Simulator save failed: "..tostring(reason)) end
    return ok
end
local function joined(player)
    local ok,reason=dataService:Load(player.UserId)
    if not ok then
        if player.Parent==Players then player:Kick("Не удалось безопасно загрузить прогресс ("..reason.."). Подожди и войди снова. Данные не сброшены.") end
        return
    end
    if player.Parent~=Players or dataService.closing then dataService:Save(player.UserId,true); return end
    Runtime.sessions[player.UserId]={limiter=Security.NewLimiter(),actionTimes={},saveStatus="ready"}
    local data=dataService:Get(player.UserId)
    if not data then player:Kick("Сессия данных истекла. Войди снова."); return end
    if Rewards.Reconcile(data) then dataService:Changed(player.UserId) end
    stats(player,data)
    player.RespawnLocation=map.SimulatorSpawn
    player.CharacterAdded:Connect(function(char)
        local root=char:WaitForChild("HumanoidRootPart",10)
        local current=dataService:Get(player.UserId)
        if root and current then Rewards.ApplyCharacter(player,current); PetVisuals.Apply(player,current) end
        local humanoid=char:WaitForChild("Humanoid",10)
        if humanoid then
            humanoid.Died:Connect(function()
                task.delay(3,function()
                    if player.Parent==Players and dataService:Get(player.UserId) then
                        local loaded=pcall(function() player:LoadCharacterAsync() end)
                        if not loaded then player:Kick("Не удалось загрузить персонажа. Войди снова.") end
                    end
                end)
            end)
        end
    end)
    local loaded=pcall(function() player:LoadCharacterAsync() end)
    if not loaded then player:Kick("Не удалось загрузить персонажа. Войди снова."); return end
    publish(player); Telemetry.Step(player,1,"Joined")
end
function Runtime.Start()
    assert(not Runtime.started,"Runtime already started"); Runtime.started=true
    Players.CharacterAutoLoads=false
    mode=RunService:IsStudio() and C.StudioOffline and "sandbox" or "datastore"
    local store
    if mode=="datastore" then
        store=DataStoreService:GetDataStore(RunService:IsStudio() and C.StudioStoreName or C.StoreName)
    end
    dataService=PlayerData.new(store,{offline=mode=="sandbox"})
    map=World.Build(); remotes=Network.Create()
    remotes.Action.OnServerEvent:Connect(function(player,action,...) Runtime.Dispatch(player,action,...) end)
    for id in pairs(C.Stations) do
        map[id].TrainPrompt.Triggered:Connect(function(player) Runtime.Dispatch(player,"Train",id) end)
    end
    for id in pairs(C.Eggs) do
        map["Egg"..id].EggPrompt.Triggered:Connect(function(player) Runtime.Dispatch(player,"PetMenu") end)
    end
    Players.PlayerAdded:Connect(joined)
    Players.PlayerRemoving:Connect(function(player)
        savePlayer(player,true); Runtime.sessions[player.UserId]=nil
    end)
    for _, player in Players:GetPlayers() do task.spawn(joined,player) end
    task.spawn(function()
        while not dataService.closing do
            task.wait(C.AutoSaveSeconds)
            if dataService.closing then break end
            for _,player in Players:GetPlayers() do task.spawn(savePlayer,player,false) end
        end
    end)
    task.spawn(function()
        while not dataService.closing do
            task.wait(2)
            for _,player in Players:GetPlayers() do
                if Runtime.sessions[player.UserId] and not dataService:Get(player.UserId) then
                    player:Kick("Защита данных: сохранение недоступно или сессия истекла. Войди снова позже.")
                end
            end
        end
    end)
    game:BindToClose(function()
        dataService.closing=true
        local pending=0
        for userId in pairs(dataService.profiles) do
            pending+=1
            task.spawn(function()
                local ok=dataService:Save(userId,true)
                if not ok then warn("Simulator final save failed") end
                pending-=1
            end)
        end
        local deadline=os.clock()+25
        while (pending&gt;0 or next(dataService.loading)~=nil) and os.clock()&lt;deadline do task.wait(0.1) end
    end)
    print("SIMULATOR_READY mode="..mode)
end
return Runtime
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX3524fb1c31d847a8bc73fde6ecfc75f4">
        <Properties>
          <string name="Name">Bootstrap</string>
          <ProtectedString name="Source">require(script.Parent.Runtime).Start()
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX31cdd6a10a73428888ecdc43b6d46528">
        <Properties>
          <string name="Name">Tests</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX8d50332a930e48fd8e0a3f3573c3c3d2">
          <Properties>
            <string name="Name">Spec</string>
            <ProtectedString name="Source">-- Server-only deterministic tests. No production DataStore, no real user records.
local Root=game.ServerScriptService.Simulator
local C=require(game.ReplicatedStorage.SimulatorShared.Config)
local Schema=require(Root.Schema)
local Data=require(Root.PlayerData)
local P=require(Root.Progression)
local R=require(Root.Rebirth)
local Rewards=require(Root.Rewards)
local S=require(Root.Security)
local Pets=require(Root.Pets)
local Spec={}
function Spec.Run()
    local count=0
    local function check(value,message) assert(value,message); count+=1 end
    local d=Schema.New()
    check(Schema.Validate(d)~=nil,"default schema")
    local old=Schema.New(); old.Version=1; old.Pets=nil; old.EquippedPet=nil; old.Coins=123
    local migrated=Schema.Validate(old)
    check(migrated and migrated.Version==2 and migrated.Coins==123 and next(migrated.Pets)==nil,"migrate old profile without progress loss")
    local petData=Schema.New()
    check(not Pets.Hatch(petData,"Meadow"),"no coins no hatch")
    petData.Coins=1000
    check(not Pets.Hatch(petData,"Fake"),"unknown egg rejected")
    check(not Pets.Hatch(petData,"Meadow",function() return 0/0 end) and petData.Coins==1000,"bad roll preserves coins")
    for _,case in {{0,"Cat"},{.6,"Dog"},{.9,"Bunny"}} do
        local before=petData.Coins
        local ok,_,id=Pets.Hatch(petData,"Meadow",function() return case[1] end)
        check(ok and id==case[2] and petData.Coins==before-80,"weighted hatch and exact cost")
    end
    check(Pets.Count(petData)==3 and petData.EquippedPet=="Cat","auto equip first and inventory count")
    check(Pets.Equip(petData,"Bunny") and C.PetMultiplier(petData)==1.35,"owned pet bonus")
    local power,coins=C.Gains(petData,1)
    check(power==6 and coins==10,"server gains include single pet bonus")
    local bonusData=Schema.New(); bonusData.Level=3; bonusData.Rebirths=2
    bonusData.Pets.Bunny=1; bonusData.EquippedPet="Bunny"
    local totalPower,totalCoins=C.TrainingMultipliers(bonusData,1.25)
    check(math.abs(totalPower-3.348)&lt;.000001 and math.abs(totalCoins-3.034125)&lt;.000001,"separate total multipliers combine all active bonuses")
    local gainPower,gainCoins=C.Gains(bonusData,1.25)
    check(gainPower==math.floor(C.BasePower*totalPower) and gainCoins==math.floor(C.BaseCoins*totalCoins),"HUD multipliers match server gain formula")
    check(Schema.Validate(petData)~=nil,"pet profile valid")
    petData.Power=200; petData.Coins=150
    check(R.Apply(petData) and petData.Pets.Bunny==1 and petData.EquippedPet=="Bunny","rebirth preserves pets")
    check(Pets.Equip(petData,"") and C.PetMultiplier(petData)==1,"unequip removes bonus")
    check(not Pets.Equip(Schema.New(),"Dog"),"cannot equip unowned pet")
    local full=Schema.New(); full.Coins=1000; full.Pets.Cat=C.MaxPets
    check(not Pets.Hatch(full,"Meadow") and full.Coins==1000,"capacity blocks without charge")
    full.Pets.Cat+=1; check(Schema.Validate(full)==nil,"oversized inventory rejected")
    local corrupt=Schema.New(); corrupt.Pets.Cat=-1; check(Schema.Validate(corrupt)==nil,"negative pets rejected")
    corrupt=Schema.New(); corrupt.Pets.Fake=1; check(Schema.Validate(corrupt)==nil,"unknown pet rejected")
    corrupt=Schema.New(); corrupt.EquippedPet="Dog"; check(Schema.Validate(corrupt)==nil,"unowned equipped pet rejected")
    check(S.Valid("Hatch",table.pack("Meadow")) and not S.Valid("Hatch",table.pack("Meadow","Bunny")),"client cannot choose hatch result")
    check(not S.Valid("PetEquip",table.pack({})) and not S.Valid("Hatch",table.pack("Fake")),"malformed pet remotes rejected")
    d.Coins=0/0; check(Schema.Validate(d)==nil,"reject NaN")
    d=Schema.New(); d.Power=math.huge; check(Schema.Validate(d)==nil,"reject infinity")
    d=Schema.New(); d.Coins=-1; check(Schema.Validate(d)==nil,"reject negative")
    d=Schema.New(); check(not P.Upgrade(d),"cannot buy without coins")
    check(not P.Train(d,"Advanced"),"zone level locked")
    P.Train(d,"Basic"); check(d.Power==5 and d.Coins==8 and d.LifetimePower==5,"server training gains")
    for _=1,3 do P.Train(d,"Basic") end
    check(P.Upgrade(d) and d.Level==1 and d.Coins==7,"deduct exact cost")
    check(not R.Apply(d),"early rebirth rejected")
    d.Power=200; d.Coins=150; d.LastDaily=100; d.Cosmetics.BronzeAura=true; d.Equipped="BronzeAura"
    local lifetime=d.LifetimePower
    check(R.Apply(d),"rebirth allowed")
    check(d.Power==0 and d.Coins==0 and d.Level==0 and d.Rebirths==1,"reset only cycle fields")
    check(d.LifetimePower==lifetime and d.LastDaily==100 and d.Equipped=="BronzeAura","preserve persistent fields")
    check(C.Multiplier(d)==1.12,"controlled permanent bonus")
    d.Rebirths=10; check(Rewards.Reconcile(d) and d.Cosmetics.NeonTrail,"milestone")
    check(not Rewards.Reconcile(d),"milestone idempotent")
    check(not Rewards.Equip(Schema.New(),"NeonTrail"),"unowned cosmetic rejected")
    d=Schema.New(); check(not Rewards.Claim(d,"Daily",1000),"new account reward gated")
    d.TotalTrainings=3
    check(Rewards.Claim(d,"Daily",1000),"daily first claim")
    local coins=d.Coins
    check(not Rewards.Claim(d,"Daily",1001) and d.Coins==coins,"daily duplication rejected")
    check(not Rewards.Claim(d,"Daily",999),"clock rollback")
    check(Rewards.Claim(d,"Daily",1000+C.DailySeconds),"daily interval boundary")
    check(Rewards.Claim(d,"Weekly",1000),"weekly first claim")
    check(not Rewards.Claim(d,"Weekly",1000+C.WeeklySeconds-1),"weekly interval")
    check(Rewards.Claim(d,"Weekly",1000+C.WeeklySeconds),"weekly ready")
    check(not S.Valid("Train",table.pack("Basic",1000000)),"extra reward arg rejected")
    check(not S.Valid("Train",table.pack({})),"wrong type rejected")
    check(not S.Valid("Train",table.pack("Fake")),"unknown station rejected")
    check(not S.Valid("Rebirth",table.pack(true)),"confirmation type rejected")
    check(not S.Valid("Coins",table.pack(100000)),"no give currency action")
    local limiter=S.NewLimiter()
    check(S.Allow(limiter,"Train",limiter.at,0.8),"first request allowed")
    check(not S.Allow(limiter,"Train",limiter.at+0.1,0.8),"cooldown")
    limiter=S.NewLimiter(); local accepted=0; local instant=limiter.at
    for _=1,50 do if S.Allow(limiter,"Request",instant,0) then accepted+=1 end end
    check(accepted==C.RemoteBurst,"bounded remote burst")
    check(not S.Near({Character=nil},{Position=Vector3.zero},11),"no dead/missing character activity")

    local clock=1000
    local store={records={},calls=0,fail=false,doubleCallback=false,afterWriteFailure=false}
    function store:UpdateAsync(key,callback)
        self.calls+=1
        if self.fail then error("simulated outage") end
        local old=Schema.Copy(self.records[key])
        if self.doubleCallback then callback(Schema.Copy(old)) end
        local result=callback(old)
        if result then self.records[key]=Schema.Copy(result) end
        if result and self.afterWriteFailure then self.afterWriteFailure=false; error("response lost after commit") end
        return Schema.Copy(result)
    end
    local opts={now=function() return clock end,wait=function() end,token="A"}
    local a=Data.new(store,opts)
    check(a:Load(77),"load new player")
    a:Get(77).Pets.Bunny=2; a:Get(77).EquippedPet="Bunny"
    a:Get(77).Coins=250; a:Changed(77)
    store.doubleCallback=true
    check(a:Save(77,false) and store.records.Player_77.Data.Coins==250,"callback retry safe")
    local b=Data.new(store,{now=opts.now,wait=opts.wait,token="B"})
    check(not b:Load(77),"second server session locked")
    local before=Schema.Copy(store.records.Player_77)
    store.fail=true
    local c=Data.new(store,{now=opts.now,wait=opts.wait,token="C"})
    check(not c:Load(77) and c:Get(77)==nil,"load error never exposes default profile")
    check(c:Save(77,true) and store.records.Player_77.Data.Coins==before.Data.Coins,"load error cannot overwrite")
    check(not a:Save(77,false),"save outage handled")
    store.fail=false; store.afterWriteFailure=true
    check(a:Save(77,false) and store.records.Player_77.Data.Coins==250,"commit response lost retry safe")
    check(a:Save(77,true) and store.records.Player_77.Session==nil,"release lock")
    check(b:Load(77) and b:Get(77).Coins==250,"reload persisted progress")
    check(b:Get(77).Pets.Bunny==2 and b:Get(77).EquippedPet=="Bunny","pet save reload roundtrip")
    b:Get(77).Coins=400; b:Changed(77); check(b:Save(77,false),"second session saves")
    clock+=C.LeaseSeconds+1
    check(b:Get(77)==nil,"expired lease freezes actions")
    check(c:Load(77),"stale lease takeover")
    check(not b:Save(77,false),"old server cannot overwrite takeover")
    check(store.records.Player_77.Data.Coins==400,"takeover data intact")
    store.records.Player_88={Schema=99,Data=Schema.New(),Revision=0}
    check(not a:Load(88) and store.records.Player_88.Schema==99,"unknown schema preserved")
    store.records.Player_89={Schema=1,Data=Schema.New(),Revision=0}
    store.records.Player_89.Data.Coins=-20
    check(not a:Load(89) and store.records.Player_89.Data.Coins==-20,"corrupt data not overwritten")
    check(c:Save(77,true),"final save")
    local offline=Data.new(nil,{offline=true})
    check(offline:Load(1) and offline:Get(1).Coins==0,"explicit offline default")
    offline.closing=true; check(offline:Get(1)==nil and not offline:Load(2),"shutdown freezes operations")
    check(offline:Save(1,true),"shutdown release")

    local balance={}; d=Schema.New()
    for cycle=1,26 do
        local powerReq,coinReq=C.Requirements(d.Rebirths)
        local actions=0
        -- A simple player strategy: buy levels 1..3 while still building power.
        while d.Power&lt;powerReq or d.Coins&lt;coinReq do
            local station=d.Level&gt;=3 and "Advanced" or "Basic"
            P.Train(d,station); actions+=1
            if d.Level&lt;3 and d.Power&lt;powerReq and d.Coins&gt;=C.UpgradeCost(d.Level) then P.Upgrade(d) end
            assert(actions&lt;500,"unreachable rebirth")
        end
        balance[cycle]=actions*C.TrainCooldown
        check(R.Apply(d),"balance cycle "..cycle)
    end
    check(balance[1]&lt;=90 and balance[2]&lt;=balance[1]*1.2,"early pacing")
    check(balance[26]&lt;balance[1],"later cycles moderately faster")
    print(("SIMULATOR_SPEC_PASS %d assertions; cycle_seconds [1]=%.1f [2]=%.1f [10]=%.1f [26]=%.1f")
        :format(count,balance[1],balance[2],balance[10],balance[26]))
    return {Assertions=count,Balance=balance}
end
return Spec
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX997e3ef2282f4cd0b5f90ff2e7d2e91c">
          <Properties>
            <string name="Name">Integration</string>
            <ProtectedString name="Source">-- SERVER Command Bar in a fresh Play. Only runs in Studio sandbox.
assert(game:GetService("RunService"):IsStudio(),"Studio only")
local Integration={}
function Integration.Run()
local C=require(game.ReplicatedStorage.SimulatorShared.Config)
assert(C.StudioOffline,"Only run integration in offline sandbox")
local Runtime=require(game.ServerScriptService.Simulator.Runtime)
local player=game.Players:GetPlayers()[1]
assert(player and player.Character,"Wait for character to spawn")
local remotes=game.ReplicatedStorage.SimulatorRemotes
local map=workspace.SimulatorWorld
local function send(action,...)
    local ok,reason=Runtime.Dispatch(player,action,...)
    return ok,reason
end
task.spawn(function()
    local function settle(pad)
        local root=player.Character.HumanoidRootPart
        root.AssemblyLinearVelocity=Vector3.zero
        player.Character:PivotTo(pad.CFrame+Vector3.new(0,4,0))
        task.wait(1)
    end
    assert(player.leaderstats.LifetimePower.Value==0,"Fresh Play needed")
    settle(map.SimulatorSpawn)
    local ok,reason=send("Train","Basic")
    assert(not ok and reason=="distance","distance validation")
    settle(map.Basic)
    assert(not send("Train","Basic",1000000),"malicious reward argument")
    task.wait(0.85)
    assert(send("Train","Basic"),"valid training")
    assert(not send("Train","Basic"),"training cooldown")
    assert(player.leaderstats.LifetimePower.Value==5,"leaderboard server score")
    for _=1,3 do task.wait(0.85); assert(send("Train","Basic")) end
    assert(send("Upgrade"),"buy improvement")
    assert(not send("Rebirth","invented"),"confirmation token rejected")
    settle(map.Advanced)
    local allowed,why=send("Train","Advanced")
    assert(not allowed and why=="level","locked advanced zone")
    settle(map.Basic)
    -- Earn the first cycle normally, without injecting coins or power into a profile.
    for _=1,40 do task.wait(0.85); assert(send("Train","Basic")) end
    assert(send("Daily"),"daily reward")
    task.wait(0.35); assert(not send("Daily"),"duplicate daily reward")
    task.wait(0.35); assert(send("PrepareRebirth"),"rebirth preparation")
    local token=Runtime.sessions[player.UserId].confirm.token
    task.wait(0.35); assert(send("Rebirth",token),"rebirth confirmed")
    assert(player.leaderstats.Rebirths.Value==1,"leaderboard rebirth")
    task.wait(0.35); assert(not send("Rebirth",token),"token cannot replay")
    local oldCharacter=player.Character
    oldCharacter.Humanoid.Health=0
    local deadline=os.clock()+15
    repeat task.wait(0.2) until player.Character~=oldCharacter or os.clock()&gt;deadline
    assert(player.Character~=oldCharacter,"respawn")
    local root=player.Character:WaitForChild("HumanoidRootPart",10)
    assert(root:WaitForChild("Simulator_Aura",10),"cosmetic restored on respawn")
    assert(player.leaderstats.Rebirths.Value==1,"progress survives death")
    print("SIMULATOR_INTEGRATION_PASS training, distance, malformed args, cooldown, upgrade, daily, rebirth, replay, cosmetics, respawn")
end)
end
return Integration
</ProtectedString>
